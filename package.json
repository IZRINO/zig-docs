{
  "name": "zig-docs",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate-content.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "extract": "node scripts/extract.mjs",
    "translation:status": "node scripts/translation-status.mjs",
    "validate:translations": "node scripts/validate-translations.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "lint": "prettier --check src scripts tests astro.config.mjs package.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "1.58.2",
    "cheerio": "1.2.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}

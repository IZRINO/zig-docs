---
import DocumentRoute from '../../components/DocumentRoute.astro';
import {
  locales,
  versions,
  latestVersion,
  manifest,
  type Locale,
  type Version,
  type DocumentMeta,
} from '../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    for (const version of versions) {
      const docs = await manifest(locale, version);
      const prefix = version === '0.17.0' ? '' : `${version}/`;
      paths.push({
        params: { locale, slug: version },
        props: { locale, version, meta: null },
      });
      if (version === latestVersion)
        paths.push({
          params: { locale, slug: undefined },
          props: { locale, version, meta: null },
        });
      for (const meta of docs)
        paths.push({
          params: { locale, slug: `${prefix}${meta.id}` },
          props: { locale, version, meta },
        });
    }
  }
  return paths;
}

interface Props {
  locale: Locale;
  version: Version;
  meta: DocumentMeta | null;
}
const { locale, version, meta } = Astro.props;
---

<DocumentRoute locale={locale} version={version} meta={meta} />

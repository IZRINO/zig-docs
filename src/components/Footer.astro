---
import { currentDocument, labels } from '../lib/content';
const { locale, version, id } = currentDocument(Astro.url.pathname);
const t = labels[locale];
---

<footer class="document-footer" data-pagefind-ignore>
  <p>
    {
      locale === 'zh-cn' && id.startsWith('intro/')
        ? t.officialIntroAttribution
        : t.attribution
    }
  </p>
  <div>
    <span>{t.disclaimer}</span>
    <a href="https://github.com/IZRINO/zig-docs">{t.repository}</a>
    <a href={`https://ziglang.org/documentation/${version}/`}>ziglang.org</a>
    <a
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/licenses/zig-LICENSE.txt`}
    >
      {locale === 'en' ? 'Upstream license' : '上游许可证'}
    </a>
    <a
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/licenses/fonts-OFL.txt`}
    >
      {locale === 'en' ? 'Font licenses' : '字体许可证'}
    </a>
  </div>
</footer>

---
import DefaultTableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import ApiIndex from './ApiIndex.astro';
import { currentDocument, manifest } from '../lib/content';

const { locale, id } = currentDocument(Astro.url.pathname);
const meta = (await manifest(locale)).find((doc) => doc.id === id);
const compact = meta?.kind === 'std' && (meta.symbols?.length ?? 0) > 200;
const title = locale === 'en' ? 'API index' : '接口索引';
---

{
  compact ? (
    <nav class="compact-api-toc" aria-labelledby="api-index-desktop-title">
      <h2 id="api-index-desktop-title">{title}</h2>
      <div class="api-index-sections">
        <a href="#_top">{locale === 'en' ? 'Overview' : '概览'}</a>
        <a href="#source">{locale === 'en' ? 'Source code' : '源码'}</a>
      </div>
      <ApiIndex locale={locale} rootAnchor={meta.symbols![0].anchor} />
    </nav>
  ) : (
    <DefaultTableOfContents />
  )
}

---
import { labels, type Locale } from '../lib/content';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = labels[locale];
---

<zig-reading-tools
  data-copy={t.copy}
  data-copied={t.copied}
  data-failed={t.copyFailed}
  data-locale={locale}
>
  <div
    class="reading-type-controls"
    aria-label={locale === 'en' ? 'Text size' : '字号'}
  >
    <span class="reading-type-label">{locale === 'en' ? 'Text size' : '字号'}</span>
    <button
      type="button"
      data-font-action="decrease"
      aria-label={locale === 'en' ? 'Decrease text size' : '减小字号'}
      >A−</button
    >
    <button
      type="button"
      data-font-action="reset"
      aria-label={locale === 'en' ? 'Reset text size' : '重置字号'}>A</button
    >
    <button
      type="button"
      data-font-action="increase"
      aria-label={locale === 'en' ? 'Increase text size' : '增大字号'}
      >A+</button
    >
  </div>
  <span class="sr-only" role="status" aria-live="polite"></span>
</zig-reading-tools>

<script>
  class ZigReadingTools extends HTMLElement {
    fontKey = 'zig-docs-font-scale';
    revealSource = () => {
      let id;
      try {
        id = decodeURIComponent(location.hash.slice(1));
      } catch {
        return;
      }
      if (!id) return;
      const target = document.getElementById(id);
      const details = target?.closest('details');
      if (details) {
        details.open = true;
        requestAnimationFrame(() =>
          target?.scrollIntoView({ block: 'center' }),
        );
      }
    };

    connectedCallback() {
      this.revealSource();
      this.setupFontControls();
      window.addEventListener('hashchange', this.revealSource);
      const status = this.querySelector<HTMLElement>('[role="status"]');
      document
        .querySelectorAll<HTMLElement>('.doc-content pre')
        .forEach((pre) => {
          if (pre.hasAttribute('data-copy-ignore')) return;
          const frame = pre.closest('.expressive-code .frame');
          if ((frame ?? pre).querySelector('.copy-code')) return;
          const code = pre.querySelector('code');
          const button = document.createElement('button');
          button.className = 'copy-code';
          button.type = 'button';
          button.textContent = this.dataset.copy || 'Copy code';
          button.setAttribute('aria-label', this.dataset.copy || 'Copy code');
          button.addEventListener('click', async () => {
            try {
              const clone = (code ?? pre).cloneNode(true) as HTMLElement;
              clone
                .querySelectorAll(
                  '.copy-code, [data-line-number], [aria-hidden="true"], .line-number, .line-numbers',
                )
                .forEach((node) => node.remove());
              const source = clone.textContent ?? '';
              await navigator.clipboard.writeText(source);
              button.textContent = this.dataset.copied || 'Copied';
              if (status) status.textContent = button.textContent;
              window.setTimeout(() => {
                button.textContent = this.dataset.copy || 'Copy code';
              }, 1800);
            } catch {
              button.textContent = this.dataset.failed || 'Copy failed';
              if (status) status.textContent = button.textContent;
            }
          });
          (frame?.querySelector('.header') ?? pre).append(button);
        });
    }

    setupFontControls() {
      const root = document.documentElement;
      const buttons =
        this.querySelectorAll<HTMLButtonElement>('[data-font-action]');
      const stored = Number.parseFloat(
        localStorage.getItem(this.fontKey) || '1',
      );
      const apply = (value: number) => {
        const scale = Math.min(
          1.25,
          Math.max(0.9, Math.round(value * 20) / 20),
        );
        root.style.setProperty('--doc-font-scale', String(scale));
        localStorage.setItem(this.fontKey, String(scale));
        buttons.forEach((button) =>
          button.setAttribute(
            'aria-pressed',
            button.dataset.fontAction === 'reset' && scale === 1
              ? 'true'
              : 'false',
          ),
        );
      };
      apply(Number.isFinite(stored) ? stored : 1);
      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          const current =
            Number.parseFloat(
              getComputedStyle(root).getPropertyValue('--doc-font-scale'),
            ) || 1;
          const action = button.dataset.fontAction;
          apply(
            action === 'increase'
              ? current + 0.05
              : action === 'decrease'
                ? current - 0.05
                : 1,
          );
        }),
      );
    }

    disconnectedCallback() {
      window.removeEventListener('hashchange', this.revealSource);
    }
  }
  if (!customElements.get('zig-reading-tools')) {
    customElements.define('zig-reading-tools', ZigReadingTools);
  }
</script>

---
import { currentDocument, docHref, labels, manifest } from '../lib/content';

const { locale, id, version } = currentDocument(Astro.url.pathname);
const t = labels[locale];
const parts = id.split('/').filter(Boolean);
const isLibrary = parts[0] === 'std';
const isIntro = parts[0] === 'intro';
const moduleIds = new Set(
  isLibrary
    ? (await manifest(locale, version))
        .filter((doc) => doc.kind === 'std')
        .map((doc) => doc.id)
    : [],
);
const ancestors = parts.slice(1, -1).map((label, index) => ({
  label,
  id: parts.slice(0, index + 2).join('/'),
}));
---

<div class="document-heading">
  <nav
    class="breadcrumbs"
    aria-label={locale === 'en' ? 'Breadcrumbs' : '面包屑导航'}
    data-pagefind-ignore
  >
    <a href={docHref(locale, '', version)}>{t.home}</a>
    {parts.length > 0 && <span aria-hidden="true">/</span>}
    {
      parts.length > 0 && (
        <a
          href={
            isLibrary
              ? docHref(locale, 'std', version)
              : isIntro
                ? `${docHref(locale, '', version)}#intro-index`
                : `${docHref(locale, '', version)}#language-reference`
          }
        >
          {isLibrary ? t.library : isIntro ? t.intro : t.reference}
        </a>
      )
    }
    {
      isLibrary &&
        ancestors.map((ancestor) => (
          <>
            <span aria-hidden="true">/</span>
            {moduleIds.has(ancestor.id) ? (
              <a href={docHref(locale, ancestor.id, version)}>
                {ancestor.label}
              </a>
            ) : (
              <span>{ancestor.label}</span>
            )}
          </>
        ))
    }
  </nav>
  <h1 id="_top" data-pagefind-meta="title">
    {Astro.locals.starlightRoute.entry.data.title}
  </h1>
</div>

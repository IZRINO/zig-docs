#AE4B07;--1:#FFAB70\">offset</span><span style=\"--0:#24292E;--1:#E1E4E8\">..][</span><span style=\"--0:#005CC5;--1:#79B8FF\">0</span><span style=\"--0:#24292E;--1:#E1E4E8\">..</span><span style=\"--0:#005CC5;--1:#79B8FF\">2</span><span style=\"--0:#24292E;--1:#E1E4E8\">].</span><span style=\"--0:#BF3441;--1:#F97583\">*</span><span style=\"--0:#24292E;--1:#E1E4E8\">;</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#BF3441;--1:#F97583\">try</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#6F42C1;--1:#B392F0\">expectEqual</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#AE4B07;--1:#FFAB70\">slice</span><span style=\"--0:#24292E;--1:#E1E4E8\">[</span><span style=\"--0:#AE4B07;--1:#FFAB70\">offset</span><span style=\"--0:#24292E;--1:#E1E4E8\">], </span><span style=\"--0:#AE4B07;--1:#FFAB70\">vec2</span><span style=\"--0:#24292E;--1:#E1E4E8\">[</span><span style=\"--0:#005CC5;--1:#79B8FF\">0</span><span style=\"--0:#24292E;--1:#E1E4E8\">]);</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#BF3441;--1:#F97583\">try</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#6F42C1;--1:#B392F0\">expectEqual</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#AE4B07;--1:#FFAB70\">slice</span><span style=\"--0:#24292E;--1:#E1E4E8\">[</span><span style=\"--0:#AE4B07;--1:#FFAB70\">offset</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">+</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#005CC5;--1:#79B8FF\">1</span><span style=\"--0:#24292E;--1:#E1E4E8\">], </span><span style=\"--0:#AE4B07;--1:#FFAB70\">vec2</span><span style=\"--0:#24292E;--1:#E1E4E8\">[</span><span style=\"--0:#005CC5;--1:#79B8FF\">1</span><span style=\"--0:#24292E;--1:#E1E4E8\">]);</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#BF3441;--1:#F97583\">try</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#6F42C1;--1:#B392F0\">expectEqual</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#AE4B07;--1:#FFAB70\">vec2</span><span style=\"--0:#24292E;--1:#E1E4E8\">, </span><span style=\"--0:#AE4B07;--1:#FFAB70\">vec3</span><span style=\"--0:#24292E;--1:#E1E4E8\">);</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">}</span></div></div></code></pre></figure></div><div class=\"expressive-code\"><figure class=\"frame is-terminal has-title\"><figcaption class=\"header\"><span class=\"title\">命令行</span></figcaption><pre data-language=\"shellsession\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">$ zig test test_vector.zig</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#005CC5;--1:#79B8FF\">1/2 test_vector.test.Basic vector usage...OK</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#005CC5;--1:#79B8FF\">2/2 test_vector.test.Conversion between vectors, arrays, and slices...OK</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#005CC5;--1:#79B8FF\">All 2 tests passed.</span></div></div>\n</code></pre></figure></div>\n\n      <p>待补充：C ABI 互操作<br>待考虑：建议使用 std.MultiArrayList</p>\n      <p>另见：</p><ul>\n<li><a href=\"/zig-docs/zh-cn/reference/Builtin-Functions/#splat\">@splat</a></li>\n<li><a href=\"/zig-docs/zh-cn/reference/Builtin-Functions/#shuffle\">@shuffle</a></li>\n<li><a href=\"/zig-docs/zh-cn/reference/Builtin-Functions/#select\">@select</a></li>\n<li><a href=\"/zig-docs/zh-cn/reference/Builtin-Functions/#reduce\">@reduce</a></li>\n<li><a href=\"/zig-docs/zh-cn/reference/Slices/#Slicing-by-Length\">按长度切片</a></li>\n</ul>\n\n\n      <h3 id=\"Relationship-with-Arrays\"><a href=\"/zig-docs/zh-cn/reference/Vectors/#Relationship-with-Arrays\">与数组的关系</a></h3>\n\n      <p>向量与<a href=\"/zig-docs/zh-cn/reference/Arrays/#Arrays\">数组</a>都具有明确定义的<strong>位布局</strong>，因此支持彼此通过 <a href=\"/zig-docs/zh-cn/reference/Builtin-Functions/#bitCast\">@bitCast</a> 转换。<a href=\"/zig-docs/zh-cn/reference/Casting/#Type-Coercion\">类型强制转换</a>会隐式执行 <code><span class=\"tok-builtin\">@bitCast</span></code>。</p>\n      <p>数组具有明确定义的字节布局，向量则没有，因此在两者之间执行 <a href=\"/zig-docs/zh-cn/reference/Builtin-Functions/#ptrCast\">@ptrCast</a> 属于<a href=\"/zig-docs/zh-cn/reference/Illegal-Behavior/#Illegal-Behavior\">非法行为</a>。</p>\n      \n\n      <h3 id=\"Destructuring-Vectors\"><a href=\"/zig-docs/zh-cn/reference/Vectors/#Destructuring-Vectors\">向量解构</a></h3>\n\n      <p>向量可以解构：</p>\n      <div class=\"expressive-code\"><figure class=\"frame has-title\"><figcaption class=\"header\"><span class=\"title\">destructuring_vectors.zig</span></figcaption><pre data-language=\"zig\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#BF3441;--1:#F97583\">const</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">print</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#005CC5;--1:#79B8FF\">@import</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#032F62;--1:#9ECBFF\">\"std\"</span><span style=\"--0:#24292E;--1:#E1E4E8\">).</span><span style=\"--0:#AE4B07;--1:#FFAB70\">debug</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#AE4B07;--1:#FFAB70\">print</span><span style=\"--0:#24292E;--1:#E1E4E8\">;</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#616972;--1:#99A0A6\">// 模拟 punpckldq</span></div></div>\n<div class=\"ec-line\"><div class=\"cod
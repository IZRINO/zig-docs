">(</span><span style=\"--0:#AE4B07;--1:#FFAB70\">number</span><span style=\"--0:#24292E;--1:#E1E4E8\">: </span><span style=\"--0:#BF3441;--1:#F97583\">usize</span><span style=\"--0:#24292E;--1:#E1E4E8\">, </span><span style=\"--0:#AE4B07;--1:#FFAB70\">arg1</span><span style=\"--0:#24292E;--1:#E1E4E8\">: </span><span style=\"--0:#BF3441;--1:#F97583\">usize</span><span style=\"--0:#24292E;--1:#E1E4E8\">) </span><span style=\"--0:#BF3441;--1:#F97583\">usize</span><span style=\"--0:#24292E;--1:#E1E4E8\"> {</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#BF3441;--1:#F97583\">return</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">asm</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">volatile</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span><span style=\"--0:#032F62;--1:#9ECBFF\">\"syscall\"</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">        </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">: [</span><span style=\"--0:#AE4B07;--1:#FFAB70\">ret</span><span style=\"--0:#24292E;--1:#E1E4E8\">] </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"={rax}\"</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span><span style=\"--0:#BF3441;--1:#F97583\">-&gt;</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">usize</span><span style=\"--0:#24292E;--1:#E1E4E8\">),</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">        </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">: [</span><span style=\"--0:#AE4B07;--1:#FFAB70\">number</span><span style=\"--0:#24292E;--1:#E1E4E8\">] </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"{rax}\"</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span><span style=\"--0:#AE4B07;--1:#FFAB7
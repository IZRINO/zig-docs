E8\">: [</span><span style=\"--0:#AE4B07;--1:#FFAB70\">number</span><span style=\"--0:#24292E;--1:#E1E4E8\">] </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"{rax}\"</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span><span style=\"--0:#AE4B07;--1:#FFAB70\">number</span><span style=\"--0:#24292E;--1:#E1E4E8\">),</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">          </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">[</span><span style=\"--0:#AE4B07;--1:#FFAB70\">arg1</span><span style=\"--0:#24292E;--1:#E1E4E8\">] </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"{rdi}\"</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span><span style=\"--0:#AE4B07;--1:#FFAB70\">arg1</span><span style=\"--0:#24292E;--1:#E1E4E8\">),</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">          </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">[</span><span style=\"--0:#AE4B07;--1:#FFAB70\">arg2</span><span style=\"--0:#24292E;--1:#E1E4E8\">] </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"{rsi}\"</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span><span style=\"--0:#AE4B07;--1:#FFAB70\">arg2</span><span style=\"--0:#24292E;--1:#E1E4E8\">),</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">          </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">[</span><span style=\"--0:#AE4B07;--1:#FFAB70\">arg3</span><span style=\"--0:#24292E;--1:#E1E4E8\">] </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"{rdx}\"</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span><span style=\"--0:#AE4B07;--1:#FFAB70\">arg3</span><span style=\"--0:#24292E;--1:#E1E4E8\">),</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">        </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">: .{ .</span><span style=\"--0:#AE4B07;--1:#FFAB70\">rcx</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">true</span><span style=\"--0:#24292E;--1:#E1E4E8\">, .</span><span style=\"--0:#AE4B07;--1:#FFAB70\">r11</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">true</span><span style=\"--0:#24292E;--1:#E1E4E8\"> });</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">}</span></div></div></code></pre></figure></div><div class=\"expressive-code\"><figure class=\"frame is-terminal has-title\"><figcaption class=\"header\"><span class=\"title\">命令行</span></figcaption><pre data-language=\"shellsession\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">$ zig build-exe inline_assembly.zig -target x86_64-linux</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">$ ./inline_assembly</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#005CC5;--1:#79B8FF\">hello world</span></div></div>\n</code></pre></figure></div>\n\n      <p>语法解析如下：</p>\n      <div class=\"expressive-code\"><figure class=\"frame has-title\"><figcaption class=\"header\"><span class=\"title\">Assembly Syntax Explained.zig</span></figcaption><pre data-language=\"zig\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#BF3441;--1:#F97583\">pub</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">fn</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#6F42C1;--1:#B392F0\">syscall1</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#AE4B07;--1:#FFAB70\">number</span><span style=\"--0:#24292E;--1:#E1E4E8\">: </span><span style=\"--0:#BF3441;--1:#F97583\">usize</span><span style=\"--0:#24292E;--1:#E1E4E8\">, </span><span style=\"--0:#AE4B07;--1:#FFAB70\">arg1</span><span style=\"--0:#24292E;--1:#E1E4E8\">: </span><span style=\"--0:#BF3441;--1:#F97583\">usize</span><span style=\"--0:#24292E;--1:#E1E4E8\">) </span><span style=\"--0:#BF3441;--1:#F97583\">usize</span><span style=\"--0:#24292E;--1:#E1E4E8\"> {</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 内联汇编是会返回一个值的表达式。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 表达式由 `asm` 关键字开始。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#BF3441;--1:#F97583\">return</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">asm</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// `volatile` 是可选修饰符，用来告知 Zig 此</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 内联汇编表达式具有副作用。如果没有</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// `volatile`，当结果未使用时，Zig 可以删除</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 该内联汇编代码。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#BF3441;--1:#F97583\">volatile</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 接下来是包含汇编代码的编译时字符串。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 如果使用了寄存器约束字符串，在需要寄存器的位置，</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 可以在字符串中使用 `%[ret]`、`%[number]`</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 或 `%[arg1]`，指定 Zig 为参数或返回值</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 使用的寄存器。不过，</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 下方代码没有使用这一方式。字面量 `%` 可以</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 用两个百分号转义得到：`%%`。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#616972;--1:#99A0A6\">// 此处多行字符串语法通常很有用。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#032F62;--1:#9ECBFF\">\\\\syscall</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#616972;--1:#99A0A6\">// 接下来是输出。未来 Zig 是否支持</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#616972;--1:#99A0A6\">// 多个输出，取决于</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#616972;--1:#99A0A6\">// https://github.com/ziglang/zig/issues/215 的解决方式。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#616972;--1:#99A0A6\">// 允许没有输出；此时这个冒号后面会</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#616972;--1:#99A0A6\">// 直接跟随表示输入的冒号。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">        </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">:</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#616972;--1:#99A0A6\">// 这里指定在上述汇编字符串的 `%[ret]` 语法中</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#616972;--1:#99A0A6\">// 使用的名称。本例没有使用它，</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#616972;--1:#99A0A6\">// 但语法要求必须提供。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">          </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">[</span><span style=\"--0:#AE4B07;--1:#FFAB70\">ret</span><span style=\"--0:#24292E;--1:#E1E4E8\">]</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 接下来是输出约束字符串。此功能在 Zig 中</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 仍视为不稳定，因此必须参考 LLVM/GCC 文档</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 理解语义。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// http://releases.llvm.org/10.0.0/docs/LangRef.html#inline-asm-constraint-string</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// https://gcc.gnu.org/onlinedocs/gcc/Extended-Asm.html</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 本例中，约束字符串的意思是“此内联汇编指令</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 的结果值就是 $rax 中的内容”。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"={rax}\"</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 接下来是值绑定，或者 `-&gt;` 后跟类型。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 该类型就是内联汇编表达式的结果类型。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 如果是值绑定，则使用 `%[ret]` 语法</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 引用绑定到该值的寄存器。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">          </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#BF3441;--1:#F97583\">-&gt;</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">usize</span><span style=\"--0:#24292E;--1:#E1E4E8\">),</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 接下来是输入列表。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 这些输入约束的意思是：“执行汇编代码时，</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// $rax 应具有 `number` 的值，$rdi 应具有</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// `arg1` 的值”。允许任意数量的输入参数，</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 也可以没有输入参数。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">        </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">: [</span><span style=\"--0:#AE4B07;--1:#FFAB70\">number</span><span style=\"--0:#24292E;--1:#E1E4E8\">] </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"{rax}\"</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span><span style=\"--0:#AE4B07;--1:#FFAB70\">number</span><span style=\"--0:#24292E;--1:#E1E4E8\">),</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">          </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">[</span><span style=\"--0:#AE4B07;--1:#FFAB70\">arg1</span><span style=\"--0:#24292E;--1:#E1E4E8\">] </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"{rdi}\"</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span><span style=\"--0:#AE4B07;--1:#FFAB70\">arg1</span><span style=\"--0:#24292E;--1:#E1E4E8\">),</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 接下来是破坏声明列表，用来声明一组寄存器，</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 它们的值在执行汇编后不保证保留。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 不包括输入或输出寄存器。特殊的破坏声明值</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// \"memory\" 表示汇编会写入任意未声明的</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 内存位置，而不仅仅是已声明的间接</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 输出所指向的内存。本例列出 $rcx 和 $r11，</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">          </span><span style=\"--0:#616972;--1:#99A0A6\">// 因为已知内核系统调用不会保留这些寄存器。</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">        </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">: .{ .</span><span style=\"--0:#AE4B07;--1:#FFAB70\">rcx</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">true</span><span style=\"--0:#24292E;--1:#E1E4E8\">, .</span><span style=\"--0:#AE4B07;--1:#FFAB70\">r11</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">true</span><span style=\"--0:#24292E;--1:#E1E4E8\"> });</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">}</span></div></div></code></pre></figure></div>\n\n      <p>对于 x86 和 x86_64 目标，使用 AT&amp;T 语法，而不是更常见的 Intel 语法。这源于技术限制：汇编解析由 LLVM 提供，而其 Intel 语法支持存在缺陷，也未经过充分测试。</p>\n      <p>Zig 将来可能拥有自己的汇编器，以便更紧密地融入语言，并兼容常见的 NASM 语法。在发布 1.0.0 之前，本节文档将更新，明确说明 AT&amp;T 与 Intel/NASM 语法的最终支持状态。</p>\n      <h3 id=\"Output-Constraints\"><a href=\"/zig-docs/zh-cn/reference/Assembly/#Output-Constraints\">输出约束</a></h3>\n\n      <p>Zig 中的输出约束仍视为不稳定功能，因此必须参考 <a href=\"http://releases.llvm.org/10.0.0/docs/LangRef.html#inline-asm-constraint-string\">LLVM 文档</a>和 <a href=\"https://gcc.gnu.org/onlinedocs/gcc/Extended-Asm.html\">GCC 文档</a>理解其语义。</p>\n      <p>注意，<a href=\"https://github.com/ziglang/zig/issues/215\">议题 #215</a> 计划对输出约束做出一些破坏性修改。</p>\n      \n\n      <h3 id=\"Input-Constraints\"><a href=\"/zig-docs/zh-cn/reference/Assembly/#Input-Constraints\">输入约束</a></h3>\n\n      <p>Zig 中的输入约束仍视为不稳定功能，因此必须参考 <a href=\"http://releases.llvm.org/10.0.0/docs/LangRef.html#inline-asm-constraint-string\">LLVM 文档</a>和 <a href=\"https://gcc.gnu.org/onlinedocs/gcc/Extended-Asm.html\">GCC 文档</a>理解其语义。</p>\n      <p>注意，<a href=\"https://github.com/ziglang/zig/issues/215\">议题 #215</a> 计划对输入约束做出一些破坏性修改。</p>\n      \n\n      <h3 id=\"Clobbers\"><a href=\"/zig-docs/zh-cn/reference/Assembly/#Clobbers\">破坏声明</a></h3>\n\n      <p>破坏声明是执行汇编代码后不保证保留值的寄存器集合，不包括输入或输出寄存器。特殊的破坏声明值 <code><span class=\"tok-str\">\"memory\"</span></code> 表示汇编会写入任意未声明的内存位置，而不仅仅是已声明的间接输出所指向的内存。</p>\n      <p>未完整声明某个内联汇编表达式的全部破坏项，属于不进行检查的<a href=\"/zig-docs/zh-cn/reference/Illegal-Behavior/#Illegal-Behavior\">非法行为</a>。</p>\n      \n\n      <h3 id=\"Global-Assembly\"><a href=\"/zig-docs/zh-cn/reference/Assembly/#Global-Assembly\">全局汇编</a></h3>\n\n      <p>汇编表达式出现在<a href=\"/zig-docs/zh-cn/reference/Namespace/#Namespace\">命名空间</a>级的 <a href=\"/zig-docs/zh-cn/reference/comptime/#comptime\">comptime</a> 块中时，称为<strong>全局汇编</strong>。</p>\n      <p>这种汇编的规则与内联汇编不同。首先，<code><span class=\"tok-kw\">volatile</span></code> 无效，因为所有全局汇编都会无条件包含。其次，没有输入、输出或破坏声明。所有全局汇编都逐字拼接成一个长字符串，再一起汇编。它不像内联汇编表达式那样具有关于 <code>%</code> 的模板替换规则。</p>\n      <div class=\"expressive-code\"><figure class=\"frame has-title\"><figcaption class=\"header\"><span class=\"title\">test_global_assembly.zig</span></figcaption><pre data-language=\"zig\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#BF3441;--1:#F97583\">const</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">std</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#005CC5;--1:#79B8FF\">@import</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#032F62;--1:#9ECBFF\">\"std\"</span><span style=\"--0:#24292E;--1:#E1E4E8\">);</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#BF3441;--1:#F97583\">const</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">expectEqual</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">std</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#AE4B07;--1:#FFAB70\">testing</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#AE4B07;--1:#FFAB70\">expectEqual</span><span style=\"--0:#24292E;--1:#E1E4E8\">;</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#BF3441;--1:#F97583\">comptime</span><span style=\"--0:#24292E;--1:#E1E4E8\"> {</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#BF3441;--1:#F97583\">asm</span><span style=\"--0:#24292E;--1:#E1E4E8\"> (</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#032F62;--1:#9ECBFF\">\\\\.global my_func;</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#032F62;--1:#9ECBFF\">\\\\.type my_func, @function;</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#032F62;--1:#9ECBFF\">\\\\my_func:</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#032F62;--1:#9ECBFF\">\\\\  lea (%rdi,%rsi,1),%eax</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">        </span><span style=\"--0:#032F62;--1:#9ECBFF\">\\\\  retq</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">    </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">);</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">}</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#BF3441;--1:#F97583\">extern</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">fn</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#6F42C1;--1:#B392F0\">my_func</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#AE4B07;--1:#FFAB70\">a</span><span style=\"--0:#24292E;--1:#E1E4E8\">: </span><span style=\"--0:#BF3441;--1:#F97583\">i32</span><span style=\"--0:#24292E;--1:#E1E4E8\">, </span><span style=\"--0:#AE4B07;--1:#FFAB70\">b</span><span style=\"--0:#24292E;--1:#E1E4E8\">: </span><span style=\"--0:#BF3441;--1:#F97583\">i32</span><span style=\"--0:#24292E;--1:#E1E4E8\">) </span><span style=\"--0:#BF3441;--1:#F97583\">i32</span><span style=\"--0:#24292E;--1:#E1E4E8\">;</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#BF3441;--1:#F97583\">test</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"global assembly\"</span><span style=\"--0:#24292E;--1:#E1E4E8\"> {</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#BF3441;--1:#F97583\">try</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#6F42C1;--1:#B392F0\">expectEqual</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#005CC5;--1:#79B8FF\">46</span><span style=\"--0:#24292E;--1:#E1E4E8\">, </span><span style=\"--0:#6F42C1;--1:#B392F0\">my_func</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#005CC5;--1:#79B8FF\">12</span><span style=\"--0:#24292E;--1:#E1E4E8\">, </span><span style=\"--0:#005CC5;--1:#79B8FF\">34</span><span style=\"--0:#24292E;--1:#E1E4E8\">));</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">}</span></div></div></code></pre></figure></div><div class=\"expressive-code\"><figure class=\"frame is-terminal has-title\"><figcaption class=\"header\"><span class=\"title\">命令行</span></figcaption><pre data-language=\"shellsession\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">$ zig test test_global_assembly.zig -target x86_64-linux -fllvm</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#005CC5;--1:#79B8FF\">1/1 test_global_assembly.test.global assembly...OK</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#005CC5;--1:#79B8FF\">All 1 tests passed.</span></div></div>\n</code></pre></figure></div>\n\n      \n      \n\n      ","translation":{"total":64,"translated":64}}

2\" href=\"#L32\" tabindex=\"-1\">32</a>\n<a id=\"L33\" href=\"#L33\" tabindex=\"-1\">33</a>\n<a id=\"L34\" href=\"#L34\" tabindex=\"-1\">34</a>\n<a id=\"L35\" href=\"#L35\" tabindex=\"-1\">35</a>\n<a id=\"L36\" href=\"#L36\" tabindex=\"-1\">36</a>\n<a id=\"L37\" href=\"#L37\" tabindex=\"-1\">37</a>\n<a id=\"L38\" href=\"#L38\" tabindex=\"-1\">38</a>\n<a id=\"L39\" href=\"#L39\" tabindex=\"-1\">39</a>\n<a id=\"L40\" href=\"#L40\" tabindex=\"-1\">40</a>\n<a id=\"L41\" href=\"#L41\" tabindex=\"-1\">41</a>\n<a id=\"L42\" href=\"#L42\" tabindex=\"-1\">42</a>\n<a id=\"L43\" href=\"#L43\" tabindex=\"-1\">43</a>\n<a id=\"L44\" href=\"#L44\" tabindex=\"-1\">44</a>\n<a id=\"L45\" href=\"#L45\" tabindex=\"-1\">45</a>\n<a id=\"L46\" href=\"#L46\" tabindex=\"-1\">46</a>\n<a id=\"L47\" href=\"#L47\" tabindex=\"-1\">47</a>\n<a id=\"L48\" href=\"#L48\" tabindex=\"-1\">48</a>\n<a id=\"L49\" href=\"#L49\" tabindex=\"-1\">49</a>\n<a id=\"L50\" href=\"#L50\" tabindex=\"-1\">50</a>\n<a id=\"L51\" href=\"#L51\" tabindex=\"-1\">51</a>\n<a id=\"L52\" href=\"#L52\" tabindex=\"-1\">52</a>\n<a id=\"L53\" href=\"#L53\" tabindex=\"-1\">53</a>\n<a id=\"L54\" href=\"#L54\" tabindex=\"-1\">54</a>\n<a id=\"L55\" href=\"#L55\" tabindex=\"-1\">55</a>\n<a id=\"L56\" href=\"#L56\" tabindex=\"-1\">56</a>\n<a id=\"L57\" href=\"#L57\" tabindex=\"-1\">57</a>\n<a id=\"L58\" href=\"#L58\" tabindex=\"-1\">58</a>\n<a id=\"L59\" href=\"#L59\" tabindex=\"-1\">59</a>\n<a id=\"L60\" href=\"#L60\" tabindex=\"-1\">60</a>\n<a id=\"L61\" href=\"#L61\" tabindex=\"-1\">61</a>\n<a id=\"L62\" href=\"#L62\" tabindex=\"-1\">62</a>\n<a id=\"L63\" href=\"#L63\" tabindex=\"-1\">63</a>\n<a id=\"L64\" href=\"#L64\" tabindex=\"-1\">64</a>\n<a id=\"L65\" href=\"#L65\" tabindex=\"-1\">65</a>\n<a id=\"L66\" href=\"#L66\" tabindex=\"-1\">66</a>\n<a id=\"L67\" href=\"#L67\" tabindex=\"-1\">67</a>\n<a id=\"L68\" href=\"#L68\" tabindex=\"-1\">68</a>\n<a id=\"L69\" href=\"#L69\" tabindex=\"-1\">69</a>\n<a id=\"L70\" href=\"#L70\" tabindex=\"-1\">70</a>\n<a id=\"L71\" href=\"#L71\" tabindex=\"-1\">71</a>\n<a id=\"L72\" href=\"#L72\" tabindex=\"-1\">72</a>\n<a id=\"L73\" href=\"#L73\" tabindex=\"-1\">73</a>\n<a id=\"L74\" href=\"#L74\" tabindex=\"-1\">74</a>\n<a id=\"L75\" href=\"#L75\" tabindex=\"-1\">75</a>\n<a id=\"L76\" href=\"#L76\" tabindex=\"-1\">76</a>\n<a id=\"L77\" href=\"#L77\" tabindex=\"-1\">77</a>\n<a id=\"L78\" href=\"#L78\" tabindex=\"-1\">78</a>\n<a id=\"L79\" href=\"#L79\" tabindex=\"-1\">79</a>\n<a id=\"L80\" href=\"#L80\" tabindex=\"-1\">80</a>\n<a id=\"L81\" href=\"#L81\" tabindex=\"-1\">81</a>\n<a id=\"L82\" href=\"#L82\" tabindex=\"-1\">82</a>\n<a id=\"L83\" href=\"#L83\" tabindex=\"-1\">83</a>\n<a id=\"L84\" href=\"#L84\" tabindex=\"-1\">84</a>\n<a id=\"L85\" href=\"#L85\" tabindex=\"-1\">85</a>\n<a id=\"L86\" href=\"#L86\" tabindex=\"-1\">86</a>\n<a id=\"L87\" href=\"#L87\" tabindex=\"-1\">87</a>\n<a id=\"L88\" href=\"#L88\" tabindex=\"-1\">88</a>\n<a id=\"L89\" href=\"#L89\" tabindex=\"-1\">89</a>\n<a id=\"L90\" href=\"#L90\" tabindex=\"-1\">90</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">//! 将十六进制浮点表示转换为精确值。</span><span class=\"tok-comment\">\n//\n// 源自 golang strconv/atof.go。\n\n</span><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n<span class=\"tok-kw\">const</span> math = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>;\n<span class=\"tok-kw\">const</span> common = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"common.zig\"</span>);\n<span class=\"tok-kw\">const</span> Number = <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common\">common</a>.<a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.Number\">Number</a>;\n<span class=\"tok-kw\">const</span> floatFromUnsigned = <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common\">common</a>.<a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.floatFromUnsigned\">floatFromUnsigned</a>;<span class=\"tok-comment\">\n\n// 转换 0xMMM.NNNpEEE 形式。\n//\n// MMM.NNN = 尾数\n// EEE = 指数\n//\n// MMM.NNN 存储为整数，指数进行偏移。\n</span><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">convertHex</span>(<span class=\"tok-kw\">comptime</span> T: <span class=\"tok-type\">type</span>, n_: <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.Number\">Number</a>(T)) T {\n    <span class=\"tok-kw\">const</span> MantissaT = <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common\">common</a>.<a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.mantissaType\">mantissaType</a>(T);\n    <span class=\"tok-kw\">var</span> n = n_;\n\n    <span class=\"tok-kw\">if</span> (n.mantissa == <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">if</span> (n.negative) -<span class=\"tok-number\">0.0</span> <span class=\"tok-kw\">else</span> <span class=\"tok-number\">0.0</span>;\n    }\n\n    <span class=\"tok-kw\">const</span> max_exp = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatExponentMax\">floatExponentMax</a>(T);\n    <span class=\"tok-kw\">const</span> min_exp = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatExponentMin\">floatExponentMin</a>(T);\n    <span class=\"tok-kw\">const</span> mantissa_bits = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatMantissaBits\">floatMantissaBits</a>(T);\n    <span class=\"tok-kw\">const</span> fractional_bits = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatFractionalBits\">floatFractionalBits</a>(T);\n    <span class=\"tok-kw\">const</span> exp_bits = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatExponentBits\">floatExponentBits</a>(T);\n    <span class=\"tok-kw\">const</span> exp_bias = min_exp - <span class=\"tok-number\">1</span>;<span class=\"tok-comment\">\n\n    // 尾数现在隐式除以 2^fractional_bits。\n    </span>n.exponent += fractional_bits;<span class=\"tok-comment\">\n\n    // 移位调整尾数和指数，使表示落入 float 范围。\n    // 最终希望尾数以一个值为 1 的位开头，后跟 mantbits 个位。\n    // 为舍入还需额外两位，其中最低位表示\n    // 该位或其后任意位是否曾非零。\n    // 若尾数已丢失非零位，则 trunc 为 true，\n    // 适当左移后，在下方按位或入一个 1。\n    </span><span class=\"tok-kw\">while</span> (n.mantissa != <span class=\"tok-number\">0</span> <span class=\"tok-kw\">and</span> n.mantissa &gt;&gt; (mantissa_bits + <span class=\"tok-number\">2</span>) == <span class=\"tok-number\">0</span>) {\n        n.mantissa &lt;&lt;= <span class=\"tok-number\">1</span>;\n        n.exponent -= <span class=\"tok-number\">1</span>;\n    }\n    <span class=\"tok-kw\">if</span> (n.many_digits) {\n        n.mantissa |= <span class=\"tok-number\">1</span>;\n    }\n    <span class=\"tok-kw\">while</span> (n.mantissa &gt;&gt; (<span class=\"tok-number\">1</span> + fractional_bits + <span class=\"tok-number\">2</span>) != <span class=\"tok-number\">0</span>) {\n        n.mantissa = (n.mantissa &gt;&gt; <span class=\"tok-number\">1</span>) | (n.mantissa &amp; <span class=\"tok-number\">1</span>);\n        n.exponent += <span class=\"tok-number\">1</span>;\n    }<span class=\"tok-comment\">\n\n    // 若指数过小，\n    // 则尝试非正规化，使其可表示。\n    // 其中 -2 用于舍入位。\n    </span><span class=\"tok-kw\">while</span> (n.mantissa &gt; <span class=\"tok-number\">1</span> <span class=\"tok-kw\">and</span> n.exponent &lt; min_exp - <span class=\"tok-number\">2</span>) {\n        n.mantissa = (n.mantissa &gt;&gt; <span class=\"tok-number\">1</span>) | (n.mantissa &amp; <span class=\"tok-number\">1</span>);\n        n.exponent += <span class=\"tok-number\">1</span>;\n    }<span class=\"tok-comment\">\n\n    // 使用最低两位舍入。\n    </span><span class=\"tok-kw\">var</span> round = n.mantissa &amp; <span class=\"tok-number\">3</span>;\n    n.mantissa &gt;&gt;= <span class=\"tok-number\">2</span>;\n    round |= n.mantissa &amp; <span class=\"tok-number\">1</span>;<span class=\"tok-comment\"> // 舍入至偶数（尾数为奇数时向上舍入）\n    </span>n.exponent += <span class=\"tok-number\">2</span>;\n    <span class=\"tok-kw\">if</span> (round == <span class=\"tok-number\">3</span>) {\n        n.mantissa += <span class=\"tok-number\">1</span>;\n        <span class=\"tok-kw\">if</span> (n.mantissa == <span class=\"tok-number\">1</span> &lt;&lt; (<span class=\"tok-number\">1</span> + fractional_bits)) {\n            n.mantissa &gt;&gt;= <span class=\"tok-number\">1</span>;\n            n.exponent += <span class=\"tok-number\">1</span>;\n        }\n    }<span class=\"tok-comment\">\n\n    // 非正规数或零\n    </span><span class=\"tok-kw\">if</span> (n.mantissa &gt;&gt; fractional_bits == <span class=\"tok-number\">0</span>) {\n        n.exponent = exp_bias;\n    }<span class=\"tok-comment\">\n\n    // 无穷大与范围错误\n    </span><span class=\"tok-kw\">if</span> (n.exponent &gt; max_exp) {\n        <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">if</span> (n.negative) -<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.inf\">inf</a>(T) <span class=\"tok-kw\">else</span> <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.inf\">inf</a>(T);\n    }\n\n    <span class=\"tok-kw\">var</span> bits = n.mantissa &amp; ((<span class=\"tok-number\">1</span> &lt;&lt; mantissa_bits) - <span class=\"tok-number\">1</span>);\n    bits |= <span class=\"tok-builtin\">@as</span>(MantissaT, <span class=\"tok-builtin\">@intCast</span>((n.exponent - exp_bias) &amp; ((<span class=\"tok-number\">1</span> &lt;&lt; exp_bits) - <span class=\"tok-number\">1</span>))) &lt;&lt; mantissa_bits;\n    <span class=\"tok-kw\">if</span> (n.negative) {\n        bits |= <span class=\"tok-number\">1</span> &lt;&lt; (mantissa_bits + exp_bits);\n    }\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.floatFromUnsigned\">floatFromUnsigned</a>(T, MantissaT, bits);\n}\n</code></pre></div></details>"}

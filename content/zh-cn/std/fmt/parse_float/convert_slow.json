94\" tabindex=\"-1\">94</a>\n<a id=\"L95\" href=\"#L95\" tabindex=\"-1\">95</a>\n<a id=\"L96\" href=\"#L96\" tabindex=\"-1\">96</a>\n<a id=\"L97\" href=\"#L97\" tabindex=\"-1\">97</a>\n<a id=\"L98\" href=\"#L98\" tabindex=\"-1\">98</a>\n<a id=\"L99\" href=\"#L99\" tabindex=\"-1\">99</a>\n<a id=\"L100\" href=\"#L100\" tabindex=\"-1\">100</a>\n<a id=\"L101\" href=\"#L101\" tabindex=\"-1\">101</a>\n<a id=\"L102\" href=\"#L102\" tabindex=\"-1\">102</a>\n<a id=\"L103\" href=\"#L103\" tabindex=\"-1\">103</a>\n<a id=\"L104\" href=\"#L104\" tabindex=\"-1\">104</a>\n<a id=\"L105\" href=\"#L105\" tabindex=\"-1\">105</a>\n<a id=\"L106\" href=\"#L106\" tabindex=\"-1\">106</a>\n<a id=\"L107\" href=\"#L107\" tabindex=\"-1\">107</a>\n<a id=\"L108\" href=\"#L108\" tabindex=\"-1\">108</a>\n<a id=\"L109\" href=\"#L109\" tabindex=\"-1\">109</a>\n<a id=\"L110\" href=\"#L110\" tabindex=\"-1\">110</a>\n<a id=\"L111\" href=\"#L111\" tabindex=\"-1\">111</a>\n<a id=\"L112\" href=\"#L112\" tabindex=\"-1\">112</a>\n<a id=\"L113\" href=\"#L113\" tabindex=\"-1\">113</a>\n<a id=\"L114\" href=\"#L114\" tabindex=\"-1\">114</a>\n<a id=\"L115\" href=\"#L115\" tabindex=\"-1\">115</a>\n<a id=\"L116\" href=\"#L116\" tabindex=\"-1\">116</a>\n<a id=\"L117\" href=\"#L117\" tabindex=\"-1\">117</a>\n<a id=\"L118\" href=\"#L118\" tabindex=\"-1\">118</a>\n<a id=\"L119\" href=\"#L119\" tabindex=\"-1\">119</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n<span class=\"tok-kw\">const</span> math = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>;\n<span class=\"tok-kw\">const</span> common = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"common.zig\"</span>);\n<span class=\"tok-kw\">const</span> BiasedFp = <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common\">common</a>.<a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.BiasedFp\">BiasedFp</a>;\n<span class=\"tok-kw\">const</span> Decimal = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"decimal.zig\"</span>).Decimal;\n<span class=\"tok-kw\">const</span> mantissaType = <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common\">common</a>.<a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.mantissaType\">mantissaType</a>;\n\n<span class=\"tok-kw\">const</span> max_shift = <span class=\"tok-number\">60</span>;\n<span class=\"tok-kw\">const</span> num_powers = <span class=\"tok-number\">19</span>;\n<span class=\"tok-kw\">const</span> powers = [_]<span class=\"tok-type\">u8</span>{ <span class=\"tok-number\">0</span>, <span class=\"tok-number\">3</span>, <span class=\"tok-number\">6</span>, <span class=\"tok-number\">9</span>, <span class=\"tok-number\">13</span>, <span class=\"tok-number\">16</span>, <span class=\"tok-number\">19</span>, <span class=\"tok-number\">23</span>, <span class=\"tok-number\">26</span>, <span class=\"tok-number\">29</span>, <span class=\"tok-number\">33</span>, <span class=\"tok-number\">36</span>, <span class=\"tok-number\">39</span>, <span class=\"tok-number\">43</span>, <span class=\"tok-number\">46</span>, <span class=\"tok-number\">49</span>, <span class=\"tok-number\">53</span>, <span class=\"tok-number\">56</span>, <span class=\"tok-number\">59</span> };\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">getShift</span>(n: <span class=\"tok-type\">usize</span>) <span class=\"tok-type\">usize</span> {\n    <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">if</span> (n &lt; <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/convert_slow/#std.fmt.parse_float.convert_slow.num_powers\">num_powers</a>) <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/convert_slow/#std.fmt.parse_float.convert_slow.powers\">powers</a>[n] <span class=\"tok-kw\">else</span> <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/convert_slow/#std.fmt.parse_float.convert_slow.max_shift\">max_shift</a>;\n}\n\n<span class=\"tok-comment\">/// 解析浮点数的有效数字及带偏置的二进制指数。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 这是一种后备算法，使用浮点数的大整数表示，因此比更快的近似算法慢得多。不过，它始终能够确定如何将有效数字舍入到最接近的机器浮点数，从而处理接近中点的情况。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 中点位于两个相邻机器浮点数之间。例如，浮点数 `16777217.0` 的二进制表示为 `100000000000000000000000 1`。舍入为单精度浮点数时，末尾的 `1` 被截去。采用舍入到最近值、中点取偶数的规则时，任何大于 `16777217.0` 的值都必须向上舍入为 `16777218.0`，而任何小于或等于 `16777217.0` 的值都必须向下舍入为 `16777216.0`。因此，接近中点的转换可能需要大量数字，才能无歧义地确定舍入方向。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 这里的算法基于《快速处理长数字》，可在此获取：&lt;https://arxiv.org/pdf/2101.11408.pdf#section.11&gt;。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 注意，此函数需要大量栈空间，并标记为冷路径，以提示编译器不要将其内联到调用者中。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">convertSlow</span>(<span class=\"tok-kw\">comptime</span> T: <span class=\"tok-type\">type</span>, s: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.BiasedFp\">BiasedFp</a>(T) {\n    <span class=\"tok-builtin\">@branchHint</span>(.cold);\n\n    <span class=\"tok-kw\">const</span> MantissaT = <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.mantissaType\">mantissaType</a>(T);\n    <span class=\"tok-kw\">const</span> min_exponent = -(<span class=\"tok-number\">1</span> &lt;&lt; (<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatExponentBits\">floatExponentBits</a>(T) - <span class=\"tok-number\">1</span>)) + <span class=\"tok-number\">1</span>;\n    <span class=\"tok-kw\">const</span> infinite_power = (<span class=\"tok-number\">1</span> &lt;&lt; <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatExponentBits\">floatExponentBits</a>(T)) - <span class=\"tok-number\">1</span>;\n    <span class=\"tok-kw\">const</span> fractional_bits = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatFractionalBits\">floatFractionalBits</a>(T);\n\n    <span class=\"tok-kw\">var</span> d = <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/decimal/#std.fmt.parse_float.decimal.Decimal\">Decimal</a>(T).parse(s);<span class=\"tok-comment\"> // 无需重新检查下划线\n    </span><span class=\"tok-kw\">if</span> (d.num_digits == <span class=\"tok-number\">0</span> <span class=\"tok-kw\">or</span> d.decimal_point &lt; <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/decimal/#std.fmt.parse_float.decimal.Decimal\">Decimal</a>(T).min_exponent) {\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.BiasedFp\">BiasedFp</a>(T).zero();\n    } <span class=\"tok-kw\">else</span> <span class=\"tok-kw\">if</span> (d.decimal_point &gt;= <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/decimal/#std.fmt.parse_float.decimal.Decimal\">Decimal</a>(T).max_exponent) {\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.BiasedFp\">BiasedFp</a>(T).inf(T);\n    }\n\n    <span class=\"tok-kw\">var</span> exp2: <span class=\"tok-type\">i32</span> = <span class=\"tok-number\">0</span>;<span class=\"tok-comment\">\n    // 右移至 (1/2 .. 1] 范围\n    </span><span class=\"tok-kw\">while</span> (d.decimal_point &gt; <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-kw\">const</span> n = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">usize</span>, <span class=\"tok-builtin\">@intCast</span>(d.decimal_point));\n        <span class=\"tok-kw\">const</span> shift = <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/convert_slow/#std.fmt.parse_float.convert_slow.getShift\">getShift</a>(n);\n        d.rightShift(shift);\n        <span class=\"tok-kw\">if</span> (d.decimal_point &lt; -<a href=\"/zig-docs/zh-cn/std/fmt/parse_float/decimal/#std.fmt.parse_float.decimal.Decimal\">Decimal</a>(T).decimal_point_range) {\n            <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.BiasedFp\">BiasedFp</a>(T).zero();\n        }\n        exp2 += <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">i32</span>, <span class=\"tok-builtin\">@intCast</span>(shift));\n    }<span class=\"tok-comment\">\n    //  向左移至 (1/2 .. 1]\n    </span><span class=\"tok-kw\">while</span> (d.decimal_point &lt;= <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-kw\">const</span> shift = blk: {\n            <span class=\"tok-kw\">if</span> (d.decimal_point == <span class=\"tok-number\">0</span>) {\n                <span class=\"tok-kw\">break</span> :blk <span class=\"tok-kw\">switch</span> (d.digits[<span class=\"tok-number\">0</span>]) {\n                    <span class=\"tok-number\">5</span>...<span class=\"tok-number\">9</span> =&gt; <span class=\"tok-kw\">break</span>,\n                    <span class=\"tok-number\">0</span>, <span class=\"tok-number\">1</span> =&gt; <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">usize</span>, <span class=\"tok-number\">2</span>),\n                    <span class=\"tok-kw\">else</span> =&gt; <span class=\"tok-number\">1</span>,\n                };\n            } <span class=\"tok-kw\">else</span> {\n                <span class=\"tok-kw\">const</span> n = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">usize</span>, <span class=\"tok-builtin\">@intCast</span>(-d.decimal_point));\n                <span class=\"tok-kw\">break</span> :blk <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/convert_slow/#std.fmt.parse_float.convert_slow.getShift\">getShift</a>(n);\n            }\n        };\n        d.leftShift(shift);\n        <span class=\"tok-kw\">if</span> (d.decimal_point &gt; <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/decimal/#std.fmt.parse_float.decimal.Decimal\">Decimal</a>(T).decimal_point_range) {\n            <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.BiasedFp\">BiasedFp</a>(T).inf(T);\n        }\n        exp2 -= <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">i32</span>, <span class=\"tok-builtin\">@intCast</span>(shift));\n    }<span class=\"tok-comment\">\n    // 当前位于 [1/2 .. 1] 范围，但二进制格式使用 [1 .. 2]。\n    </span>exp2 -= <span class=\"tok-number\">1</span>;\n    <span class=\"tok-kw\">while</span> (min_exponent + <span class=\"tok-number\">1</span> &gt; exp2) {\n        <span class=\"tok-kw\">var</span> n = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">usize</span>, <span class=\"tok-builtin\">@intCast</span>((min_exponent + <span class=\"tok-number\">1</span>) - exp2));\n        <span class=\"tok-kw\">if</span> (n &gt; <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/convert_slow/#std.fmt.parse_float.convert_slow.max_shift\">max_shift</a>) {\n            n = <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/convert_slow/#std.fmt.parse_float.convert_slow.max_shift\">max_shift</a>;\n        }\n        d.rightShift(n);\n        exp2 += <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">i32</span>, <span class=\"tok-builtin\">@intCast</span>(n));\n    }\n    <span class=\"tok-kw\">if</span> (exp2 - min_exponent &gt;= infinite_power) {\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.BiasedFp\">BiasedFp</a>(T).inf(T);\n    }<span class=\"tok-comment\">\n\n    // 将小数移至隐藏位，再对值进行舍入，\n    // 以获得高 mantissa+1 位。\n    </span>d.leftShift(fractional_bits + <span class=\"tok-number\">1</span>);\n    <span class=\"tok-kw\">var</span> mantissa = d.round();\n    <span class=\"tok-kw\">if</span> (mantissa &gt;= (<span class=\"tok-builtin\">@as</span>(MantissaT, <span class=\"tok-number\">1</span>) &lt;&lt; (fractional_bits + <span class=\"tok-number\">1</span>))) {<span class=\"tok-comment\">\n        // 向上舍入溢出到进位位，需要移回隐藏位。\n        //\n        </span>d.rightShift(<span class=\"tok-number\">1</span>);\n        exp2 += <span class=\"tok-number\">1</span>;\n        mantissa = d.round();\n        <span class=\"tok-kw\">if</span> ((exp2 - min_exponent) &gt;= infinite_power) {\n            <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/fmt/parse_float/common/#std.fmt.parse_float.common.BiasedFp\">BiasedFp</a>(T).inf(T);\n        }\n    }\n    <span class=\"tok-kw\">var</span> power2 = exp2 - min_exponent;\n    <span class=\"tok-kw\">if</span> (mantissa &lt; (<span class=\"tok-builtin\">@as</span>(MantissaT, <span class=\"tok-number\">1</span>) &lt;&lt; fractional_bits)) {\n        power2 -= <span class=\"tok-number\">1</span>;\n    }<span class=\"tok-comment\">\n    // 将尾数位以上的所有位清零。\n    </span>mantissa &amp;= (<span class=\"tok-builtin\">@as</span>(MantissaT, <span class=\"tok-number\">1</span>) &lt;&lt; <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatMantissaBits\">floatMantissaBits</a>(T)) - <span class=\"tok-number\">1</span>;\n    <span class=\"tok-kw\">return</span> .{ .f = mantissa, .e = power2 };\n}\n</code></pre></div></details>"}

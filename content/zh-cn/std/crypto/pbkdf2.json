id=\"L153\" href=\"#L153\" tabindex=\"-1\">153</a>\n<a id=\"L154\" href=\"#L154\" tabindex=\"-1\">154</a>\n<a id=\"L155\" href=\"#L155\" tabindex=\"-1\">155</a>\n<a id=\"L156\" href=\"#L156\" tabindex=\"-1\">156</a>\n<a id=\"L157\" href=\"#L157\" tabindex=\"-1\">157</a>\n<a id=\"L158\" href=\"#L158\" tabindex=\"-1\">158</a>\n<a id=\"L159\" href=\"#L159\" tabindex=\"-1\">159</a>\n<a id=\"L160\" href=\"#L160\" tabindex=\"-1\">160</a>\n<a id=\"L161\" href=\"#L161\" tabindex=\"-1\">161</a>\n<a id=\"L162\" href=\"#L162\" tabindex=\"-1\">162</a>\n<a id=\"L163\" href=\"#L163\" tabindex=\"-1\">163</a>\n<a id=\"L164\" href=\"#L164\" tabindex=\"-1\">164</a>\n<a id=\"L165\" href=\"#L165\" tabindex=\"-1\">165</a>\n<a id=\"L166\" href=\"#L166\" tabindex=\"-1\">166</a>\n<a id=\"L167\" href=\"#L167\" tabindex=\"-1\">167</a>\n<a id=\"L168\" href=\"#L168\" tabindex=\"-1\">168</a>\n<a id=\"L169\" href=\"#L169\" tabindex=\"-1\">169</a>\n<a id=\"L170\" href=\"#L170\" tabindex=\"-1\">170</a>\n<a id=\"L171\" href=\"#L171\" tabindex=\"-1\">171</a>\n<a id=\"L172\" href=\"#L172\" tabindex=\"-1\">172</a>\n<a id=\"L173\" href=\"#L173\" tabindex=\"-1\">173</a>\n<a id=\"L174\" href=\"#L174\" tabindex=\"-1\">174</a>\n<a id=\"L175\" href=\"#L175\" tabindex=\"-1\">175</a>\n<a id=\"L176\" href=\"#L176\" tabindex=\"-1\">176</a>\n<a id=\"L177\" href=\"#L177\" tabindex=\"-1\">177</a>\n<a id=\"L178\" href=\"#L178\" tabindex=\"-1\">178</a>\n<a id=\"L179\" href=\"#L179\" tabindex=\"-1\">179</a>\n<a id=\"L180\" href=\"#L180\" tabindex=\"-1\">180</a>\n<a id=\"L181\" href=\"#L181\" tabindex=\"-1\">181</a>\n<a id=\"L182\" href=\"#L182\" tabindex=\"-1\">182</a>\n<a id=\"L183\" href=\"#L183\" tabindex=\"-1\">183</a>\n<a id=\"L184\" href=\"#L184\" tabindex=\"-1\">184</a>\n<a id=\"L185\" href=\"#L185\" tabindex=\"-1\">185</a>\n<a id=\"L186\" href=\"#L186\" tabindex=\"-1\">186</a>\n<a id=\"L187\" href=\"#L187\" tabindex=\"-1\">187</a>\n<a id=\"L188\" href=\"#L188\" tabindex=\"-1\">188</a>\n<a id=\"L189\" href=\"#L189\" tabindex=\"-1\">189</a>\n<a id=\"L190\" href=\"#L190\" tabindex=\"-1\">190</a>\n<a id=\"L191\" href=\"#L191\" tabindex=\"-1\">191</a>\n<a id=\"L192\" href=\"#L192\" tabindex=\"-1\">192</a>\n<a id=\"L193\" href=\"#L193\" tabindex=\"-1\">193</a>\n<a id=\"L194\" href=\"#L194\" tabindex=\"-1\">194</a>\n<a id=\"L195\" href=\"#L195\" tabindex=\"-1\">195</a>\n<a id=\"L196\" href=\"#L196\" tabindex=\"-1\">196</a>\n<a id=\"L197\" href=\"#L197\" tabindex=\"-1\">197</a>\n<a id=\"L198\" href=\"#L198\" tabindex=\"-1\">198</a>\n<a id=\"L199\" href=\"#L199\" tabindex=\"-1\">199</a>\n<a id=\"L200\" href=\"#L200\" tabindex=\"-1\">200</a>\n<a id=\"L201\" href=\"#L201\" tabindex=\"-1\">201</a>\n<a id=\"L202\" href=\"#L202\" tabindex=\"-1\">202</a>\n<a id=\"L203\" href=\"#L203\" tabindex=\"-1\">203</a>\n<a id=\"L204\" href=\"#L204\" tabindex=\"-1\">204</a>\n<a id=\"L205\" href=\"#L205\" tabindex=\"-1\">205</a>\n<a id=\"L206\" href=\"#L206\" tabindex=\"-1\">206</a>\n<a id=\"L207\" href=\"#L207\" tabindex=\"-1\">207</a>\n<a id=\"L208\" href=\"#L208\" tabindex=\"-1\">208</a>\n<a id=\"L209\" href=\"#L209\" tabindex=\"-1\">209</a>\n<a id=\"L210\" href=\"#L210\" tabindex=\"-1\">210</a>\n<a id=\"L211\" href=\"#L211\" tabindex=\"-1\">211</a>\n<a id=\"L212\" href=\"#L212\" tabindex=\"-1\">212</a>\n<a id=\"L213\" href=\"#L213\" tabindex=\"-1\">213</a>\n<a id=\"L214\" href=\"#L214\" tabindex=\"-1\">214</a>\n<a id=\"L215\" href=\"#L215\" tabindex=\"-1\">215</a>\n<a id=\"L216\" href=\"#L216\" tabindex=\"-1\">216</a>\n<a id=\"L217\" href=\"#L217\" tabindex=\"-1\">217</a>\n<a id=\"L218\" href=\"#L218\" tabindex=\"-1\">218</a>\n<a id=\"L219\" href=\"#L219\" tabindex=\"-1\">219</a>\n<a id=\"L220\" href=\"#L220\" tabindex=\"-1\">220</a>\n<a id=\"L221\" href=\"#L221\" tabindex=\"-1\">221</a>\n<a id=\"L222\" href=\"#L222\" tabindex=\"-1\">222</a>\n<a id=\"L223\" href=\"#L223\" tabindex=\"-1\">223</a>\n<a id=\"L224\" href=\"#L224\" tabindex=\"-1\">224</a>\n<a id=\"L225\" href=\"#L225\" tabindex=\"-1\">225</a>\n<a id=\"L226\" href=\"#L226\" tabindex=\"-1\">226</a>\n<a id=\"L227\" href=\"#L227\" tabindex=\"-1\">227</a>\n<a id=\"L228\" href=\"#L228\" tabindex=\"-1\">228</a>\n<a id=\"L229\" href=\"#L229\" tabindex=\"-1\">229</a>\n<a id=\"L230\" href=\"#L230\" tabindex=\"-1\">230</a>\n<a id=\"L231\" href=\"#L231\" tabindex=\"-1\">231</a>\n<a id=\"L232\" href=\"#L232\" tabindex=\"-1\">232</a>\n<a id=\"L233\" href=\"#L233\" tabindex=\"-1\">233</a>\n<a id=\"L234\" href=\"#L234\" tabindex=\"-1\">234</a>\n<a id=\"L235\" href=\"#L235\" tabindex=\"-1\">235</a>\n<a id=\"L236\" href=\"#L236\" tabindex=\"-1\">236</a>\n<a id=\"L237\" href=\"#L237\" tabindex=\"-1\">237</a>\n<a id=\"L238\" href=\"#L238\" tabindex=\"-1\">238</a>\n<a id=\"L239\" href=\"#L239\" tabindex=\"-1\">239</a>\n<a id=\"L240\" href=\"#L240\" tabindex=\"-1\">240</a>\n<a id=\"L241\" href=\"#L241\" tabindex=\"-1\">241</a>\n<a id=\"L242\" href=\"#L242\" tabindex=\"-1\">242</a>\n<a id=\"L243\" href=\"#L243\" tabindex=\"-1\">243</a>\n<a id=\"L244\" href=\"#L244\" tabindex=\"-1\">244</a>\n<a id=\"L245\" href=\"#L245\" tabindex=\"-1\">245</a>\n<a id=\"L246\" href=\"#L246\" tabindex=\"-1\">246</a>\n<a id=\"L247\" href=\"#L247\" tabindex=\"-1\">247</a>\n<a id=\"L248\" href=\"#L248\" tabindex=\"-1\">248</a>\n<a id=\"L249\" href=\"#L249\" tabindex=\"-1\">249</a>\n<a id=\"L250\" href=\"#L250\" tabindex=\"-1\">250</a>\n<a id=\"L251\" href=\"#L251\" tabindex=\"-1\">251</a>\n<a id=\"L252\" href=\"#L252\" tabindex=\"-1\">252</a>\n<a id=\"L253\" href=\"#L253\" tabindex=\"-1\">253</a>\n<a id=\"L254\" href=\"#L254\" tabindex=\"-1\">254</a>\n<a id=\"L255\" href=\"#L255\" tabindex=\"-1\">255</a>\n<a id=\"L256\" href=\"#L256\" tabindex=\"-1\">256</a>\n<a id=\"L257\" href=\"#L257\" tabindex=\"-1\">257</a>\n<a id=\"L258\" href=\"#L258\" tabindex=\"-1\">258</a>\n<a id=\"L259\" href=\"#L259\" tabindex=\"-1\">259</a>\n<a id=\"L260\" href=\"#L260\" tabindex=\"-1\">260</a>\n<a id=\"L261\" href=\"#L261\" tabindex=\"-1\">261</a>\n<a id=\"L262\" href=\"#L262\" tabindex=\"-1\">262</a>\n<a id=\"L263\" href=\"#L263\" tabindex=\"-1\">263</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n<span class=\"tok-kw\">const</span> mem = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>;\n<span class=\"tok-kw\">const</span> maxInt = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math.maxInt\">maxInt</a>;\n<span class=\"tok-kw\">const</span> OutputTooLongError = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/crypto/#std.crypto\">crypto</a>.<a href=\"/zig-docs/zh-cn/std/crypto/errors/#std.crypto.errors\">errors</a>.<a href=\"/zig-docs/zh-cn/std/crypto/errors/#std.crypto.errors.OutputTooLongError\">OutputTooLongError</a>;\n<span class=\"tok-kw\">const</span> WeakParametersError = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/crypto/#std.crypto\">crypto</a>.<a href=\"/zig-docs/zh-cn/std/crypto/errors/#std.crypto.errors\">errors</a>.<a href=\"/zig-docs/zh-cn/std/crypto/errors/#std.crypto.errors.WeakParametersError\">WeakParametersError</a>;<span class=\"tok-comment\">\n\n// RFC 2898 第 5.2 节\n//\n// 引自规范：\n//\n// PBKDF2 应用伪随机函数（示例见附录 B.1）\n// 派生密钥。派生密钥的长度基本上\n// 不受限制。（不过，派生密钥的最大有效搜索空间\n// 可能受底层伪随机函数的结构\n// 限制。进一步讨论见附录 B.1。）\n// 建议新应用使用 PBKDF2。\n//\n// PBKDF2 (P, S, c, dk_len)\n//\n// 选项：          PRF        底层伪随机函数，h_len\n//                            表示该伪随机函数输出的\n//                            字节数\n//\n// 输入：          P          密码，字节串\n//                 S          盐，字节串\n//                 c          迭代次数，正整数\n//                 dk_len      期望的派生密钥字节\n//                            长度，正整数，最大为\n//                            (2^32 - 1) * h_len\n//\n// 输出：          DK         派生密钥，长度为 dk_len 的字节串\n\n// 基于 Apple 的 CommonKeyDerivation，最初基于 Damien Bergamini 的代码。\n\n</span><span class=\"tok-comment\">/// 应用 PBKDF2 从密码生成密钥。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// PBKDF2 定义于 RFC 2898，并为 NIST SP 800-132 所推荐。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// dk：用于存放生成密钥、大小适当的切片，通常长 16 或 32 字节。</span>\n<span class=\"tok-comment\">///             可以未初始化；所有字节均会被覆写。</span>\n<span class=\"tok-comment\">///             最大大小为 `maxInt(u32) * Hash.digest_length`。</span>\n<span class=\"tok-comment\">///             传入长度超过此上限的缓冲区属于编程错误。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// password：任意长度的字节序列，可以为空。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// salt：任意长度的字节序列，可以为空。常见长度为 8 字节。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// rounds：迭代次数，必须大于 0。常见取值范围为 1,000 至 100,000。</span>\n<span class=\"tok-comment\">///         增大迭代次数会增加计算</span>\n<span class=\"tok-comment\">///         dk 所需的时间，从而提升安全性。通常调整此参数，使计算耗时约 100ms。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// Prf：使用的伪随机函数。常见选择为 `std.crypto.auth.hmac.sha2.HmacSha256`。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">pbkdf2</span>(dk: []<span class=\"tok-type\">u8</span>, password: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>, salt: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>, rounds: <span class=\"tok-type\">u32</span>, <span class=\"tok-kw\">comptime</span> Prf: <span class=\"tok-type\">type</span>) (<a href=\"/zig-docs/zh-cn/std/crypto/errors/#std.crypto.errors.WeakParametersError\">WeakParametersError</a> || <a href=\"/zig-docs/zh-cn/std/crypto/errors/#std.crypto.errors.OutputTooLongError\">OutputTooLongError</a>)!<span class=\"tok-type\">void</span> {\n    <span class=\"tok-kw\">if</span> (rounds &lt; <span class=\"tok-number\">1</span>) <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">error</span>.WeakParameters;\n\n    <span class=\"tok-kw\">const</span> dk_len = dk.len;\n    <span class=\"tok-kw\">const</span> h_len = Prf.mac_length;\n    <span class=\"tok-kw\">comptime</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/debug/#std.debug\">debug</a>.<a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\">assert</a>(h_len &gt;= <span class=\"tok-number\">1</span>);<span class=\"tok-comment\">\n\n    // 规范内容：\n    //\n    //   1. 若 dk_len &gt; maxInt(u32) * h_len，输出 \"derived key too long\"，并\n    //      停止。\n    //\n    </span><span class=\"tok-kw\">if</span> (dk_len / h_len &gt;= <a href=\"/zig-docs/zh-cn/std/math/#std.math.maxInt\">maxInt</a>(<span class=\"tok-type\">u32</span>)) {<span class=\"tok-comment\">\n        // 计数器从 1 开始且为 32 位，因此若必须返回更多块就会溢出\n        </span><span class=\"tok-kw\">return</span> <span class=\"tok-kw\">error</span>.OutputTooLong;\n    }<span class=\"tok-comment\">\n\n    // 摘自规范：\n    //\n    //   2. 令 l 为派生密钥中长度为 h_len 的字节块数量，\n    //      向上取整；令 r 为最后一个块\n    //      的字节数。\n    //\n\n    </span><span class=\"tok-kw\">const</span> blocks_count: <span class=\"tok-type\">u32</span> = <span class=\"tok-builtin\">@intCast</span>(<span class=\"tok-builtin\">@divCeil</span>(dk_len, h_len));\n    <span class=\"tok-kw\">var</span> r = dk_len % h_len;\n    <span class=\"tok-kw\">if</span> (r == <span class=\"tok-number\">0</span>) {\n        r = h_len;\n    }<span class=\"tok-comment\">\n\n    // 摘自规范：\n    //\n    //   3. 对派生密钥的每个块，将下述函数 F 应用于口令 P、盐 S、迭代次数 c 和块索引，计算该块：\n    //\n    //                T_1 = F (P, S, c, 1) ,\n    //                T_2 = F (P, S, c, 2) ,\n    //                ...\n    //                T_l = F (P, S, c, l) ,\n    //\n    //      函数 F 定义为底层伪随机函数 PRF 的前 c 次迭代结果的异或和。PRF 的输入为口令 P，以及盐 S 与块索引 i 的拼接：\n    //\n    //                F (P, S, c, i) = U_1 \\xor U_2 \\xor ... \\xor U_c\n    //\n    //  其中：\n    //\n    //            U_1 = PRF (P, S || INT (i)) ,\n    //            U_2 = PRF (P, U_1) ,\n    //            ...\n    //            U_c = PRF (P, U_{c-1}) .\n    //\n    //  INT (i) 是整数 i 的四字节编码，最高有效字节在前。\n    //\n    //  4. 拼接各个块，并取前 dk_len 个字节，得到派生密钥 DK：\n    //\n    //            DK = T_1 || T_2 ||  ...  || T_l&lt;0..r-1&gt;\n    //\n    //\n    //\n    //\n    //\n    //\n    //\n\n    </span><span class=\"tok-kw\">var</span> block: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">0</span>;\n    <span class=\"tok-kw\">while</span> (block &lt; blocks_count) : (block += <span class=\"tok-number\">1</span>) {\n        <span class=\"tok-kw\">var</span> prev_block: [h_len]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n        <span class=\"tok-kw\">var</span> new_block: [h_len]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;<span class=\"tok-comment\">\n\n        // U_1 = PRF (P, S || INT (i))\n        </span><span class=\"tok-kw\">const</span> block_index = <a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>.<a href=\"/zig-docs/zh-cn/std/mem/#std.mem.toBytes\">toBytes</a>(<a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>.<a href=\"/zig-docs/zh-cn/std/mem/#std.mem.nativeToBig\">nativeToBig</a>(<span class=\"tok-type\">u32</span>, block + <span class=\"tok-number\">1</span>));<span class=\"tok-comment\"> // 块索引从 0001 开始\n        </span><span class=\"tok-kw\">var</span> ctx = Prf.init(password);\n        ctx.update(salt);\n        ctx.update(block_index[<span class=\"tok-number\">0</span>..]);\n        ctx.final(prev_block[<span class=\"tok-number\">0</span>..]);<span class=\"tok-comment\">\n\n        // 选择 DK 中待写入的部分（T_n）并初始化。\n        </span><span class=\"tok-kw\">const</span> offset = block * h_len;\n        <span class=\"tok-kw\">const</span> block_len = <span class=\"tok-kw\">if</span> (block != blocks_count - <span class=\"tok-number\">1</span>) h_len <span class=\"tok-kw\">else</span> r;\n        <span class=\"tok-kw\">const</span> dk_block: []<span class=\"tok-type\">u8</span> = dk[offset..][<span class=\"tok-number\">0</span>..block_len];\n        <span class=\"tok-builtin\">@memcpy</span>(dk_block, prev_block[<span class=\"tok-number\">0</span>..dk_block.len]);\n\n        <span class=\"tok-kw\">var</span> i: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">1</span>;\n        <span class=\"tok-kw\">while</span> (i &lt; rounds) : (i += <span class=\"tok-number\">1</span>) {<span class=\"tok-comment\">\n            // U_c = PRF (P, U_{c-1})\n            </span>Prf.create(&amp;new_block, prev_block[<span class=\"tok-number\">0</span>..], password);\n            prev_block = new_block;<span class=\"tok-comment\">\n\n            // F (P, S, c, i) = U_1 \\xor U_2 \\xor ... \\xor U_c\n            </span><span class=\"tok-kw\">for</span> (dk_block, <span class=\"tok-number\">0</span>..) |_, j| {\n                dk_block[j] ^= new_block[j];\n            }\n        }\n    }\n}\n\n<span class=\"tok-kw\">const</span> htest = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"test.zig\"</span>);\n<span class=\"tok-kw\">const</span> HmacSha1 = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/crypto/#std.crypto\">crypto</a>.<a href=\"/zig-docs/zh-cn/std/crypto/#std.crypto.auth\">auth</a>.<a href=\"/zig-docs/zh-cn/std/crypto/hmac/#std.crypto.hmac\">hmac</a>.<a href=\"/zig-docs/zh-cn/std/crypto/hmac/#std.crypto.hmac.HmacSha1\">HmacSha1</a>;<span class=\"tok-comment\">\n\n// RFC 6070 PBKDF2 HMAC-SHA1 测试向量\n\n</span><span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"RFC 6070 one iteration\"</span> {\n    <span class=\"tok-kw\">const</span> p = <span class=\"tok-str\">\"password\"</span>;\n    <span class=\"tok-kw\">const</span> s = <span class=\"tok-str\">\"salt\"</span>;\n    <span class=\"tok-kw\">const</span> c = <span class=\"tok-number\">1</span>;\n    <span class=\"tok-kw\">const</span> dk_len = <span class=\"tok-number\">20</span>;\n\n    <span class=\"tok-kw\">var</span> dk: [dk_len]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.pbkdf2\">pbkdf2</a>(&amp;dk, p, s, c, <a href=\"/zig-docs/zh-cn/std/crypto/hmac/#std.crypto.hmac.HmacSha1\">HmacSha1</a>);\n\n    <span class=\"tok-kw\">const</span> expected = <span class=\"tok-str\">\"0c60c80f961f0e71f3a9b524af6012062fe037a6\"</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.htest\">htest</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.pbkdf2.htest.assertEqual\">assertEqual</a>(expected, dk[<span class=\"tok-number\">0</span>..]);\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"RFC 6070 two iterations\"</span> {\n    <span class=\"tok-kw\">const</span> p = <span class=\"tok-str\">\"password\"</span>;\n    <span class=\"tok-kw\">const</span> s = <span class=\"tok-str\">\"salt\"</span>;\n    <span class=\"tok-kw\">const</span> c = <span class=\"tok-number\">2</span>;\n    <span class=\"tok-kw\">const</span> dk_len = <span class=\"tok-number\">20</span>;\n\n    <span class=\"tok-kw\">var</span> dk: [dk_len]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.pbkdf2\">pbkdf2</a>(&amp;dk, p, s, c, <a href=\"/zig-docs/zh-cn/std/crypto/hmac/#std.crypto.hmac.HmacSha1\">HmacSha1</a>);\n\n    <span class=\"tok-kw\">const</span> expected = <span class=\"tok-str\">\"ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957\"</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.htest\">htest</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.pbkdf2.htest.assertEqual\">assertEqual</a>(expected, dk[<span class=\"tok-number\">0</span>..]);\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"RFC 6070 4096 iterations\"</span> {\n    <span class=\"tok-kw\">const</span> p = <span class=\"tok-str\">\"password\"</span>;\n    <span class=\"tok-kw\">const</span> s = <span class=\"tok-str\">\"salt\"</span>;\n    <span class=\"tok-kw\">const</span> c = <span class=\"tok-number\">4096</span>;\n    <span class=\"tok-kw\">const</span> dk_len = <span class=\"tok-number\">20</span>;\n\n    <span class=\"tok-kw\">var</span> dk: [dk_len]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.pbkdf2\">pbkdf2</a>(&amp;dk, p, s, c, <a href=\"/zig-docs/zh-cn/std/crypto/hmac/#std.crypto.hmac.HmacSha1\">HmacSha1</a>);\n\n    <span class=\"tok-kw\">const</span> expected = <span class=\"tok-str\">\"4b007901b765489abead49d926f721d065a429c1\"</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.htest\">htest</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.pbkdf2.htest.assertEqual\">assertEqual</a>(expected, dk[<span class=\"tok-number\">0</span>..]);\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"RFC 6070 16,777,216 iterations\"</span> {<span class=\"tok-comment\">\n    // 这些迭代测试较慢，因此始终跳过。结果已验证。\n    </span><span class=\"tok-kw\">if</span> (<span class=\"tok-null\">true</span>) {\n        <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">error</span>.SkipZigTest;\n    }\n\n    <span class=\"tok-kw\">const</span> p = <span class=\"tok-str\">\"password\"</span>;\n    <span class=\"tok-kw\">const</span> s = <span class=\"tok-str\">\"salt\"</span>;\n    <span class=\"tok-kw\">const</span> c = <span class=\"tok-number\">16777216</span>;\n    <span class=\"tok-kw\">const</span> dk_len = <span class=\"tok-number\">20</span>;\n\n    <span class=\"tok-kw\">var</span> dk: [dk_len]<span class=\"tok-type\">u8</span> = <span class=\"tok-builtin\">@splat</span>(<span class=\"tok-number\">0</span>);\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.pbkdf2\">pbkdf2</a>(&amp;dk, p, s, c, <a href=\"/zig-docs/zh-cn/std/crypto/hmac/#std.crypto.hmac.HmacSha1\">HmacSha1</a>);\n\n    <span class=\"tok-kw\">const</span> expected = <span class=\"tok-str\">\"eefe3d61cd4da4e4e9945b3d6ba2158c2634e984\"</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.htest\">htest</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.pbkdf2.htest.assertEqual\">assertEqual</a>(expected, dk[<span class=\"tok-number\">0</span>..]);\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"RFC 6070 multi-block salt and password\"</span> {\n    <span class=\"tok-kw\">const</span> p = <span class=\"tok-str\">\"passwordPASSWORDpassword\"</span>;\n    <span class=\"tok-kw\">const</span> s = <span class=\"tok-str\">\"saltSALTsaltSALTsaltSALTsaltSALTsalt\"</span>;\n    <span class=\"tok-kw\">const</span> c = <span class=\"tok-number\">4096</span>;\n    <span class=\"tok-kw\">const</span> dk_len = <span class=\"tok-number\">25</span>;\n\n    <span class=\"tok-kw\">var</span> dk: [dk_len]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.pbkdf2\">pbkdf2</a>(&amp;dk, p, s, c, <a href=\"/zig-docs/zh-cn/std/crypto/hmac/#std.crypto.hmac.HmacSha1\">HmacSha1</a>);\n\n    <span class=\"tok-kw\">const</span> expected = <span class=\"tok-str\">\"3d2eec4fe41c849b80c8d83662c0e44a8b291a964cf2f07038\"</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.htest\">htest</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.pbkdf2.htest.assertEqual\">assertEqual</a>(expected, dk[<span class=\"tok-number\">0</span>..]);\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"RFC 6070 embedded NUL\"</span> {\n    <span class=\"tok-kw\">const</span> p = <span class=\"tok-str\">\"pass\\x00word\"</span>;\n    <span class=\"tok-kw\">const</span> s = <span class=\"tok-str\">\"sa\\x00lt\"</span>;\n    <span class=\"tok-kw\">const</span> c = <span class=\"tok-number\">4096</span>;\n    <span class=\"tok-kw\">const</span> dk_len = <span class=\"tok-number\">16</span>;\n\n    <span class=\"tok-kw\">var</span> dk: [dk_len]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.pbkdf2\">pbkdf2</a>(&amp;dk, p, s, c, <a href=\"/zig-docs/zh-cn/std/crypto/hmac/#std.crypto.hmac.HmacSha1\">HmacSha1</a>);\n\n    <span class=\"tok-kw\">const</span> expected = <span class=\"tok-str\">\"56fa6aa75548099dcc37d7f03425e0c3\"</span>;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.htest\">htest</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.pbkdf2.htest.assertEqual\">assertEqual</a>(expected, dk[<span class=\"tok-number\">0</span>..]);\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"Very large dk_len\"</span> {<span class=\"tok-comment\">\n    // 此测试会分配 8GB 内存，预期需要数小时运行。\n    </span><span class=\"tok-kw\">if</span> (<span class=\"tok-null\">true</span>) {\n        <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">error</span>.SkipZigTest;\n    }\n    <span class=\"tok-kw\">const</span> p = <span class=\"tok-str\">\"password\"</span>;\n    <span class=\"tok-kw\">const</span> s = <span class=\"tok-str\">\"salt\"</span>;\n    <span class=\"tok-kw\">const</span> c = <span class=\"tok-number\">1</span>;\n    <span class=\"tok-kw\">const</span> dk_len = <span class=\"tok-number\">1</span> &lt;&lt; <span class=\"tok-number\">33</span>;\n\n    <span class=\"tok-kw\">const</span> dk = <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.allocator\">allocator</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.testing.allocator.alloc\">alloc</a>(<span class=\"tok-type\">u8</span>, dk_len);\n    <span class=\"tok-kw\">defer</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.allocator\">allocator</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.testing.allocator.free\">free</a>(dk);<span class=\"tok-comment\">\n\n    // 仅验证溢出时不会崩溃\n    </span><span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/crypto/pbkdf2/#std.crypto.pbkdf2.pbkdf2\">pbkdf2</a>(dk, p, s, c, <a href=\"/zig-docs/zh-cn/std/crypto/hmac/#std.crypto.hmac.HmacSha1\">HmacSha1</a>);\n}\n</code></pre></div></details>"}

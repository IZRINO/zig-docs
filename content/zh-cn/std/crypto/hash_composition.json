" tabindex=\"-1\">43</a>\n<a id=\"L44\" href=\"#L44\" tabindex=\"-1\">44</a>\n<a id=\"L45\" href=\"#L45\" tabindex=\"-1\">45</a>\n<a id=\"L46\" href=\"#L46\" tabindex=\"-1\">46</a>\n<a id=\"L47\" href=\"#L47\" tabindex=\"-1\">47</a>\n<a id=\"L48\" href=\"#L48\" tabindex=\"-1\">48</a>\n<a id=\"L49\" href=\"#L49\" tabindex=\"-1\">49</a>\n<a id=\"L50\" href=\"#L50\" tabindex=\"-1\">50</a>\n<a id=\"L51\" href=\"#L51\" tabindex=\"-1\">51</a>\n<a id=\"L52\" href=\"#L52\" tabindex=\"-1\">52</a>\n<a id=\"L53\" href=\"#L53\" tabindex=\"-1\">53</a>\n<a id=\"L54\" href=\"#L54\" tabindex=\"-1\">54</a>\n<a id=\"L55\" href=\"#L55\" tabindex=\"-1\">55</a>\n<a id=\"L56\" href=\"#L56\" tabindex=\"-1\">56</a>\n<a id=\"L57\" href=\"#L57\" tabindex=\"-1\">57</a>\n<a id=\"L58\" href=\"#L58\" tabindex=\"-1\">58</a>\n<a id=\"L59\" href=\"#L59\" tabindex=\"-1\">59</a>\n<a id=\"L60\" href=\"#L60\" tabindex=\"-1\">60</a>\n<a id=\"L61\" href=\"#L61\" tabindex=\"-1\">61</a>\n<a id=\"L62\" href=\"#L62\" tabindex=\"-1\">62</a>\n<a id=\"L63\" href=\"#L63\" tabindex=\"-1\">63</a>\n<a id=\"L64\" href=\"#L64\" tabindex=\"-1\">64</a>\n<a id=\"L65\" href=\"#L65\" tabindex=\"-1\">65</a>\n<a id=\"L66\" href=\"#L66\" tabindex=\"-1\">66</a>\n<a id=\"L67\" href=\"#L67\" tabindex=\"-1\">67</a>\n<a id=\"L68\" href=\"#L68\" tabindex=\"-1\">68</a>\n<a id=\"L69\" href=\"#L69\" tabindex=\"-1\">69</a>\n<a id=\"L70\" href=\"#L70\" tabindex=\"-1\">70</a>\n<a id=\"L71\" href=\"#L71\" tabindex=\"-1\">71</a>\n<a id=\"L72\" href=\"#L72\" tabindex=\"-1\">72</a>\n<a id=\"L73\" href=\"#L73\" tabindex=\"-1\">73</a>\n<a id=\"L74\" href=\"#L74\" tabindex=\"-1\">74</a>\n<a id=\"L75\" href=\"#L75\" tabindex=\"-1\">75</a>\n<a id=\"L76\" href=\"#L76\" tabindex=\"-1\">76</a>\n<a id=\"L77\" href=\"#L77\" tabindex=\"-1\">77</a>\n<a id=\"L78\" href=\"#L78\" tabindex=\"-1\">78</a>\n<a id=\"L79\" href=\"#L79\" tabindex=\"-1\">79</a>\n<a id=\"L80\" href=\"#L80\" tabindex=\"-1\">80</a>\n<a id=\"L81\" href=\"#L81\" tabindex=\"-1\">81</a>\n<a id=\"L82\" href=\"#L82\" tabindex=\"-1\">82</a>\n<a id=\"L83\" href=\"#L83\" tabindex=\"-1\">83</a>\n<a id=\"L84\" href=\"#L84\" tabindex=\"-1\">84</a>\n<a id=\"L85\" href=\"#L85\" tabindex=\"-1\">85</a>\n<a id=\"L86\" href=\"#L86\" tabindex=\"-1\">86</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../std.zig\"</span>);\n<span class=\"tok-kw\">const</span> sha2 = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/crypto/#std.crypto\">crypto</a>.<a href=\"/zig-docs/zh-cn/std/crypto/#std.crypto.hash\">hash</a>.<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2\">sha2</a>;\n\n<span class=\"tok-comment\">/// 两个哈希函数的复合 H1 o H2，其 API 与普通哈希函数相同。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 级联哈希的安全级别不会超过其中最弱函数的安全级别。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 不过，SHA-256 等 Merkle–Damgård 构造易受长度扩展攻击，</span>\n<span class=\"tok-comment\">/// 在某些条件下，无需知道 `x` 即可高效计算 `H(x||e)`。</span>\n<span class=\"tok-comment\">/// 复合两个哈希函数是抵御此类攻击的常见方式。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// SHA-3、BLAKE2、BLAKE3 等现代哈希函数无需如此处理。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">Composition</span>(<span class=\"tok-kw\">comptime</span> H1: <span class=\"tok-type\">type</span>, <span class=\"tok-kw\">comptime</span> H2: <span class=\"tok-type\">type</span>) <span class=\"tok-type\">type</span> {\n    <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">struct</span> {\n        <span class=\"tok-kw\">const</span> Self = <span class=\"tok-builtin\">@This</span>();\n\n        H1: H1,\n        H2: H2,\n\n        <span class=\"tok-comment\">/// 哈希输出的长度，单位为字节。</span>\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> digest_length = H1.digest_length;\n        <span class=\"tok-comment\">/// 块长度，单位为字节。</span>\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> block_length = H1.block_length;\n\n        <span class=\"tok-comment\">/// 两种哈希算法的选项。</span>\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Options = <span class=\"tok-kw\">struct</span> {\n            <span class=\"tok-comment\">/// H1 的选项。</span>\n            H1: H1.Options = .{},\n            <span class=\"tok-comment\">/// H2 的选项。</span>\n            H2: H2.Options = .{},\n        };\n\n        <span class=\"tok-comment\">/// 使用指定选项初始化哈希组合。</span>\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">init</span>(options: <a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition.Options\">Options</a>) <a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition\">Self</a> {\n            <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition\">Self</a>{ .H1 = H1.init(options.H1), .H2 = H2.init(options.H2) };\n        }\n\n        <span class=\"tok-comment\">/// 计算 H1(H2(b))。</span>\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">hash</span>(b: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>, out: *[<a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition.digest_length\">digest_length</a>]<span class=\"tok-type\">u8</span>, options: <a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition.Options\">Options</a>) <span class=\"tok-type\">void</span> {\n            <span class=\"tok-kw\">var</span> d = <a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition\">Self</a>.<a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition.init\">init</a>(options);\n            d.update(b);\n            d.final(out);\n        }\n\n        <span class=\"tok-comment\">/// 向哈希添加内容。</span>\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">update</span>(d: *<a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition\">Self</a>, b: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">void</span> {\n            d.H2.update(b);\n        }\n\n        <span class=\"tok-comment\">/// 计算累积内容的最终哈希：H1(H2(b))。</span>\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">final</span>(d: *<a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition\">Self</a>, out: *[<a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition.digest_length\">digest_length</a>]<span class=\"tok-type\">u8</span>) <span class=\"tok-type\">void</span> {\n            <span class=\"tok-kw\">var</span> H2_digest: [H2.digest_length]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n            d.H2.final(&amp;H2_digest);\n            d.H1.update(&amp;H2_digest);\n            d.H1.final(out);\n        }\n\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">finalResult</span>(d: *<a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition\">Self</a>) [<a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition.digest_length\">digest_length</a>]<span class=\"tok-type\">u8</span> {\n            <span class=\"tok-kw\">var</span> result: [<a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition.digest_length\">digest_length</a>]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n            d.final(&amp;result);\n            <span class=\"tok-kw\">return</span> result;\n        }\n    };\n}\n\n<span class=\"tok-comment\">/// SHA-256(SHA-256())</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Sha256oSha256 = <a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition\">Composition</a>(<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2\">sha2</a>.<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2.Sha256\">Sha256</a>, <a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2\">sha2</a>.<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2.Sha256\">Sha256</a>);\n<span class=\"tok-comment\">/// SHA-384(SHA-384())</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Sha384oSha384 = <a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition\">Composition</a>(<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2\">sha2</a>.<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2.Sha384\">Sha384</a>, <a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2\">sha2</a>.<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2.Sha384\">Sha384</a>);\n<span class=\"tok-comment\">/// SHA-512(SHA-512())</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Sha512oSha512 = <a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Composition\">Composition</a>(<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2\">sha2</a>.<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2.Sha512\">Sha512</a>, <a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2\">sha2</a>.<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2.Sha512\">Sha512</a>);\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"Hash composition\"</span> {\n    <span class=\"tok-kw\">const</span> Sha256 = <a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2\">sha2</a>.<a href=\"/zig-docs/zh-cn/std/crypto/sha2/#std.crypto.sha2.Sha256\">Sha256</a>;\n    <span class=\"tok-kw\">const</span> msg = <span class=\"tok-str\">\"test\"</span>;\n\n    <span class=\"tok-kw\">var</span> out: [<a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Sha256oSha256\">Sha256oSha256</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.hash_composition.Sha256oSha256.digest_length\">digest_length</a>]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n    <a href=\"/zig-docs/zh-cn/std/crypto/hash_composition/#std.crypto.hash_composition.Sha256oSha256\">Sha256oSha256</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.hash_composition.Sha256oSha256.hash\">hash</a>(msg, &amp;out, .{});\n\n    <span class=\"tok-kw\">var</span> t: [Sha256.digest_length]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n    Sha256.hash(msg, &amp;t, .{});\n    <span class=\"tok-kw\">var</span> out2: [Sha256.digest_length]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n    Sha256.hash(&amp;t, &amp;out2, .{});\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expectEqualSlices\">expectEqualSlices</a>(<span class=\"tok-type\">u8</span>, &amp;out, &amp;out2);\n}\n</code></pre></div></details>"}

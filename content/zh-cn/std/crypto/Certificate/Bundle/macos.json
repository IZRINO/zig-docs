.Certificate.Bundle.macos.rescanMac","anchor":"std.crypto.Certificate.Bundle.macos.rescanMac","category":"function","sourceLine":11},{"id":"std/crypto/Certificate/Bundle/macos.zig:9:8235","name":"std.crypto.Certificate.Bundle.macos.RescanMacError","anchor":"std.crypto.Certificate.Bundle.macos.RescanMacError","category":"error-set","sourceLine":9},{"id":"std/crypto/Certificate/Bundle/macos.zig:37:8237","name":"std.crypto.Certificate.Bundle.macos.scanReader","anchor":"std.crypto.Certificate.Bundle.macos.scanReader","category":"function","sourceLine":37},{"id":"std/crypto/Certificate/Bundle/macos.zig:1:8228","name":"std.crypto.Certificate.Bundle.macos.std","anchor":"std.crypto.Certificate.Bundle.macos.std","category":"alias","sourceLine":1},{"id":"std/crypto/Certificate/Bundle/macos.zig:103:8240","name":"std.crypto.Certificate.Bundle.macos.TableHeader","anchor":"std.crypto.Certificate.Bundle.macos.TableHeader","category":"container","sourceLine":103},{"id":"std/crypto/Certificate/Bundle/macos.zig:113:8241","name":"std.crypto.Certificate.Bundle.macos.X509CertHeader","anchor":"std.crypto.Certificate.Bundle.macos.X509CertHeader","category":"container","sourceLine":113}],"html":"<div id=\"std.crypto.Certificate.Bundle.macos\"></div>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L1\">源码行 1</a></p>\n<div class=\"api-members\"><ul>\n<li><a href=\"/zig-docs/zh-cn/std/#std\"><code>std</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/#std.Io\"><code>Io</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\"><code>assert</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/fs/#std.fs\"><code>fs</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/mem/#std.mem\"><code>mem</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/mem/Allocator/#std.mem.Allocator\"><code>Allocator</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/crypto/Certificate/Bundle/#std.crypto.Certificate.Bundle\"><code>Bundle</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/
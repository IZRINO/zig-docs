60</a>\n<a id=\"L161\" href=\"#L161\" tabindex=\"-1\">161</a>\n<a id=\"L162\" href=\"#L162\" tabindex=\"-1\">162</a>\n<a id=\"L163\" href=\"#L163\" tabindex=\"-1\">163</a>\n<a id=\"L164\" href=\"#L164\" tabindex=\"-1\">164</a>\n<a id=\"L165\" href=\"#L165\" tabindex=\"-1\">165</a>\n<a id=\"L166\" href=\"#L166\" tabindex=\"-1\">166</a>\n<a id=\"L167\" href=\"#L167\" tabindex=\"-1\">167</a>\n<a id=\"L168\" href=\"#L168\" tabindex=\"-1\">168</a>\n<a id=\"L169\" href=\"#L169\" tabindex=\"-1\">169</a>\n<a id=\"L170\" href=\"#L170\" tabindex=\"-1\">170</a>\n<a id=\"L171\" href=\"#L171\" tabindex=\"-1\">171</a>\n<a id=\"L172\" href=\"#L172\" tabindex=\"-1\">172</a>\n<a id=\"L173\" href=\"#L173\" tabindex=\"-1\">173</a>\n<a id=\"L174\" href=\"#L174\" tabindex=\"-1\">174</a>\n<a id=\"L175\" href=\"#L175\" tabindex=\"-1\">175</a>\n<a id=\"L176\" href=\"#L176\" tabindex=\"-1\">176</a>\n<a id=\"L177\" href=\"#L177\" tabindex=\"-1\">177</a>\n<a id=\"L178\" href=\"#L178\" tabindex=\"-1\">178</a>\n<a id=\"L179\" href=\"#L179\" tabindex=\"-1\">179</a>\n<a id=\"L180\" href=\"#L180\" tabindex=\"-1\">180</a>\n<a id=\"L181\" href=\"#L181\" tabindex=\"-1\">181</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">//! 在 N 次分配后失败的分配器，可用于确认</span>\n<span class=\"tok-comment\">//! 内存不足的情况是否得到正确处理。</span>\n<span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../std.zig\"</span>);\n<span class=\"tok-kw\">const</span> mem = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>;\n<span class=\"tok-kw\">const</span> FailingAllocator = <span class=\"tok-builtin\">@This</span>();\n\nalloc_index: <span class=\"tok-type\">usize</span>,\nresize_index: <span class=\"tok-type\">usize</span>,\ninternal_allocator: <a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>.<a href=\"/zig-docs/zh-cn/std/mem/Allocator/#std.mem.Allocator\">Allocator</a>,\nallocated_bytes: <span class=\"tok-type\">usize</span>,\nfreed_bytes: <span class=\"tok-type\">usize</span>,\nallocations: <span class=\"tok-type\">usize</span>,\ndeallocations: <span class=\"tok-type\">usize</span>,\nstack_addresses: [<a href=\"/zig-docs/zh-cn/std/testing/FailingAllocator/#std.testing.FailingAllocator.num_stack_frames\">num_stack_frames</a>]<span class=\"tok-type\">usize</span>,\nhas_induced_failure: <span class=\"tok-type\">bool</span>,\nfail_index: <span class=\"tok-type\">usize</span>,\nresize_fail_index: <span class=\"tok-type\">usize</span>,\n\n<span class=\"tok-kw\">const</span> num_stack_frames = <span class=\"tok-kw\">if</span> (<a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/debug/#std.debug\">debug</a>.<a href=\"/zig-docs/zh-cn/std/debug/#std.debug.sys_can_stack_trace\">sys_can_stack_trace</a>) <span class=\"tok-number\">16</span> <span class=\"tok-kw\">else</span> <span class=\"tok-number\">0</span>;\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Config = <span class=\"tok-kw\">struct</span> {\n    <span class=\"tok-comment\">/// 此分配器预期可成功执行的分配次数。</span>\n    <span class=\"tok-comment\">/// 再下一次分配将失败。</span>\n    fail_index: <span class=\"tok-type\">usize</span> = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math.maxInt\">maxInt</a>(<span class=\"tok-type\">usize</span>),\n\n    <span class=\"tok-comment\">/// 此分配器预期成功调整大小的次数。下一次调整将失败。</span>\n    resize_fail_index: <span class=\"tok-type\">usize</span> = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math.maxInt\">maxInt</a>(<span class=\"tok-type\">usize</span>),\n};\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">init</span>(internal_allocator: <a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>.<a href=\"/zig-docs/zh-cn/std/mem/Allo
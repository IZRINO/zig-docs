L154\" tabindex=\"-1\">154</a>\n<a id=\"L155\" href=\"#L155\" tabindex=\"-1\">155</a>\n<a id=\"L156\" href=\"#L156\" tabindex=\"-1\">156</a>\n<a id=\"L157\" href=\"#L157\" tabindex=\"-1\">157</a>\n<a id=\"L158\" href=\"#L158\" tabindex=\"-1\">158</a>\n<a id=\"L159\" href=\"#L159\" tabindex=\"-1\">159</a>\n<a id=\"L160\" href=\"#L160\" tabindex=\"-1\">160</a>\n<a id=\"L161\" href=\"#L161\" tabindex=\"-1\">161</a>\n<a id=\"L162\" href=\"#L162\" tabindex=\"-1\">162</a>\n<a id=\"L163\" href=\"#L163\" tabindex=\"-1\">163</a>\n<a id=\"L164\" href=\"#L164\" tabindex=\"-1\">164</a>\n<a id=\"L165\" href=\"#L165\" tabindex=\"-1\">165</a>\n<a id=\"L166\" href=\"#L166\" tabindex=\"-1\">166</a>\n<a id=\"L167\" href=\"#L167\" tabindex=\"-1\">167</a>\n<a id=\"L168\" href=\"#L168\" tabindex=\"-1\">168</a>\n<a id=\"L169\" href=\"#L169\" tabindex=\"-1\">169</a>\n<a id=\"L170\" href=\"#L170\" tabindex=\"-1\">170</a>\n<a id=\"L171\" href=\"#L171\" tabindex=\"-1\">171</a>\n<a id=\"L172\" href=\"#L172\" tabindex=\"-1\">172</a>\n<a id=\"L173\" href=\"#L173\" tabindex=\"-1\">173</a>\n<a id=\"L174\" href=\"#L174\" tabindex=\"-1\">174</a>\n<a id=\"L175\" href=\"#L175\" tabindex=\"-1\">175</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../../../std.zig\"</span>);\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> magic = <span class=\"tok-number\">0xeb9f</span>;\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> version = <span class=\"tok-number\">1</span>;\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> ext = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"btf_ext.zig\"</span>);\n\n<span class=\"tok-comment\">/// 所有偏移均以字节为单位，相对于此头部末尾</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Header = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    magic: <span class=\"tok-type\">u16</span>,\n    version: <span class=\"tok-type\">u8</span>,\n    flags: <span class=\"tok-type\">u8</span>,\n    hdr_len: <span class=\"tok-type\">u32</span>,\n\n    <span class=\"tok-comment\">/// 类型节的偏移量</span>\n    type_off: <span class=\"tok-type\">u32</span>,\n\n    <span class=\"tok-comment\">/// 类型节的长度</span>\n    type_len: <span class=\"tok-type\">u32</span>,\n\n    <span class=\"tok-comment\">/// 字符串节的偏移量</span>\n    str_off: <span class=\"tok-type\">u32</span>,\n\n    <span class=\"tok-comment\">/// 字符串节的长度</span>\n    str_len: <span class=\"tok-type\">u32</span>,\n};\n\n<span class=\"tok-comment\">/// 类型标识符的最大数量</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> max_type = <span class=\"tok-number\">0xfffff</span>;\n\n<span class=\"tok-comment\">/// 字符串节内的最大偏移量</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> max_name_offset = <span class=\"tok-number\">0xffffff</span>;\n\n<span class=\"tok-comment\">/// 函数参数中结构体、联合体或枚举成员的最大数量。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> max_vlen = <span class=\"tok-number\">0xffff</span>;\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Type = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    name_off: <span class=\"tok-type\">u32</span>,\n    info: <span class=\"tok-kw\">packed</span> <span class=\"tok-kw\">struct</span>(<span class=\"tok-type\">u32</span>) {\n        <span class=\"tok-comment\">/// 结构体成员数量</span>\n        vlen: <span class=\"tok-type\">u16</span>,\n\n        unused_1: <span class=\"tok-type\">u8</span>,\n        kind: <a href=\"/zig-docs/zh-cn/std/os/linux/bpf/btf/#std.os.linux.bpf.btf.Kind\">Kind</a>,\n        unused_2: <span class=\"tok-type\">u2</span>,\n\n        <span class=\"tok-comment\">/// 由 Struct、Union 和 Fwd 使用</span>\n        kind_flag: <span class=\"tok-type\">bool</span>,\n    },\n\n    <span class=\"tok-comment\">/// Int、Enum、Struct、Union 和 DataSec 使用 size 字段，它表示</span>\n    <span class=\"tok-comment\">/// 所描述类型的大小。</span>\n    <span class=\"tok-comment\">///</span>\n    <span class=\"tok-comment\">/// Ptr、Typedef、Volatile、Const、Restrict、Func、</span>\n    <span class=\"tok-comment\">/// FuncProto 和 Var 使用 type 字段；它是引用另一类型的 type_id。</span>\n    size_type: <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">union</span> { size: <span class=\"tok-type\">u32</span>, typ: <span class=\"tok-type\">u32</span> },\n};\n\n<span class=\"tok-comment\">/// 某些类别中，Type 后紧跟额外数据。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Kind = <span class=\"tok-kw\">enum</span>(<span class=\"tok-type\">u5</span>) {\n    unknown,\n    int,\n    ptr,\n    array,\n    @\"struct\",\n    @\"union\",\n    @\"enum\",\n    fwd,\n    typedef,\n    @\"volatile\",\n    @\"const\",\n    restrict,\n    func,\n    func_proto,\n    @\"var\",\n    datasec,\n    float,\n    decl_tag,\n    type_tag,\n    enum64,\n};\n\n<span class=\"tok-comment\">/// int 种类后面跟随此结构体</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> IntInfo = <span class=\"tok-kw\">packed</span> <span class=\"tok-kw\">struct</span>(<span class=\"tok-type\">u32</span>) {\n    bits: <span class=\"tok-type\">u8</span>,\n    reserved_1: <span class=\"tok-type\">u8</span>,\n    offset: <span class=\"tok-type\">u8</span>,\n    encoding: <span class=\"tok-kw\">enum</span>(<span class=\"tok-type\">u4</span>) {\n        signed = <span class=\"tok-number\">1</span> &lt;&lt; <span class=\"tok-number\">0</span>,\n        char = <span class=\"tok-number\">1</span> &lt;&lt; <span class=\"tok-number\">1</span>,\n        boolean = <span class=\"tok-number\">1</span> &lt;&lt; <span class=\"tok-number\">2</span>,\n    },\n    reserved_2: <span class=\"tok-type\">u4</span>,\n};\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"IntInfo is 32 bits\"</span> {\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expectEqual\">expectEqual</a>(<span class=\"tok-builtin\">@bitSizeOf</span>(<a href=\"/zig-docs/zh-cn/std/os/linux/bpf/btf/#std.os.linux.bpf.btf.IntInfo\">IntInfo</a>), <span class=\"tok-number\">32</span>);\n}\n\n<span class=\"tok-comment\">/// enum 种类后面跟随此结构体</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Enum = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    name_off: <span class=\"tok-type\">u32</span>,\n    val: <span class=\"tok-type\">i32</span>,\n};\n\n<span class=\"tok-comment\">/// enum64 种类后面跟随此结构体</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Enum64 = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    name_off: <span class=\"tok-type\">u32</span>,\n    val_lo32: <span class=\"tok-type\">i32</span>,\n    val_hi32: <span class=\"tok-type\">i32</span>,\n};\n\n<span class=\"tok-comment\">/// array 种类后面跟随此结构体</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Array = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    typ: <span class=\"tok-type\">u32</span>,\n    index_type: <span class=\"tok-type\">u32</span>,\n    nelems: <span class=\"tok-type\">u32</span>,\n};\n\n<span class=\"tok-comment\">/// struct 和 union 种类之后跟随多个 Member 结构体；</span>\n<span class=\"tok-comment\">/// 确切数量存储在 vlen 中。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Member = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    name_off: <span class=\"tok-type\">u32</span>,\n    typ: <span class=\"tok-type\">u32</span>,\n\n    <span class=\"tok-comment\">/// 若设置 kind_flag，则 offset 同时包含成员位域大小及</span>\n    <span class=\"tok-comment\">/// 位偏移；位域成员会设置位域大小。若类型信息中的</span>\n    <span class=\"tok-comment\">/// kind_flag 未设置，则 offset 仅包含位偏移。</span>\n    offset: <span class=\"tok-kw\">packed</span> <span class=\"tok-kw\">struct</span>(<span class=\"tok-type\">u32</span>) {\n        bit: <span class=\"tok-type\">u24</span>,\n        bitfield_size: <span class=\"tok-type\">u8</span>,\n    },\n};\n\n<span class=\"tok-comment\">/// func_proto 后跟多个 Param，确切数量存储于 vlen</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Param = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    name_off: <span class=\"tok-type\">u32</span>,\n    typ: <span class=\"tok-type\">u32</span>,\n};\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> VarLinkage = <span class=\"tok-kw\">enum</span> {\n    static,\n    global_allocated,\n    global_extern,\n};\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> FuncLinkage = <span class=\"tok-kw\">enum</span> {\n    static,\n    global,\n    external,\n};\n\n<span class=\"tok-comment\">/// var 种类后跟单个 Var 结构体，描述与变量相关的</span>\n<span class=\"tok-comment\">/// 额外信息，例如链接属性。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Var = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    linkage: <span class=\"tok-type\">u32</span>,\n};\n\n<span class=\"tok-comment\">/// datasec 类型之后跟随多个 VarSecInfo，用于描述其包含的所有 Var 类型，以及各自的节内偏移和大小。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> VarSecInfo = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    typ: <span class=\"tok-type\">u32</span>,\n    offset: <span class=\"tok-type\">u32</span>,\n    size: <span class=\"tok-type\">u32</span>,\n};<span class=\"tok-comment\">\n\n// decl_tag 种类后跟单个 DeclTag 结构体，用于描述\n// 标签应用位置的附加信息。\n// 如果 component_idx == -1，则标签应用于结构体、联合体、\n// 变量或函数。否则，应用于结构体／联合体\n// 成员或函数参数，component_idx 表示哪个成员\n// 或参数，范围为 0 ... vlen-1。\n</span><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> DeclTag = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    component_idx: <span class=\"tok-type\">u32</span>,\n};\n</code></pre></div></details>"}

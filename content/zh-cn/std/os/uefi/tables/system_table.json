6\" href=\"#L26\" tabindex=\"-1\">26</a>\n<a id=\"L27\" href=\"#L27\" tabindex=\"-1\">27</a>\n<a id=\"L28\" href=\"#L28\" tabindex=\"-1\">28</a>\n<a id=\"L29\" href=\"#L29\" tabindex=\"-1\">29</a>\n<a id=\"L30\" href=\"#L30\" tabindex=\"-1\">30</a>\n<a id=\"L31\" href=\"#L31\" tabindex=\"-1\">31</a>\n<a id=\"L32\" href=\"#L32\" tabindex=\"-1\">32</a>\n<a id=\"L33\" href=\"#L33\" tabindex=\"-1\">33</a>\n<a id=\"L34\" href=\"#L34\" tabindex=\"-1\">34</a>\n<a id=\"L35\" href=\"#L35\" tabindex=\"-1\">35</a>\n<a id=\"L36\" href=\"#L36\" tabindex=\"-1\">36</a>\n<a id=\"L37\" href=\"#L37\" tabindex=\"-1\">37</a>\n<a id=\"L38\" href=\"#L38\" tabindex=\"-1\">38</a>\n<a id=\"L39\" href=\"#L39\" tabindex=\"-1\">39</a>\n<a id=\"L40\" href=\"#L40\" tabindex=\"-1\">40</a>\n<a id=\"L41\" href=\"#L41\" tabindex=\"-1\">41</a>\n<a id=\"L42\" href=\"#L42\" tabindex=\"-1\">42</a>\n<a id=\"L43\" href=\"#L43\" tabindex=\"-1\">43</a>\n<a id=\"L44\" href=\"#L44\" tabindex=\"-1\">44</a>\n<a id=\"L45\" href=\"#L45\" tabindex=\"-1\">45</a>\n<a id=\"L46\" href=\"#L46\" tabindex=\"-1\">46</a>\n<a id=\"L47\" href=\"#L47\" tabindex=\"-1\">47</a>\n<a id=\"L48\" href=\"#L48\" tabindex=\"-1\">48</a>\n<a id=\"L49\" href=\"#L49\" tabindex=\"-1\">49</a>\n<a id=\"L50\" href=\"#L50\" tabindex=\"-1\">50</a>\n<a id=\"L51\" href=\"#L51\" tabindex=\"-1\">51</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> uefi = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>).os.uefi;\n<span class=\"tok-kw\">const</span> BootServices = <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/tables/#std.os.uefi.tables\">tables</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/tables/boot_services/#std.os.uefi.tables.boot_services.BootServices\">BootServices</a>;\n<span class=\"tok-kw\">const</span> ConfigurationTable = <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/tables/#std.os.uefi.tables\">tables</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/tables/configuration_table/#std.os.uefi.tables.configuration_table.ConfigurationTable\">ConfigurationTable</a>;\n<span class=\"tok-kw\">const</span> Handle = <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi.Handle\">Handle</a>;\n<span class=\"tok-kw\">const</span> RuntimeServices = <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/tables/#std.os.uefi.tables\">tables</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/tables/runtime_services/#std.os.uefi.tables.runtime_services.RuntimeServices\">RuntimeServices</a>;\n<span class=\"tok-kw\">const</span> SimpleTextInputProtocol = <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/protocol/#std.os.uefi.protocol\">protocol</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/protocol/simple_text_input/#std.os.uefi.protocol.simple_text_input.SimpleTextInput\">SimpleTextInput</a>;\n<span class=\"tok-kw\">const</span> SimpleTextOutputProtocol = <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/protocol/#std.os.uefi.protocol\">protocol</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/protocol/simple_text_output/#std.os.uefi.protocol.simple_text_output.SimpleTextOutput\">SimpleTextOutput</a>;\n<span class=\"tok-kw\">const</span> TableHeader = <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/tables/#std.os.uefi.tables\">tables</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/tables/table_header/#std.os.uefi.tables.table_header.TableHeader\">TableHeader</a>;\n\n<span class=\"tok-comment\">/// EFI 系统表包含指向运行时服务表和引导服务表的指针。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// system_table 可能随 UEFI 新版本扩展，因此务必检查 hdr.header_size。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">//
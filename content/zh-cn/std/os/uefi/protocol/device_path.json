n<a id=\"L57\" href=\"#L57\" tabindex=\"-1\">57</a>\n<a id=\"L58\" href=\"#L58\" tabindex=\"-1\">58</a>\n<a id=\"L59\" href=\"#L59\" tabindex=\"-1\">59</a>\n<a id=\"L60\" href=\"#L60\" tabindex=\"-1\">60</a>\n<a id=\"L61\" href=\"#L61\" tabindex=\"-1\">61</a>\n<a id=\"L62\" href=\"#L62\" tabindex=\"-1\">62</a>\n<a id=\"L63\" href=\"#L63\" tabindex=\"-1\">63</a>\n<a id=\"L64\" href=\"#L64\" tabindex=\"-1\">64</a>\n<a id=\"L65\" href=\"#L65\" tabindex=\"-1\">65</a>\n<a id=\"L66\" href=\"#L66\" tabindex=\"-1\">66</a>\n<a id=\"L67\" href=\"#L67\" tabindex=\"-1\">67</a>\n<a id=\"L68\" href=\"#L68\" tabindex=\"-1\">68</a>\n<a id=\"L69\" href=\"#L69\" tabindex=\"-1\">69</a>\n<a id=\"L70\" href=\"#L70\" tabindex=\"-1\">70</a>\n<a id=\"L71\" href=\"#L71\" tabindex=\"-1\">71</a>\n<a id=\"L72\" href=\"#L72\" tabindex=\"-1\">72</a>\n<a id=\"L73\" href=\"#L73\" tabindex=\"-1\">73</a>\n<a id=\"L74\" href=\"#L74\" tabindex=\"-1\">74</a>\n<a id=\"L75\" href=\"#L75\" tabindex=\"-1\">75</a>\n<a id=\"L76\" href=\"#L76\" tabindex=\"-1\">76</a>\n<a id=\"L77\" href=\"#L77\" tabindex=\"-1\">77</a>\n<a id=\"L78\" href=\"#L78\" tabindex=\"-1\">78</a>\n<a id=\"L79\" href=\"#L79\" tabindex=\"-1\">79</a>\n<a id=\"L80\" href=\"#L80\" tabindex=\"-1\">80</a>\n<a id=\"L81\" href=\"#L81\" tabindex=\"-1\">81</a>\n<a id=\"L82\" href=\"#L82\" tabindex=\"-1\">82</a>\n<a id=\"L83\" href=\"#L83\" tabindex=\"-1\">83</a>\n<a id=\"L84\" href=\"#L84\" tabindex=\"-1\">84</a>\n<a id=\"L85\" href=\"#L85\" tabindex=\"-1\">85</a>\n<a id=\"L86\" href=\"#L86\" tabindex=\"-1\">86</a>\n<a id=\"L87\" href=\"#L87\" tabindex=\"-1\">87</a>\n<a id=\"L88\" href=\"#L88\" tabindex=\"-1\">88</a>\n<a id=\"L89\" href=\"#L89\" tabindex=\"-1\">89</a>\n<a id=\"L90\" href=\"#L90\" tabindex=\"-1\">90</a>\n<a id=\"L91\" href=\"#L91\" tabindex=\"-1\">91</a>\n<a id=\"L92\" href=\"#L92\" tabindex=\"-1\">92</a>\n<a id=\"L93\" href=\"#L93\" tabindex=\"-1\">93</a>\n<a id=\"L94\" href=\"#L94\" tabindex=\"-1\">94</a>\n<a id=\"L95\" href=\"#L95\" tabindex=\"-1\">95</a>\n<a id=\"L96\" href=\"#L96\" tabindex=\"-1\">96</a>\n<a id=\"L97\" href=\"#L97\" tabindex=\"-1\">97</a>\n<a id=\"L98\" href=\"#L98\" tabindex=\"-1\">98</a>\n<a id=\"L99\" href=\"#L99\" tabindex=\"-1\">99</a>\n<a id=\"L100\" href=\"#L100\" tabindex=\"-1\">100</a>\n<a id=\"L101\" href=\"#L101\" tabindex=\"-1\">101</a>\n<a id=\"L102\" href=\"#L102\" tabindex=\"-1\">102</a>\n<a id=\"L103\" href=\"#L103\" tabindex=\"-1\">103</a>\n<a id=\"L104\" href=\"#L104\" tabindex=\"-1\">104</a>\n<a id=\"L105\" href=\"#L105\" tabindex=\"-1\">105</a>\n<a id=\"L106\" href=\"#L106\" tabindex=\"-1\">106</a>\n<a id=\"L107\" href=\"#L107\" tabindex=\"-1\">107</a>\n<a id=\"L108\" href=\"#L108\" tabindex=\"-1\">108</a>\n<a id=\"L109\" href=\"#L109\" tabindex=\"-1\">109</a>\n<a id=\"L110\" href=\"#L110\" tabindex=\"-1\">110</a>\n<a id=\"L111\" href=\"#L111\" tabindex=\"-1\">111</a>\n<a id=\"L112\" href=\"#L112\" tabindex=\"-1\">112</a>\n<a id=\"L113\" href=\"#L113\" tabindex=\"-1\">113</a>\n<a id=\"L114\" href=\"#L114\" tabindex=\"-1\">114</a>\n<a id=\"L115\" href=\"#L115\" tabindex=\"-1\">115</a>\n<a id=\"L116\" href=\"#L116\" tabindex=\"-1\">116</a>\n<a id=\"L117\" href=\"#L117\" tabindex=\"-1\">117</a>\n<a id=\"L118\" href=\"#L118\" tabindex=\"-1\">118</a>\n<a id=\"L119\" href=\"#L119\" tabindex=\"-1\">119</a>\n<a id=\"L120\" href=\"#L120\" tabindex=\"-1\">120</a>\n<a id=\"L121\" href=\"#L121\" tabindex=\"-1\">121</a>\n<a id=\"L122\" href=\"#L122\" tabindex=\"-1\">122</a>\n<a id=\"L123\" href=\"#L123\" tabindex=\"-1\">123</a>\n<a id=\"L124\" href=\"#L124\" tabindex=\"-1\">124</a>\n<a id=\"L125\" href=\"#L125\" tabindex=\"-1\">125</a>\n<a id=\"L126\" href=\"#L126\" tabindex=\"-1\">126</a>\n<a id=\"L127\" href=\"#L127\" tabindex=\"-1\">127</a>\n<a id=\"L128\" href=\"#L128\" tabindex=\"-1\">128</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../../../std.zig\"</span>);\n<span class=\"tok-kw\">const</span> mem = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>;\n<span class=\"tok-kw\">const</span> uefi = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/os/#std.os\">os</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>;\n<span class=\"tok-kw\">const</span> Allocator = <a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>.<a href=\"/zig-docs/zh-cn/std/mem/Allocator/#std.mem.Allocator\">Allocator</a>;\n<span class=\"tok-kw\">const</span> Guid = <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi.Guid\">Guid</a>;\n<span class=\"tok-kw\">const</span> assert = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/debug/#std.debug\">debug</a>.<a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\">assert</a>;<span class=\"tok-comment\">\n\n// 所有设备路径节点均按字节紧凑排列，可出现在任意字节边界。\n// 所有引用设备路径节点的代码都必须假定其全部字段未对齐。\n\n</span><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> DevicePath = <span class=\"tok-kw\">extern</span> <span class=\"tok-kw\">struct</span> {\n    <span class=\"tok-type\">type</span>: <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath\">DevicePath</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.Type\">Type</a>,\n    subtype: <span class=\"tok-type\">u8</span>,\n    length: <span class=\"tok-type\">u16</span> <span class=\"tok-kw\">align</span>(<span class=\"tok-number\">1</span>),\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> CreateFileDevicePathError = <a href=\"/zig-docs/zh-cn/std/mem/Allocator/#std.mem.Allocator\">Allocator</a>.<a href=\"/zig-docs/zh-cn/std/mem/Allocator/#std.mem.Allocator.Error\">Error</a>;\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> guid <span class=\"tok-kw\">align</span>(<span class=\"tok-number\">8</span>) = <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi.Guid\">Guid</a>{\n        .time_low = <span class=\"tok-number\">0x09576e91</span>,\n        .time_mid = <span class=\"tok-number\">0x6d3f</span>,\n        .time_high_and_version = <span class=\"tok-number\">0x11d2</span>,\n        .clock_seq_high_and_reserved = <span class=\"tok-number\">0x8e</span>,\n        .clock_seq_low = <span class=\"tok-number\">0x39</span>,\n        .node = [_]<span class=\"tok-type\">u8</span>{ <span class=\"tok-number\">0x00</span>, <span class=\"tok-number\">0xa0</span>, <span class=\"tok-number\">0xc9</span>, <span class=\"tok-number\">0x69</span>, <span class=\"tok-number\">0x72</span>, <span class=\"tok-number\">0x3b</span> },\n    };\n\n    <span class=\"tok-comment\">/// 返回序列中的下一个 DevicePath 节点（如果存在）。</span>\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">next</span>(self: *<span class=\"tok-kw\">const</span> <a href=\"/zig-docs/zh-cn/std/os/uefi/protocol/device_path/#std.os.uefi.protocol.device_path.DevicePath\">DevicePath</a>) ?*<span class=\"tok-kw\">const</span> <a href=\"/zig-docs/zh-cn/std/os/uefi/protocol/device_path/#std.os.uefi.protocol.device_path.DevicePath\">DevicePath</a> {\n        <span class=\"tok-kw\">const</span> subtype: <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath\">DevicePath</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.End\">End</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.End.Subtype\">Subtype</a> = <span class=\"tok-builtin\">@fromBackingInt</span>(<span class=\"tok-builtin\">@intCast</span>(self.subtype));\n        <span class=\"tok-kw\">if</span> (self.<span class=\"tok-type\">type</span> == .end <span class=\"tok-kw\">and</span> subtype == .end_entire) <span class=\"tok-kw\">return</span> <span class=\"tok-null\">null</span>;\n        <span class=\"tok-kw\">const</span> bytes: [*]<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span> = <span class=\"tok-builtin\">@ptrCast</span>(self);\n        <span class=\"tok-kw\">return</span> <span class=\"tok-builtin\">@ptrCast</span>(bytes + self.length);\n    }\n\n    <span class=\"tok-comment\">/// 计算设备路径结构的总字节长度，包括设备路径结束节点。</span>\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">size</span>(self: *<span class=\"tok-kw\">const</span> <a href=\"/zig-docs/zh-cn/std/os/uefi/protocol/device_path/#std.os.uefi.protocol.device_path.DevicePath\">DevicePath</a>) <span class=\"tok-type\">usize</span> {\n        <span class=\"tok-kw\">var</span> node = self;\n\n        <span class=\"tok-kw\">while</span> (node.next()) |next_node| {\n            node = next_node;\n        }\n\n        <span class=\"tok-kw\">return</span> (<span class=\"tok-builtin\">@intFromPtr</span>(node) + node.length) - <span class=\"tok-builtin\">@intFromPtr</span>(self);\n    }\n\n    <span class=\"tok-comment\">/// 从已有设备路径和文件路径创建文件设备路径。</span>\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">createFileDevicePath</span>(\n        self: *<span class=\"tok-kw\">const</span> <a href=\"/zig-docs/zh-cn/std/os/uefi/protocol/device_path/#std.os.uefi.protocol.device_path.DevicePath\">DevicePath</a>,\n        allocator: <a href=\"/zig-docs/zh-cn/std/mem/Allocator/#std.mem.Allocator\">Allocator</a>,\n        path: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u16</span>,\n    ) <a href=\"/zig-docs/zh-cn/std/mem/Allocator/#std.mem.Allocator.Error\">CreateFileDevicePathError</a>!*<span class=\"tok-kw\">const</span> <a href=\"/zig-docs/zh-cn/std/os/uefi/protocol/device_path/#std.os.uefi.protocol.device_path.DevicePath\">DevicePath</a> {\n        <span class=\"tok-kw\">const</span> path_size = self.size();<span class=\"tok-comment\">\n\n        // 2 * (path.len + 1) 用于路径及其空终止符，它们采用 u16\n        // DevicePath 用于结束节点之前的额外节点\n        </span><span class=\"tok-kw\">var</span> buf = <span class=\"tok-kw\">try</span> allocator.alloc(<span class=\"tok-type\">u8</span>, path_size + <span class=\"tok-number\">2</span> * (path.len + <span class=\"tok-number\">1</span>) + <span class=\"tok-builtin\">@sizeOf</span>(<a href=\"/zig-docs/zh-cn/std/os/uefi/protocol/device_path/#std.os.uefi.protocol.device_path.DevicePath\">DevicePath</a>));\n\n        <span class=\"tok-builtin\">@memcpy</span>(buf[<span class=\"tok-number\">0</span>..path_size], <span class=\"tok-builtin\">@as</span>([*]<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>, <span class=\"tok-builtin\">@ptrCast</span>(self))[<span class=\"tok-number\">0</span>..path_size]);<span class=\"tok-comment\">\n\n        // 指向当前链末尾节点副本的指针，即缓冲区末尾减 4，因为末尾节点自身占 4 字节（type: u8 + subtype: u8 + length: u16）。\n        //\n        </span><span class=\"tok-kw\">var</span> new = <span class=\"tok-builtin\">@as</span>(*<a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath\">DevicePath</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.Media\">Media</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.Media.FilePathDevicePath\">FilePathDevicePath</a>, <span class=\"tok-builtin\">@ptrCast</span>(buf.ptr + path_size - <span class=\"tok-number\">4</span>));\n\n        new.<span class=\"tok-type\">type</span> = .media;\n        new.subtype = .file_path;\n        new.length = <span class=\"tok-builtin\">@sizeOf</span>(<a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath\">DevicePath</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.Media\">Media</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.Media.FilePathDevicePath\">FilePathDevicePath</a>) + <span class=\"tok-number\">2</span> * (<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u16</span>, <span class=\"tok-builtin\">@intCast</span>(path.len)) + <span class=\"tok-number\">1</span>);<span class=\"tok-comment\">\n\n        // 与 new.getPath() 相同，但因正在填充它而不是 const。\n        </span><span class=\"tok-kw\">var</span> ptr = <span class=\"tok-builtin\">@as</span>([*:<span class=\"tok-number\">0</span>]<span class=\"tok-kw\">align</span>(<span class=\"tok-number\">1</span>) <span class=\"tok-type\">u16</span>, <span class=\"tok-builtin\">@ptrCast</span>(<span class=\"tok-builtin\">@as</span>([*]<span class=\"tok-type\">u8</span>, <span class=\"tok-builtin\">@ptrCast</span>(new)) + <span class=\"tok-builtin\">@sizeOf</span>(<a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath\">DevicePath</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.Media\">Media</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.Media.FilePathDevicePath\">FilePathDevicePath</a>)));\n\n        <span class=\"tok-kw\">for</span> (path, <span class=\"tok-number\">0</span>..) |s, i|\n            ptr[i] = s;\n\n        ptr[path.len] = <span class=\"tok-number\">0</span>;\n\n        <span class=\"tok-kw\">var</span> end = <span class=\"tok-builtin\">@as</span>(*<a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath\">DevicePath</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.End\">End</a>.<a href=\"/zig-docs/zh-cn/std/os/uefi/device_path/#std.os.uefi.device_path.DevicePath.End.EndEn
 |c| <span class=\"tok-kw\">switch</span> (c) {\n        <span class=\"tok-str\">'0'</span>...<span class=\"tok-str\">'9'</span> =&gt; {},\n        <span class=\"tok-kw\">else</span> =&gt; <span class=\"tok-kw\">return</span> <span class=\"tok-null\">false</span>,\n    };\n    <span class=\"tok-kw\">return</span> <span class=\"tok-null\">true</span>;\n}\n\n<span class=\"tok-kw\">test</span> isPrimitive {\n    <span class=\"tok-kw\">const</span> expect = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>;\n    <span class=\"tok-kw\">try</span> expect(!<a href=\"/zig-docs/zh-cn/std/zig/primitives/#std.zig.primitives.isPrimitive\">isPrimitive</a>(<span class=\"tok-str\">\"\"</span>));\n    <span class=\"tok-kw\">try</span> expect(!<a href=\"/zig-docs/zh-cn/std/zig/primitives/#std.zig.primitives.isPrimitive\">isPrimitive</a>(<span class=\"tok-str\">\"_\"</span>));\n    <span class=\"tok-kw\">try</span> expect(!<a href=\"/zig-docs/zh-cn/std/zig/primitives/#std.zig.primitives.isPrimitive\">isPrimitive</a>(<span class=\"tok-str\">\"haberdasher\"</span>));\n    <span class=\"tok-kw\">try</span> expect(<a href=\"/zig-docs/zh-cn/std/zig/primitives/#std.zig.primitives.isPrimitive\">isPrimitive</a>(<span class=\"tok-str\">\"bool\"</span>));\n    <span class=\"tok-kw\">try</span> expect(<a href=\"/zig-docs/zh-cn/std/zig/primitives/#std.zig.primitives.isPrimitive\">isPrimitive</a>(<span class=\"tok-str\">\"false\"</span>));\n    <span class=\"tok-kw\">try</span> expect(<a href=\"/zig-docs/zh-cn/std/zig/primitives/#std.zig.primitives.isPrimitive\">isPrimitive</a>(<span class=\"tok-str\">\"comptime_float\"</span>));\n    <span class=\"tok-kw\">try</span> expect(<a href=\"/zig-docs/zh-cn/std/zig/primitives/#std.zig.primitives.isPrimitive\">isPrimitive</a>(<span class=\"tok-str\">\"u1\"</span>));\n    <span class=\"tok-kw\">try</span> expect(<a href=\"/zig
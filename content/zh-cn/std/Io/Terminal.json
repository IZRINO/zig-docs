s\"></div>\n<pre><code>bright_cyan</code></pre><div class=\"fieldDocs\"></div>\n<pre><code>bright_white</code></pre><div class=\"fieldDocs\"></div>\n<pre><code>dim</code></pre><div class=\"fieldDocs\"></div>\n<pre><code>bold</code></pre><div class=\"fieldDocs\"></div>\n<pre><code>reset</code></pre><div class=\"fieldDocs\"></div>\n</div>\n</section>\n<section class=\"api-entry\" id=\"std.Io.Terminal.File\"><h3><code>std.Io.Terminal.File</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L10\">源码行 10</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\"><code>std.Io.File</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.Terminal.Io\"><h3><code>std.Io.Terminal.Io</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L9\">源码行 9</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\"><code>std.Io</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.Terminal.is_windows\"><h3><code>std.Io.Terminal.is_windows</code></h3>\n<p class=\"api-kind\">常量</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L6\">源码行 6</a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.Terminal.Mode\"><h3><code>std.Io.Terminal.Mode</code></h3>\n<p class=\"api-kind\">容器</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L37\">源码行 37</a></p>\n<h4>字段</h4><div class=\"api-fields\">\n<pre><code>no_color</code></pre><div class=\"fieldDocs\"></div>\n<pre><code>escape_codes</code></pre><div class=\"fieldDocs\"></div>\n<pre><code>windows_api: <a href=\"/zig-docs/zh-cn/std/Io/Terminal/#std.Io.Terminal.Mode.WindowsApi\">WindowsApi</a></code></pre><div class=\"fieldDocs\"></div>\n</div>\n<div class=\"api-members\"><ul>\n<li><a href=\"/zig-docs/zh-cn/std/Io/Terminal/#std.Io.Terminal.Mode.WindowsApi\"><code>WindowsApi</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/Terminal/#std.Io.Terminal.Mode.detect\"><code>detect</code></a></li>\n</ul></div>\n</section>\n<section class=\"api-entry\" id=\"std.Io.Terminal.Mode.detect\"><h3><code>std.Io.Terminal.Mode.detect</code></h3>\n<p class=\"api-kind\">函数</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L57\">源码行 57</a></p>\n<div class=\"api-description\"><p>为给定文件检测合适的 TTY 配置选项，通常用于\nstdout、stderr。</p>\n<p>必要且可行时，尝试启用 ANSI 转义码支持。</p>\n<ul>\n<li><code>NO_COLOR</code> 表示环境变量 \"NO_COLOR\" 是否\n存在且非空。</li>\n<li><code>CLICOLOR_FORCE</code> 表示环境变量 \"CLICOLOR_FORCE\" 是否\n存在且非空。</li>\n</ul>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">detect</span>(io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>, file: <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\">File</a>, NO_COLOR: <span class=\"tok-type\">bool</span>, CLICOLOR_FORCE: <span class=\"tok-type\">bool</span>) <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/#std.Io.Cancelable\">Cancelable</a>!<a href=\"/zig-docs/zh-cn/std/Io/Terminal/#std.Io.Terminal.Mode\">Mode</a></code></pre>\n<h4>参数</h4><div class=\"api-parameters\">\n<pre><code>io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a></code></pre>\n<pre><code>file: <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\">File</a></code></pre>\n<pre><code>NO_COLOR: <span class=\"tok-type\">bool</span></code></pre>\n<pre><code>CLICOLOR_FORCE: <span class=\"tok-type\">bool</span></code></pre>\n</div>\n<h4>错误</h4><dl>\n<dt>Canceled</dt><dd><p>调用方请求停止异步操作。</p>\n</dd>\n</dl>\n</section>\n<section class=\"api-entry\" id=\"std.Io.Terminal.Mode.WindowsApi\"><h3><code>std.Io.Terminal.Mode.WindowsApi</code></h3>\n<p class=\"api-kind\">类型</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L42\">源码行 42</a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.Terminal.setColor\"><h3><code>std.Io.Terminal.setColor</code></h3>\n<p class=\"api-kind\">函数</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L85\">源码行 85</a></p>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">setColor</span>(t: <a href=\"/zig-docs/zh-cn/std/Io/Terminal/#std.Io.Terminal\">Terminal</a>, color: <a href=\"/zig-docs/zh-cn/std/Io/Terminal/#std.Io.Terminal.Color\">Color</a>) <a href=\"/zig-docs/zh-cn/std/Io/Terminal/#std.Io.Terminal.SetColorError\">SetColorError</a>!<span class=\"tok-type\">void</span></code></pre>\n<h4>参数</h4><div class=\"api-parameters\">\n<pre><code>t: <a href=\"/zig-docs/zh-cn/std/Io/Terminal/#std.Io.Terminal\">Terminal</a></code></pre>\n<pre><code>color: <a href=\"/zig-docs/zh-cn/std/Io/Terminal/#std.Io.Terminal.Color\">Color</a></code></pre>\n</div>\n<h4>错误</h4><dl>\n<dt>Canceled <a href=\"/zig-docs/zh-cn/std/Io/#std.Io.Cancelable\">Cancelable</a></dt><dd><p>调用方请求停止异步操作。</p>\n</dd>\n<dt>Unexpected <a href=\"/zig-docs/zh-cn/std/Io/#std.Io.UnexpectedError\">UnexpectedError</a></dt><dd><p>操作系统返回了未记录在文档中的错误码。</p>\n<p>理论上不可能出现此错误，但处理\n此错误优于触发未定义行为。</p>\n<p>观察到此错误码时，通常意味着 Zig 标准\n库需要小幅修补，将该错误码加入\n相应函数的错误集合。</p>\n</dd>\n<dt>WriteFailed <a href=\"/zig-docs/zh-cn/std/Io/Writer/#std.Io.Writer.Error\">Error</a></dt><dd><p>详细诊断信息见 <code><a href=\"/zig-docs/zh-cn/std/Io/Writer/#std.Io.Writer\">Writer</a></code> 实现。</p>\n</dd>\n</dl>\n</section>\n<section class=\"api-entry\" id=\"std.Io.Terminal.SetColorError\"><h3><code>std.Io.Terminal.SetColorError</code></h3>\n<p class=\"api-kind\">错误集合</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L83\">源码行 83</a></p>\n<h4>错误</h4><dl>\n<dt>Canceled <a href=\"/zig-docs/zh-cn/std/Io/#std.Io.Cancelable\">Cancelable</a></dt><dd><p>调用方请求停止异步操作。</p>\n</dd>\n<dt>Unexpected <a href=\"/zig-docs/zh-cn/std/Io/#std.Io.UnexpectedError\">UnexpectedError</a></dt><dd><p>操作系统返回了未记录在文档中的错误码。</p>\n<p>理论上不可能出现此错误，但处理\n此错误优于触发未定义行为。</p>\n<p>观察到此错误码时，通常意味着 Zig 标准\n库需要小幅修补，将该错误码加入\n相应函数的错误集合。</p>\n</dd>\n<dt>WriteFailed <a href=\"/zig-docs/zh-cn/std/Io/Writer/#std.Io.Writer.Error\">Error</a></dt><dd><p>详细诊断信息见 <code><a href=\"/zig-docs/zh-cn/std/Io/Writer/#std.Io.Writer\">Writer</a></code> 实现。</p>\n</dd>\n</dl>\n</section>\n<section class=\"api-entry\" id=\"std.Io.Terminal.std\"><h3><code>std.Io.Terminal.std</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L8\">源码行 8</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/#std\"><code>std</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.Terminal.Terminal\"><h3><code>std.Io.Terminal.Terminal</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L3\">源码行 3</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/Io/Terminal/#std.Io.Terminal\"><code>std.Io.Terminal</code></a></p>\n</section>\n<details class=\"source-code\" id=\"source\" data-pagefind-ignore=\"\"><summary>源码</summary><p><code>std/Io/Terminal.zig</code></p><div class=\"source-grid\"><pre class=\"line-numbers\" aria-hidden=\"true\" data-copy-ignore=\"\"><code><a id=\"L1\" href=\"#L1\" tabindex=\"-1\">1</a>\n<a id=\"L2\" href=\"#L2\" tabindex=\"-1\">2</a>\n<a id=\"L3\" href=\"#L3\" tabindex=\"-1\">3</a>\n<a id=\"L4\" href=\"#L4\" tabindex=\"-1\">4</a>\n<a id=\"L5\" href=\"#L5\" tabindex=\"-1\">5</a>\n<a id=\"L6\" href=\"#L6\" tabindex=\"-1\">6</a>\n<a id=\"L7\" href=\"#L7\" tabindex=\"-1\">7</a>\n<a id=\"L8\" href=\"#L8\" tabindex=\"-1\">8</a>\n<a id=\"L9\" href=\"#L9\" tabindex=\"-1\">9</a>\n<a id=\"L10\" href=\"#L10\" tabindex=\"-1\">10</a>\n<a id=\"L11\" href=\"#L11\" tabindex=\"-1\">11</a>\n<a id=\"L12\" href=\"#L12\" tabindex=\"-1\">12</a>\n<a id=\"L13\" href=\"#L13\" tabindex=\"-1\">13</a>\n<a id=\"L14\" href=\"#L14\" tabindex=\"-1\">14</a>\n<a id=\"L15\" href=\"#L15\" tabindex=\"-1\">15</a>\n<a id=\"L16\" href=\"#L16\" tabindex=\"-1\">16</a>\n<a id=\"L17\" href=\"#L17\" tabindex=\"-1\">17</a>\n<a id=\"L18\" href=\"#L18\" tabindex=\"-1\">18</a>\n<a id=\"L19\" href=\"#L19\" tabindex=\"-1\">19<
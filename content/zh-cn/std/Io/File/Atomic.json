cn/std/Io/Dir/#std.Io.Dir.RenamePreserveError\">RenamePreserveError</a>;\n\n<span class=\"tok-comment\">/// 以原子方式将文件放置到目标位置；若该处已有内容，</span>\n<span class=\"tok-comment\">/// 则以 `error.PathAlreadyExists` 失败。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 如果无法使用无名临时文件完成此操作，</span>\n<span class=\"tok-comment\">/// 则随后另行删除有名临时文件，该删除操作</span>\n<span class=\"tok-comment\">/// 也可能独立失败。其结果存储在 `delete_err` 中。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">link</span>(af: *<a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic\">Atomic</a>, io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>) <a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic.LinkError\">LinkError</a>!<span class=\"tok-type\">void</span> {\n    <span class=\"tok-kw\">if</span> (af.file_exists) {\n        <span class=\"tok-kw\">if</span> (af.file_open) {\n            af.file.close(io);\n            af.file_open = <span class=\"tok-null\">false</span>;\n        }\n        <span class=\"tok-kw\">const</span> tmp_sub_path = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/fmt/#std.fmt\">fmt</a>.<a href=\"/zig-docs/zh-cn/std/fmt/#std.fmt.hex\">hex</a>(af.file_basename_hex);\n        <span class=\"tok-kw\">try</span> af.dir.renamePreserve(&amp;tmp_sub_path, af.dir, af.dest_sub_path, io);\n        af.file_exists = <span class=\"tok-null\">false</span>;\n    } <span class=\"tok-kw\">else</span> {\n        <a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\">assert</a>(af.file_open);\n        <span class=\"tok-kw\">try</span> af.file.hardLink(io, af.dir, af.dest_sub_path, .{});\n        af.file.close(io);\n        af.file_open = <span class=\"tok-null\">false</span>;\n    }\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> ReplaceError = <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir\">Dir</a>.<a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\"
File.Atomic.Dir","category":"alias","sourceLine":6},{"id":"std/Io/File/Atomic.zig:5:12952","name":"std.Io.File.Atomic.File","anchor":"std.Io.File.Atomic.File","category":"alias","sourceLine":5},{"id":"std/Io/File/Atomic.zig:19:12955","name":"std.Io.File.Atomic.InitError","anchor":"std.Io.File.Atomic.InitError","category":"alias","sourceLine":19},{"id":"std/Io/File/Atomic.zig:4:12951","name":"std.Io.File.Atomic.Io","anchor":"std.Io.File.Atomic.Io","category":"alias","sourceLine":4},{"id":"std/Io/File/Atomic.zig:48:12958","name":"std.Io.File.Atomic.link","anchor":"std.Io.File.Atomic.link","category":"function","sourceLine":48},{"id":"std/Io/File/Atomic.zig:40:12957","name":"std.Io.File.Atomic.LinkError","anchor":"std.Io.File.Atomic.LinkError","category":"error-set","sourceLine":40},{"id":"std/Io/File/Atomic.zig:77:12960","name":"std.Io.File.Atomic.replace","anchor":"std.Io.File.Atomic.replace","category":"function","sourceLine":77},{"id":"std/Io/File/Atomic.zig:65:12959","name":"std.Io.File.Atomic.ReplaceError","anchor":"std.Io.File.Atomic.ReplaceError","category":"alias","sourceLine":65},{"id":"std/Io/File/Atomic.zig:3:12950","name":"std.Io.File.Atomic.std","anchor":"std.Io.File.Atomic.std","category":"alias","sourceLine":3}],"html":"<div id=\"std.Io.File.Atomic\"></div>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L1\">源码行 1</a></p>\n<h4>字段</h4><div class=\"api-fields\">\n<pre><code>file: <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\">File</a></code></pre><div class=\"fieldDocs\"></div>\n<pre><code>file_basename_hex: <span class=\"tok-type\">u64</span></code></pre><div class=\"fieldDocs\"></div>\n<pre><code>file_open: <span class=\"tok-type\">bool</span></code></pre><div class=\"fieldDocs\"></div>\n<pre><code>file_exists: <span class=\"tok-type\">bool</span></code></pre><div class=\"fieldDocs\"></div>\n<pre><code>dir: <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir\">Dir</a></code></pre><div class=\"fieldDocs\"></div>\n<pre><code>close_dir_on_deinit: <span class=\"tok-type\">bool</span></code></pre><div class=\"fieldDocs\"></div>\n<pre><code>dest_sub_path: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span></code></pre><div class=\"fieldDocs\"></div>\n</div>\n<div class=\"api-members\"><ul>\n<li><a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic\"><code>Atomic</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/#std\"><code>std</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/#std.Io\"><code>Io</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\"><code>File</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir\"><code>Dir</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\"><code>assert</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.OpenError\"><code>InitError</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic.deinit\"><code>deinit</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic.LinkError\"><code>LinkError</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic.link\"><code>link</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\"><code>ReplaceError</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic.replace\"><code>replace</code></a></li>\n</ul></div>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.assert\"><h3><code>std.Io.File.Atomic.assert</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L7\">源码行 7</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\"><code>std.debug.assert</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.Atomic\"><h3><code>std.Io.File.Atomic.Atomic</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L1\">源码行 1</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic\"><code>std.Io.File.Atomic</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.deinit\"><h3><code>std.Io.File.Atomic.deinit</code></h3>\n<p class=\"api-kind\">函数</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L23\">源码行 23</a></p>\n<div class=\"api-description\"><p>要释放所有资源，即使 <code>finish</code> 成功后也必须始终\n调用 <code><a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic.deinit\">deinit</a></code>。</p>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">deinit</span>(af: *<a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic\">Atomic</a>, io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>) <span class=\"tok-type\">void</span></code></pre>\n<h4>参数</h4><div class=\"api-parameters\">\n<pre><code>af: *<a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic\">Atomic</a></code></pre>\n<pre><code>io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a></code></pre>\n</div>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.Dir\"><h3><code>std.Io.File.Atomic.Dir</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L6\">源码行 6</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir\"><code>std.Io.Dir</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.File\"><h3><code>std.Io.File.Atomic.File</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L5\">源码行 5</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\"><code>std.Io.File</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.InitError\"><h3><code>std.Io.File.Atomic.InitError</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L19\">源码行 19</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.OpenError\"><code>std.Io.File.OpenError</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.Io\"><h3><code>std.Io.File.Atomic.Io</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L4\">源码行 4</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\"><code>std.Io</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.link\"><h3><code>std.Io.File.Atomic.link</code></h3>\n<p class=\"api-kind\">函数</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L48\">源码行 48</a></p>\n<div class=\"api-description\"><p>以原子方式将文件放置到目标位置；若该处已有内容，\n则以 <code>error.PathAlreadyExists</code> 失败。</p>\n<p>如果无法使用无名临时文件完成此操作，\n则随后另行删除有名临时文件，该删除操作\n也可能独立失败。其结果存储在 <code>delete_err</code> 中。</p>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">link</span>(af: *<a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic\">Atomic</a>, io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>) <a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic.LinkError\">LinkError</a>!<span class=\"tok-type\">void</span></code></pre>\n<h4>参数</h4><div class=\"api-parameters\">\n<pre><code>af: *<a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic\">Atomic</a></code></pre>\n<pre><code>io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a></code></pre>\n</div>\n<h4>错误</h4><dl>\n<dt>AccessDenied <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenamePreserveError\">RenamePreserveError</a></dt><dd><p>在 WASI 中，当文件描述符不具有\n按相对于该描述符的路径重命名资源所需的权限时，可能发生此错误。</p>\n<p>在 Windows 上，将目录重命名并覆盖已有目录时，\n可能返回此错误，而不是 PathAlreadyExists。</p>\n<p>在 Darwin 上，如果任一路径中的分量指向需要实体化的\n“无数据”目录，而当前线程或进程的 I/O\n策略不允许无数据目录实体化，则可能返回此错误。</p>\n</dd>\n<dt>AntivirusInterference <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>Windows 默认启用杀毒软件。虽然可以禁用，但 Windows Update 有时会忽略用户偏好并重新启用。\n启用时，Windows 上的杀毒软件会拦截文件系统操作，使其显著变慢，也可能导致操作因该错误码失败。</p>\n</dd>\n<dt>BadPathName <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.PathNameError\">PathNameError</a></dt><dd><p>文件系统无法编码请求的文件名字节。\n原因可能是 Windows 上无效的 WTF-8、WASI 上无效的 UTF-8、\nWindows 上的无效字符等，具体取决于文件系统与操作系统。</p>\n</dd>\n<dt>Canceled <a href=\"/zig-docs/zh-cn/std/Io/#std.Io.Cancelable\">Cancelable</a></dt><dd><p>调用方请求停止异步操作。</p>\n</dd>\n<dt>CrossDevice <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>DirNotEmpty <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>试图替换非空目录。</p>\n</dd>\n<dt>DiskQuota <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>FileBusy <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>尝试移动或替换的文件是正在运行的可执行文件。</p>\n</dd>\n<dt>FileNotFound <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>HardwareFailure <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>IsDir <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>LinkQuotaExceeded <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>NameTooLong <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.PathNameError\">PathNameError</a></dt><dd><p>提供的缓冲区过小，\n无法容纳路径名时返回。</p>\n</dd>\n<dt>NetworkNotFound <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>在 Windows 上，未找到 <code>\\\\server</code> 或 <code>\\\\server\\share</code>。</p>\n</dd>\n<dt>NoDevice <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>NoSpaceLeft <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>NotDir <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>OperationUnsupported <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd><p>操作系统或文件系统不支持硬链接。</p>\n</dd>\n<dt>PathAlreadyExists <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>PermissionDenied <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>PipeBusy <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>ReadOnlyFileSystem <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>SymLinkLoop <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>SystemResources <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>Unexpected <a href=\"/zig-docs/zh-cn/std/Io/#std.Io.UnexpectedError\">UnexpectedError</a></dt><dd><p>操作系统返回了未记录在文档中的错误码。</p>\n<p>理论上不可能出现此错误，但处理\n此错误优于触发未定义行为。</p>\n<p>观察到此错误码时，通常意味着 Zig 标准\n库需要小幅修补，将该错误码加入\n相应函数的错误集合。</p>\n</dd>\n</dl>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.LinkError\"><h3><code>std.Io.File.Atomic.LinkError</code></h3>\n<p class=\"api-kind\">错误集合</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L40\">源码行 40</a></p>\n<h4>错误</h4><dl>\n<dt>AccessDenied <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenamePreserveError\">RenamePreserveError</a></dt><dd><p>在 WASI 中，当文件描述符不具有\n按相对于该描述符的路径重命名资源所需的权限时，可能发生此错误。</p>\n<p>在 Windows 上，将目录重命名并覆盖已有目录时，\n可能返回此错误，而不是 PathAlreadyExists。</p>\n<p>在 Darwin 上，如果任一路径中的分量指向需要实体化的\n“无数据”目录，而当前线程或进程的 I/O\n策略不允许无数据目录实体化，则可能返回此错误。</p>\n</dd>\n<dt>AntivirusInterference <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>Windows 默认启用杀毒软件。虽然可以禁用，但 Windows Update 有时会忽略用户偏好并重新启用。\n启用时，Windows 上的杀毒软件会拦截文件系统操作，使其显著变慢，也可能导致操作因该错误码失败。</p>\n</dd>\n<dt>BadPathName <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.PathNameError\">PathNameError</a></dt><dd><p>文件系统无法编码请求的文件名字节。\n原因可能是 Windows 上无效的 WTF-8、WASI 上无效的 UTF-8、\nWindows 上的无效字符等，具体取决于文件系统与操作系统。</p>\n</dd>\n<dt>Canceled <a href=\"/zig-docs/zh-cn/std/Io/#std.Io.Cancelable\">Cancelable</a></dt><dd><p>调用方请求停止异步操作。</p>\n</dd>\n<dt>CrossDevice <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>DirNotEmpty <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>试图替换非空目录。</p>\n</dd>\n<dt>DiskQuota <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>FileBusy <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>尝试移动或替换的文件是正在运行的可执行文件。</p>\n</dd>\n<dt>FileNotFound <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>HardwareFailure <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>IsDir <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>LinkQuotaExceeded <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>NameTooLong <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.PathNameError\">PathNameError</a></dt><dd><p>提供的缓冲区过小，\n无法容纳路径名时返回。</p>\n</dd>\n<dt>NetworkNotFound <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>在 Windows 上，未找到 <code>\\\\server</code> 或 <code>\\\\server\\share</code>。</p>\n</dd>\n<dt>NoDevice <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>NoSpaceLeft <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>NotDir <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>OperationUnsupported <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd><p>操作系统或文件系统不支持硬链接。</p>\n</dd>\n<dt>PathAlreadyExists <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>PermissionDenied <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>PipeBusy <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>ReadOnlyFileSystem <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>SymLinkLoop <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>SystemResources <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File.HardLinkError\">HardLinkError</a></dt><dd></dd>\n<dt>Unexpected <a href=\"/zig-docs/zh-cn/std/Io/#std.Io.UnexpectedError\">UnexpectedError</a></dt><dd><p>操作系统返回了未记录在文档中的错误码。</p>\n<p>理论上不可能出现此错误，但处理\n此错误优于触发未定义行为。</p>\n<p>观察到此错误码时，通常意味着 Zig 标准\n库需要小幅修补，将该错误码加入\n相应函数的错误集合。</p>\n</dd>\n</dl>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.replace\"><h3><code>std.Io.File.Atomic.replace</code></h3>\n<p class=\"api-kind\">函数</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L77\">源码行 77</a></p>\n<div class=\"api-description\"><p>以原子方式将文件实体化到目标位置，替换该位置已有的任意文件。</p>\n<p>调用此函数要求将 <code>CreateFileAtomicOptions.replace</code> 设为 <code>true</code>。</p>\n<p>Windows 上，此函数会引入一段时间，在此期间，对目标文件的某些文件系统操作会返回 <code>error.AccessDenied</code>，包括本函数使用的重命名操作。</p>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">replace</span>(af: *<a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic\">Atomic</a>, io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>) <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">ReplaceError</a>!<span class=\"tok-type\">void</span></code></pre>\n<h4>参数</h4><div class=\"api-parameters\">\n<pre><code>af: *<a href=\"/zig-docs/zh-cn/std/Io/File/Atomic/#std.Io.File.Atomic\">Atomic</a></code></pre>\n<pre><code>io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a></code></pre>\n</div>\n<h4>错误</h4><dl>\n<dt>AccessDenied <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>在 WASI 中，当文件描述符不具备相对于自身\n按路径重命名资源所需的权限时，可能发生此错误。</p>\n</dd>\n<dt>AntivirusInterference <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>Windows 默认启用杀毒软件。虽然可以禁用，但 Windows Update 有时会忽略用户偏好并重新启用。\n启用时，Windows 上的杀毒软件会拦截文件系统操作，使其显著变慢，也可能导致操作因该错误码失败。</p>\n</dd>\n<dt>BadPathName <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.PathNameError\">PathNameError</a></dt><dd><p>文件系统无法编码请求的文件名字节。\n原因可能是 Windows 上无效的 WTF-8、WASI 上无效的 UTF-8、\nWindows 上的无效字符等，具体取决于文件系统与操作系统。</p>\n</dd>\n<dt>Canceled <a href=\"/zig-docs/zh-cn/std/Io/#std.Io.Cancelable\">Cancelable</a></dt><dd><p>调用方请求停止异步操作。</p>\n</dd>\n<dt>CrossDevice <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>DirNotEmpty <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>试图替换非空目录。</p>\n</dd>\n<dt>DiskQuota <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>FileBusy <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>尝试移动或替换的文件是正在运行的可执行文件。</p>\n</dd>\n<dt>FileNotFound <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>HardwareFailure <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>IsDir <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>LinkQuotaExceeded <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>NameTooLong <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.PathNameError\">PathNameError</a></dt><dd><p>提供的缓冲区过小，\n无法容纳路径名时返回。</p>\n</dd>\n<dt>NetworkNotFound <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd><p>在 Windows 上，未找到 <code>\\\\server</code> 或 <code>\\\\server\\share</code>。</p>\n</dd>\n<dt>NoDevice <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>NoSpaceLeft <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>NotDir <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>PermissionDenied <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>PipeBusy <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>ReadOnlyFileSystem <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>SymLinkLoop <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>SystemResources <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\">RenameError</a></dt><dd></dd>\n<dt>Unexpected <a href=\"/zig-docs/zh-cn/std/Io/#std.Io.UnexpectedError\">UnexpectedError</a></dt><dd><p>操作系统返回了未记录在文档中的错误码。</p>\n<p>理论上不可能出现此错误，但处理\n此错误优于触发未定义行为。</p>\n<p>观察到此错误码时，通常意味着 Zig 标准\n库需要小幅修补，将该错误码加入\n相应函数的错误集合。</p>\n</dd>\n</dl>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.ReplaceError\"><h3><code>std.Io.File.Atomic.ReplaceError</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L65\">源码行 65</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir.RenameError\"><code>std.Io.Dir.RenameError</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.Io.File.Atomic.std\"><h3><code>std.Io.File.Atomic.std</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L3\">源码行 3</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/#std\"><code>std</code></a></p>\n</section>\n<details class=\"source-code\" id=\"source\" data-pagefind-ignore=\"\"><summary>源码</summary><p><code>std/Io/File/Atomic.zig</code></p><div class=\"source-grid\"><pre class=\"line-numbers\" aria-hidden=\"true\" data-copy-ignore=\"\"><code><a id=\"L1\" href=\"#L1\" tabindex=\"-1\">1</a>\n<a id=\"L2\" href=\"#L2\" tabindex=\"-1\">2</a>\n<a id=\"L3\" href=\"#L3\" tabindex=\"-1\">3</a>\n<a id=\"L4\" href=\"#L4\" tabindex=\"-1\">4</a>\n<a id=\"L5\" href=\"#L5\" tabindex=\"-1\">5</a>\n<a id=\"L6\" href=\"#L6\" tabindex=\"-1\">6</a>\n<a id=\"L7\" href=\"#L7\" tabindex=\"-1\">7</a>\n<a id=\"L8\" href=\"#L8\" tabindex=\"-1\">8</a>\n<a id=\"L9\" href=\"#L9\" tabindex=\"-1\">9</a>\n<a id=\"L10\" href=\"#L10\" tabindex=\"-1\">10</a>\n<a id=\"L11\" href=\"#L11\" tabindex=\"-1\">11</a>\n<a id=\"L12\" href=\"#L12\" tabindex=\"-1\">12</a>\n<a id=\"L13\" href=\"#L13\" tabindex=\"-1\">13</a>\n<a id=\"L14\" href=\"#L14\" tabindex=\"-1\">14</a>\n<a id=\"L15\" href=\"#L15\" tabindex=\"-1\">15</a>\n<a id=\"L16\" href=\"#L16\" tabindex=\"-1\">16</a>\n<a id=\"L17\" href=\"#L17\" tabindex=\"-1\">17</a>\n<a id=\"L18\" href=\"#L18\" tabindex=\"-1\">18</a>\n<a id=\"L19\" href=\"#L19\" tabindex=\"-1\">19</a>\n<a id=\"L20\" href=\"#L20\" tabindex=\"-1\">20</a>\n<a id=\"L21\" href=\"#L21\" tabindex=\"-1\">21</a>\n<a id=\"L22\" href=\"#L22\" tabindex=\"-1\">22</a>\n<a id=\"L23\" href=\"#L23\" tabindex=\"-1\">23</a>\n<a id=\"L24\" href=\"#L24\" tabindex=\"-1\">24</a>\n<a id=\"L25\" href=\"#L25\" tabindex=\"-1\">25</a>\n<a id=\"L26\" href=\"#L26\" tabindex=\"-1\">26</a>\n<a id=\"L27\" href=\"#L27\" tabindex=\"-1\">27</a>\n<a id=\"L28\" href=\"#L28\" tabindex=\"-1\">28</a>\n<a id=\"L29\" href=\"#L29\" tabindex=\"-1\">29</a>\n<a id=\"L30\" href=\"#L30\" tabindex=\"-1\">30</a>\n<a id=\"L31\" href=\"#L31\" tabindex=\"-1\">31</a>\n<a id=\"L32\" href=\"#L32\" tabindex=\"-1\">32</a>\n<a id=\"L33\" href=\"#L33\" tabindex=\"-1\">33</a>\n<a id=\"L34\" href=\"#L34\" tabindex=\"-1\">34</a>\n<a id=\"L35\" href=\"#L35\" tabindex=\"-1\">35</a>\n<a id=\"L36\" href=\"#L36\" tabindex=\"-1\">36</a>\n<a id=\"L37\" href=\"#L37\" tabindex=\"-1\">37</a>\n<a id=\"L38\" href=\"#L38\" tabindex=\"-1\">38</a>\n<a id=\"L39\" href=\"#L39\" tabindex=\"-1\">39</a>\n<a id=\"L40\" href=\"#L40\" tabindex=\"-1\">40</a>\n<a id=\"L41\" href=\"#L41\" tabindex=\"-1\">41</a>\n<a id=\"L42\" href=\"#L42\" tabindex=\"-1\">42</a>\n<a id=\"L43\" href=\"#L43\" tabindex=\"-1\">43</a>\n<a id=\"L44\" href=\"#L44\" tabindex=\"-1\">44</a>\n<a id=\"L45\" href=\"#L45\" tabindex=\"-1\">45</a>\n<a id=\"L46\" href=\"#L46\" tabindex=\"-1\">46</a>\n<a id=\"L47\" href=\"#L47\" tabindex=\"-1\">47</a>\n<a id=\"L48\" href=\"#L48\" tabindex=\"-1\">48</a>\n<a id=\"L49\" href=\"#L49\" tabindex=\"-1\">49</a>\n<a id=\"L50\" href=\"#L50\" tabindex=\"-1\">50</a>\n<a id=\"L51\" href=\"#L51\" tabindex=\"-1\">51</a>\n<a id=\"L52\" href=\"#L52\" tabindex=\"-1\">52</a>\n<a id=\"L53\" href=\"#L53\" tabindex=\"-1\">53</a>\n<a id=\"L54\" href=\"#L54\" tabindex=\"-1\">54</a>\n<a id=\"L55\" href=\"#L55\" tabindex=\"-1\">55</a>\n<a id=\"L56\" href=\"#L56\" tabindex=\"-1\">56</a>\n<a id=\"L57\" href=\"#L57\" tabindex=\"-1\">57</a>\n<a id=\"L58\" href=\"#L58\" tabindex=\"-1\">58</a>\n<a id=\"L59\" href=\"#L59\" tabindex=\"-1\">59</a>\n<a id=\"L60\" href=\"#L60\" tabindex=\"-1\">60</a>\n<a id=\"L61\" href=\"#L61\" tabindex=\"-1\">61</a>\n<a id=\"L62\" href=\"#L62\" tabindex=\"-1\">62</a>\n<a id=\"L63\" href=\"#L63\" tabindex=\"-1\">63</a>\n<a id=\"L64\" href=\"#L64\" tabindex=\"-1\">64</a>\n<a id=\"L65\" href=\"#L65\" tabindex=\"-1\">65</a>\n<a id=\"L66\" href=\"#L66\" tabindex=\"-1\">66</a>\n<a id=\"L67\" href=\"#L67\" tabindex=\"-1\">67</a>\n<a id=\"L68\" href=\"#L68\" tabindex=\"-1\">68</a>\n<a id=\"L69\" href=\"#L69\" tabindex=\"-1\">69</a>\n<a id=\"L70\" href=\"#L70\" tabindex=\"-1\">70</a>\n<a id=\"L71\" href=\"#L71\" tabindex=\"-1\">71</a>\n<a id=\"L72\" href=\"#L72\" tabindex=\"-1\">72</a>\n<a id=\"L73\" href=\"#L73\" tabindex=\"-1\">73</a>\n<a id=\"L74\" href=\"#L74\" tabindex=\"-1\">74</a>\n<a id=\"L75\" href=\"#L75\" tabindex=\"-1\">75</a>\n<a id=\"L76\" href=\"#L76\" tabindex=\"-1\">76</a>\n<a id=\"L77\" href=\"#L77\" tabindex=\"-1\">77</a>\n<a id=\"L78\" href=\"#L78\" tabindex=\"-1\">78</a>\n<a id=\"L79\" href=\"#L79\" tabindex=\"-1\">79</a>\n<a id=\"L80\" href=\"#L80\" tabindex=\"-1\">80</a>\n<a id=\"L81\" href=\"#L81\" tabindex=\"-1\">81</a>\n<a id=\"L82\" href=\"#L82\" tabindex=\"-1\">82</a>\n<a id=\"L83\" href=\"#L83\" tabindex=\"-1\">83</a>\n<a id=\"L84\" href=\"#L84\" tabindex=\"-1\">84</a>\n<a id=\"L85\" href=\"#L85\" tabindex=\"-1\">85</a>\n<a id=\"L86\" href=\"#L86\" tabindex=\"-1\">86</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> Atomic = <span class=\"tok-builtin\">@This</span>();\n\n<span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../../std.zig\"</span>);\n<span class=\"tok-kw\">const</span> Io = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>;\n<span class=\"tok-kw\">const</span> File = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\">File</a>;\n<span class=\"tok-kw\">const</span> Dir = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir\">Dir</a>;\n<span class=\"tok-kw\">const</span> assert = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/debug/#std.debug\">debug</a>.<a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\">assert</a>;\n\nfile: <a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\">File</a>,\nfile_basename_hex: <span class=\"tok-type\">u64</span>,\nfile_open: <span class=\"tok-type\">bool</span>,\nfile_exists: <span class=\"tok-type\">bool</span>,\n\ndir: <
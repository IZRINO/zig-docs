\"L156\" href=\"#L156\" tabindex=\"-1\">156</a>\n<a id=\"L157\" href=\"#L157\" tabindex=\"-1\">157</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> Child = <span class=\"tok-builtin\">@This</span>();\n\n<span class=\"tok-kw\">const</span> builtin = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"builtin\"</span>);\n<span class=\"tok-kw\">const</span> native_os = <a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.builtin\">builtin</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.process.Child.builtin.os\">os</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.process.Child.builtin.os.tag\">tag</a>;\n\n<span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../std.zig\"</span>);\n<span class=\"tok-kw\">const</span> Io = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>;\n<span class=\"tok-kw\">const</span> process = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/process/#std.process\">process</a>;\n<span class=\"tok-kw\">const</span> File = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\">File</a>;\n<span class=\"tok-kw\">const</span> assert = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/debug/#std.debug\">debug</a>.<a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\">assert</a>;\n<span class=\"tok-kw\">const</span> Allocator = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>.<a href=\"/zig-docs/zh-cn/std/mem/Allocator/#std.mem.Allocator\">Allocator</a>;\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Id = <span class=\"tok-kw\">switch</span> (<a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.native_os\">native_os</a>) {\n    .windows =&gt; <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/os/#std.os\">os</a>.<a href=\"/zig-docs/zh-cn/std/os/windows/#std.os.windows\">windows</a>.<a href=\"/zig-docs/zh-cn/std/os/windows/#std.os.windows.HANDLE\">HANDLE</a>,\n    .wasi =&gt; <span class=\"tok-type\">void</span>,\n    <span class=\"tok-kw\">else</span> =&gt; <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/posix/#std.posix\">posix</a>.<a href=\"/zig-docs/zh-cn/std/posix/#std.posix.pid_t\">pid_t</a>,\n};\n\n<span class=\"tok-comment\">/// 调用 `wait` 或 `kill` 后，此值变为 `null`。</span>\n<span class=\"tok-comment\">/// 在 Windows 上为 hProcess。</span>\n<span class=\"tok-comment\">/// 在 POSIX 上为 pid。</span>\nid: ?<a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.Id\">Id</a>,\nthread_handle: <span class=\"tok-kw\">if</span> (<a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.native_os\">native_os</a> == .windows) <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/os/#std.os\">os</a>.<a href=\"/zig-docs/zh-cn/std/os/windows/#std.os.windows\">windows</a>.<a href=\"/zig-docs/zh-cn/std/os/windows/#std.os.windows.HANDLE\">HANDLE</a> <span class=\"tok-kw\">else</span> <span class=\"tok-type\">void</span>,\n<span class=\"tok-comment\">/// 子进程标准输入管道的写入端。</span>\n<span class=\"tok-comment\">/// 使用时要求设置 `process.SpawnOptions.StdIo.pipe`。</span>\nstdin: ?<a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\">File</a>,\n<span class=\"tok-comment\">/// 子进程标准输出管道的读取端。</span>\n<span class=\"tok-comment\">/// 使用时要求 `process.SpawnOptions.StdIo.pipe`。</span>\nstdout: ?<a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\">File</a>,\n<span class=\"tok-comment\">/// 子进程标准错误管道的读取端。</span>\n<span class=\"tok-comment\">/// 使用此字段要求设置 `process.SpawnOptions.StdIo.pipe`。</span>\nstderr: ?<a href=\"/zig-docs/zh-cn/std/Io/File/#std.Io.File\">File</a>,\n<span class=\"tok-comment\">/// 如果在调用 `spawn` 之前将</span>\n<span class=\"tok-comment\">/// `request_resource_usage_statistics` 设置为 `true`，</span>\n<span class=\"tok-comment\">/// 则调用 wait 后可获取此数据。</span>\n<span class=\"tok-comment\">/// TODO 将此数据移入 `Term`</span>\nresource_usage_statistics: <a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.ResourceUsageStatistics\">ResourceUsageStatistics</a> = .{},\nrequest_resource_usage_statistics: <span class=\"tok-type\">bool</span>,\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> ResourceUsageStatistics = <span class=\"tok-kw\">struct</span> {\n    rusage: <span class=\"tok-builtin\">@TypeOf</span>(<a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.ResourceUsageStatistics.rusage_init\">rusage_init</a>) = <a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.ResourceUsageStatistics.rusage_init\">rusage_init</a>,\n\n    <span class=\"tok-comment\">/// 若可用，则返回子进程的峰值常驻集大小，单位为字节。</span>\n    <span class=\"tok-comment\">///</span>\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">inline</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">getMaxRss</span>(rus: <a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.ResourceUsageStatistics\">ResourceUsageStatistics</a>) ?<span class=\"tok-type\">usize</span> {\n        <span class=\"tok-kw\">switch</span> (<a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.native_os\">native_os</a>) {\n            .dragonfly, .freebsd, .netbsd, .openbsd, .illumos, .linux, .serenity =&gt; {\n                <span class=\"tok-kw\">if</span> (rus.rusage) |ru| {\n                    <span class=\"tok-kw\">return</span> <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">usize</span>, <span class=\"tok-builtin\">@intCast</span>(ru.maxrss)) * <span class=\"tok-number\">1024</span>;\n                } <span class=\"tok-kw\">else</span> {\n                    <span class=\"tok-kw\">return</span> <span class=\"tok-null\">null</span>;\n                }\n            },\n            .windows =&gt; {\n                <span class=\"tok-kw\">if</span> (rus.rusage) |ru| {\n                    <span class=\"tok-kw\">return</span> ru.PeakWorkingSetSize;\n                } <span class=\"tok-kw\">else</span> {\n                    <span class=\"tok-kw\">return</span> <span class=\"tok-null\">null</span>;\n                }\n            },\n            .driverkit, .ios, .maccatalyst, .macos, .tvos, .visionos, .watchos =&gt; {\n                <span class=\"tok-kw\">if</span> (rus.rusage) |ru| {<span class=\"tok-comment\">\n                    // Darwin 特殊地以字节而非千字节报告。\n                    </span><span class=\"tok-kw\">return</span> <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">usize</span>, <span class=\"tok-builtin\">@intCast</span>(ru.maxrss));\n                } <span class=\"tok-kw\">else</span> {\n                    <span class=\"tok-kw\">return</span> <span class=\"tok-null\">null</span>;\n                }\n            },\n            <span class=\"tok-kw\">else</span> =&gt; <span class=\"tok-kw\">return</span> <span class=\"tok-null\">null</span>,\n        }\n    }\n\n    <span class=\"tok-kw\">const</span> rusage_init = <span class=\"tok-kw\">switch</span> (<a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.native_os\">native_os</a>) {\n        .dragonfly,\n        .freebsd,\n        .netbsd,\n        .openbsd,\n        .illumos,\n        .linux,\n        .serenity,\n        .driverkit,\n        .ios,\n        .maccatalyst,\n        .macos,\n        .tvos,\n        .visionos,\n        .watchos,\n        =&gt; <span class=\"tok-builtin\">@as</span>(?<a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/posix/#std.posix\">posix</a>.<a href=\"/zig-docs/zh-cn/std/posix/#std.posix.rusage\">rusage</a>, <span class=\"tok-null\">null</span>),\n        .windows =&gt; <span class=\"tok-builtin\">@as</span>(?<a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/os/#std.os\">os</a>.<a href=\"/zig-docs/zh-cn/std/os/windows/#std.os.windows\">windows</a>.<a href=\"/zig-docs/zh-cn/std/os/windows/#std.os.windows.PROCESS\">PROCESS</a>.<a href=\"/zig-docs/zh-cn/std/os/windows/#std.os.windows.PROCESS.VM_COUNTERS\">VM_COUNTERS</a>, <span class=\"tok-null\">null</span>),\n        <span class=\"tok-kw\">else</span> =&gt; {},\n    };\n};\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Term = <span class=\"tok-kw\">union</span>(<span class=\"tok-kw\">enum</span>) {\n    exited: <span class=\"tok-type\">u8</span>,\n    signal: <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/posix/#std.posix\">posix</a>.<a href=\"/zig-docs/zh-cn/std/posix/#std.posix.SIG\">SIG</a>,\n    stopped: <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/posix/#std.posix\">posix</a>.<a href=\"/zig-docs/zh-cn/std/posix/#std.posix.SIG\">SIG</a>,\n    unknown: <span class=\"tok-type\">u32</span>,\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">success</span>(t: <a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.Term\">Term</a>) <span class=\"tok-type\">bool</span> {\n        <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">switch</span> (t) {\n            .exited =&gt; |code| code == <span class=\"tok-number\">0</span>,\n            <span class=\"tok-kw\">else</span> =&gt; <span class=\"tok-null\">false</span>,\n        };\n    }\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">format</span>(t: <a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.Term\">Term</a>, w: *<a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/Writer/#std.Io.Writer\">Writer</a>) <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/Writer/#std.Io.Writer\">Writer</a>.<a href=\"/zig-docs/zh-cn/std/Io/Writer/#std.Io.Writer.Error\">Error</a>!<span class=\"tok-type\">void</span> {\n        <span class=\"tok-kw\">switch</span> (t) {\n            .exited =&gt; |code| <span class=\"tok-kw\">return</span> w.print(<span class=\"tok-str\">\"exited with code {d}\"</span>, .{code}),\n            .signal =&gt; |sig| <span class=\"tok-kw\">return</span> w.print(<span class=\"tok-str\">\"terminated with signal {t}\"</span>, .{sig}),\n            .stopped =&gt; |sig| <span class=\"tok-kw\">return</span> w.print(<span class=\"tok-str\">\"stopped with signal {t}\"</span>, .{sig}),\n            .unknown =&gt; <span class=\"tok-kw\">return</span> w.writeAll(<span class=\"tok-str\">\"terminated unexpectedly\"</span>),\n        }\n    }\n};\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Cwd = <span class=\"tok-kw\">union</span>(<span class=\"tok-kw\">enum</span>) {\n    <span class=\"tok-comment\">/// 子进程的当前工作目录与当前进程相同。</span>\n    inherit,\n    <span class=\"tok-comment\">/// POSIX 系统上，在 `fork` 之后使用此句柄调用 `fchdir`。</span>\n    <span class=\"tok-comment\">/// Windows 上，从提供的句柄推导路径，并在调用 `CreateProcessW` 时使用该路径。</span>\n    dir: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/Dir/#std.Io.Dir\">Dir</a>,\n    <span class=\"tok-comment\">/// 在 POSIX 系统上，`fork` 后使用此路径调用 `chdir`。</span>\n    <span class=\"tok-comment\">/// 在 Windows 上，调用 `CreateProcessW` 时使用此路径。</span>\n    path: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>,\n};\n\n<span class=\"tok-comment\">/// 请求操作系统强制终止子进程，</span>\n<span class=\"tok-comment\">/// 然后阻塞至其终止，再清理全部资源。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 幂等；`wait` 返回后不执行任何操作。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 不可取消。忽略操作系统的意外错误。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">kill</span>(child: *<a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child\">Child</a>, io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>) <span class=\"tok-type\">void</span> {\n    <span class=\"tok-kw\">if</span> (child.id == <span class=\"tok-null\">null</span>) {\n        <a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\">assert</a>(child.stdin == <span class=\"tok-null\">null</span>);\n        <a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\">assert</a>(child.stdout == <span class=\"tok-null\">null</span>);\n        <a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\">assert</a>(child.stderr == <span class=\"tok-null\">null</span>);\n        <span class=\"tok-kw\">return</span>;\n    }\n    io.vtable.childKill(io.userdata, child);\n    <a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\">assert</a>(child.id == <span class=\"tok-null\">null</span>);\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> WaitError = <span class=\"tok-kw\">error</span>{\n    AccessDenied,\n} || <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/#std.Io.Cancelable\">Cancelable</a> || <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/#std.Io.UnexpectedError\">UnexpectedError</a>;\n\n<span class=\"tok-comment\">/// 阻塞直到子进程终止，然后清理所有资源。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">wait</span>(child: *<a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child\">Child</a>, io: <a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>) <a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.WaitError\">WaitError</a>!<a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.Term\">Term</a> {\n    <a href=\"/zig-docs/zh-cn/std/debug/#std.debug.assert\">assert</a>(child.id != <span class=\"tok-null\">null</span>);\n    <span class=\"tok-kw\">return</span> io.vtable.childWait(io.userdata, child);\n}\n\n<span class=\"tok-kw\">test</span> {\n    _ = <a href=\"/zig-docs/zh-cn/std/process/Child/#std.process.Child.Term\">Term</a>;\n}\n</code></pre></div></details>"}

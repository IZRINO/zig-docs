> (i + <span class=\"tok-number\">16</span> &lt;= input.len) : (i += <span class=\"tok-number\">16</span>) {\n                <span class=\"tok-kw\">comptime</span> <span class=\"tok-kw\">var</span> j: <span class=\"tok-type\">usize</span> = <span class=\"tok-number\">0</span>;\n                <span class=\"tok-kw\">inline</span> <span class=\"tok-kw\">while</span> (j &lt; <span class=\"tok-number\">16</span>) : (j += <span class=\"tok-number\">1</span>) {\n                    s1 +%= input[i + j];\n                    s2 +%= s1;\n                }\n            }\n            <span class=\"tok-kw\">while</span> (i &lt; input.len) : (i += <span class=\"tok-number\">1</span>) {\n                s1 +%= input[i];\n                s2 +%= s1;\n            }\n\n            s1 %= base;\n            s2 %= base;\n        }\n    }\n\n    <span class=\"tok-kw\">return</span> s1 | (s2 &lt;&lt; <span class=\"tok-number\">16</span>);\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">update</span>(a: *<a href=\"/zig-docs/zh-cn/std/hash/Adler32/#std.hash.Adler32\">Adler32</a>, input: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">void</span> {\n    a.adler = <a href=\"/zig-docs/zh-cn/std/hash/Adler32/#std.hash.Adler32.permute\">permute</a>(a.adler, input);\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">hash</span>(input: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">u32</span> {\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/hash/Adler32/#std.hash.Adler32.permute\">permute</a>(<span class=\"tok-number\">1</span>, input);\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"sanity\"</span> {\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expec
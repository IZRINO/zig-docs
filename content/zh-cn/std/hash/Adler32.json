>\n<a id=\"L70\" href=\"#L70\" tabindex=\"-1\">70</a>\n<a id=\"L71\" href=\"#L71\" tabindex=\"-1\">71</a>\n<a id=\"L72\" href=\"#L72\" tabindex=\"-1\">72</a>\n<a id=\"L73\" href=\"#L73\" tabindex=\"-1\">73</a>\n<a id=\"L74\" href=\"#L74\" tabindex=\"-1\">74</a>\n<a id=\"L75\" href=\"#L75\" tabindex=\"-1\">75</a>\n<a id=\"L76\" href=\"#L76\" tabindex=\"-1\">76</a>\n<a id=\"L77\" href=\"#L77\" tabindex=\"-1\">77</a>\n<a id=\"L78\" href=\"#L78\" tabindex=\"-1\">78</a>\n<a id=\"L79\" href=\"#L79\" tabindex=\"-1\">79</a>\n<a id=\"L80\" href=\"#L80\" tabindex=\"-1\">80</a>\n<a id=\"L81\" href=\"#L81\" tabindex=\"-1\">81</a>\n<a id=\"L82\" href=\"#L82\" tabindex=\"-1\">82</a>\n<a id=\"L83\" href=\"#L83\" tabindex=\"-1\">83</a>\n<a id=\"L84\" href=\"#L84\" tabindex=\"-1\">84</a>\n<a id=\"L85\" href=\"#L85\" tabindex=\"-1\">85</a>\n<a id=\"L86\" href=\"#L86\" tabindex=\"-1\">86</a>\n<a id=\"L87\" href=\"#L87\" tabindex=\"-1\">87</a>\n<a id=\"L88\" href=\"#L88\" tabindex=\"-1\">88</a>\n<a id=\"L89\" href=\"#L89\" tabindex=\"-1\">89</a>\n<a id=\"L90\" href=\"#L90\" tabindex=\"-1\">90</a>\n<a id=\"L91\" href=\"#L91\" tabindex=\"-1\">91</a>\n<a id=\"L92\" href=\"#L92\" tabindex=\"-1\">92</a>\n<a id=\"L93\" href=\"#L93\" tabindex=\"-1\">93</a>\n<a id=\"L94\" href=\"#L94\" tabindex=\"-1\">94</a>\n<a id=\"L95\" href=\"#L95\" tabindex=\"-1\">95</a>\n<a id=\"L96\" href=\"#L96\" tabindex=\"-1\">96</a>\n<a id=\"L97\" href=\"#L97\" tabindex=\"-1\">97</a>\n<a id=\"L98\" href=\"#L98\" tabindex=\"-1\">98</a>\n<a id=\"L99\" href=\"#L99\" tabindex=\"-1\">99</a>\n<a id=\"L100\" href=\"#L100\" tabindex=\"-1\">100</a>\n<a id=\"L101\" href=\"#L101\" tabindex=\"-1\">101</a>\n<a id=\"L102\" href=\"#L102\" tabindex=\"-1\">102</a>\n<a id=\"L103\" href=\"#L103\" tabindex=\"-1\">103</a>\n<a id=\"L104\" href=\"#L104\" tabindex=\"-1\">104</a>\n<a id=\"L105\" href=\"#L105\" tabindex=\"-1\">105</a>\n<a id=\"L106\" href=\"#L106\" tabindex=\"-1\">106</a>\n<a id=\"L107\" href=\"#L107\" tabindex=\"-1\">107</a>\n<a id=\"L108\" href=\"#L108\" tabindex=\"-1\">108</a>\n<a id=\"L109\" href=\"#L109\" tabindex=\"-1\">109</a>\n<a id=\"L110\" href=\"#L110\" tabindex=\"-1\">110</a>\n<a id=\"L111\" href=\"#L111\" tabindex=\"-1\">111</a>\n<a id=\"L112\" href=\"#L112\" tabindex=\"-1\">112</a>\n<a id=\"L113\" href=\"#L113\" tabindex=\"-1\">113</a>\n<a id=\"L114\" href=\"#L114\" tabindex=\"-1\">114</a>\n<a id=\"L115\" href=\"#L115\" tabindex=\"-1\">115</a>\n<a id=\"L116\" href=\"#L116\" tabindex=\"-1\">116</a>\n<a id=\"L117\" href=\"#L117\" tabindex=\"-1\">117</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">//! https://tools.ietf.org/html/rfc1950#section-9</span>\n<span class=\"tok-comment\">//! https://github.com/madler/zlib/blob/master/adler32.c</span>\n\n<span class=\"tok-kw\">const</span> Adler32 = <span class=\"tok-builtin\">@This</span>();\n<span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n<span class=\"tok-kw\">const</span> testing = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>;\n\nadler: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">1</span>,\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">permute</span>(state: <span class=\"tok-type\">u32</span>, input: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">u32</span> {\n    <span class=\"tok-kw\">const</span> base = <span class=\"tok-number\">65521</span>;\n    <span class=\"tok-kw\">const</span> nmax = <span class=\"tok-number\">5552</span>;\n\n    <span class=\"tok-kw\">var</span> s1 = state &amp; <span class=\"tok-number\">0xffff</span>;\n    <span class=\"tok-kw\">var</span> s2 = (state &gt;&gt; <span class=\"tok-number\">16</span>) &amp; <span class=\"tok-number\">0xffff</span>;\n\n    <span class=\"tok-kw\">if</span> (input.len == <span class
d=\"L216\" href=\"#L216\" tabindex=\"-1\">216</a>\n<a id=\"L217\" href=\"#L217\" tabindex=\"-1\">217</a>\n<a id=\"L218\" href=\"#L218\" tabindex=\"-1\">218</a>\n<a id=\"L219\" href=\"#L219\" tabindex=\"-1\">219</a>\n<a id=\"L220\" href=\"#L220\" tabindex=\"-1\">220</a>\n<a id=\"L221\" href=\"#L221\" tabindex=\"-1\">221</a>\n<a id=\"L222\" href=\"#L222\" tabindex=\"-1\">222</a>\n<a id=\"L223\" href=\"#L223\" tabindex=\"-1\">223</a>\n<a id=\"L224\" href=\"#L224\" tabindex=\"-1\">224</a>\n<a id=\"L225\" href=\"#L225\" tabindex=\"-1\">225</a>\n<a id=\"L226\" href=\"#L226\" tabindex=\"-1\">226</a>\n<a id=\"L227\" href=\"#L227\" tabindex=\"-1\">227</a>\n<a id=\"L228\" href=\"#L228\" tabindex=\"-1\">228</a>\n<a id=\"L229\" href=\"#L229\" tabindex=\"-1\">229</a>\n<a id=\"L230\" href=\"#L230\" tabindex=\"-1\">230</a>\n<a id=\"L231\" href=\"#L231\" tabindex=\"-1\">231</a>\n<a id=\"L232\" href=\"#L232\" tabindex=\"-1\">232</a>\n<a id=\"L233\" href=\"#L233\" tabindex=\"-1\">233</a>\n<a id=\"L234\" href=\"#L234\" tabindex=\"-1\">234</a>\n<a id=\"L235\" href=\"#L235\" tabindex=\"-1\">235</a>\n<a id=\"L236\" href=\"#L236\" tabindex=\"-1\">236</a>\n<a id=\"L237\" href=\"#L237\" tabindex=\"-1\">237</a>\n<a id=\"L238\" href=\"#L238\" tabindex=\"-1\">238</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">//! 使用 SSE4.2 Intel CRC32 指令实现 CRC-32C（Castagnoli）。</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! 以下链接有助于理解此处采用的方法：</span>\n<span class=\"tok-comment\">//! - https://github.com/madler/brotli/blob/1d428d3a9baade233ebc3ac108293256bcb813d1/crc32c.c</span>\n<span class=\"tok-comment\">//! - https://github.com/madler/zlib/blob/5a82f71ed1dfc0bec044d9702463dbdf84ea3b71/crc32.c</span>\n<span class=\"tok-comment\">//! - http://www.ross.net/crc/download/crc_v3.txt</span><span class=\"tok-comment\">\n\n// 以二进制形式表示的反射 CRC-32C 多项式。\n</span><span class=\"tok-kw\">const</span> POLY = <span class=\"tok-number\">0x82f63b78</span>;\n\n<span class=\"tok-kw\">const</span> LONG = <span class=\"tok-number\">8192</span>;\n<span class=\"tok-kw\">const</span> SHORT = <span class=\"tok-number\">256</span>;\n<span class=\"tok-kw\">const</span> long_lookup_table = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.genTable\">genTable</a>(<a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.LONG\">LONG</a>);\n<span class=\"tok-kw\">const</span> short_lookup_table = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.genTable\">genTable</a>(<a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.SHORT\">SHORT</a>);\n\n<span class=\"tok-kw\">const</span> Wrapper = <span class=\"tok-builtin\">@This</span>();\n\ncrc: <span class=\"tok-type\">u32</span>,\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">init</span>() <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c\">Wrapper</a> {\n    <span class=\"tok-kw\">return</span> .{ .crc = <span class=\"tok-number\">0</span> };\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">update</span>(w: *<a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c\">Wrapper</a>, bytes: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">void</span> {\n    w.crc = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.crc32\">crc32</a>(w.crc, bytes);\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">final</span>(w: <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c\">Wrapper</a>) <span class=\"tok-type\">u32</span> {\n    <span class=\"tok-kw\">return</span> w.crc;\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">hash</span>(bytes: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">u32</span> {\n    <span class=\"tok-kw\">var</span> c = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.init\">init</a>();\n    c.update(bytes);\n    <span class=\"tok-kw\">return</span> c.final();\n}\n\n<span class=\"tok-comment\">/// 为高效合并长度为 `length` 的数据块上的 CRC，生成查找表。</span>\n<span class=\"tok-comment\">/// 其做法是构造一个运算符，使 CRC 状态前进到仿佛已追加 `length` 个零字节后的状态。</span>\n<span class=\"tok-comment\">/// 我们预先计算 4 张表，每张包含 256 个条目，分别对应一个字节偏移。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 这张表背后的思路相当有趣。CRC 状态等价于消息多项式（定义在 GF(2) 上）除以 CRC 多项式所得的余数。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 将 CRC 寄存器前进 `k` 个零位，等价于将当前 CRC 状态乘以 `x^k`，再对 CRC 多项式取模。此运算可表示为 GF(2) 上的线性变换，也就是矩阵。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 我们通过重复平方构造该矩阵：</span>\n<span class=\"tok-comment\">/// - odd 表示前进 1 个零位的运算符（即乘以 `x^1 mod POLY`）</span>\n<span class=\"tok-comment\">/// - even 表示前进 2 个零位的运算符（`x^2 mod POLY`）</span>\n<span class=\"tok-comment\">/// - 再平方得到 `x^4 mod POLY`，依此类推，直到达到所需大小。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 通过对移位后的 `len` 逐次平方，构造 `x^l mod POLY` 对应的运算符。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">genTable</span>(length: <span class=\"tok-type\">usize</span>) [<span class=\"tok-number\">4</span>][<span class=\"tok-number\">256</span>]<span class=\"tok-type\">u32</span> {\n    <span class=\"tok-builtin\">@setEvalBranchQuota</span>(<span class=\"tok-number\">250000</span>);\n\n    <span class=\"tok-kw\">var</span> even: [<span class=\"tok-number\">32</span>]<span class=\"tok-type\">u32</span> = <span class=\"tok-null\">undefined</span>;\n    zeroes: {\n        <span class=\"tok-kw\">var</span> odd: [<span class=\"tok-number\">32</span>]<span class=\"tok-type\">u32</span> = <span class=\"tok-null\">undefined</span>;<span class=\"tok-comment\">\n\n        // 使用单个零位的运算符初始化 `odd` 数组：\n        // - odd[0] 是多项式本身（作用于最高有效位）。\n        // - odd[1..32] 表示将单个位移过 31 个位置。\n        </span>odd[<span class=\"tok-number\">0</span>] = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.POLY\">POLY</a>;\n        <span class=\"tok-kw\">var</span> row: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">1</span>;\n        <span class=\"tok-kw\">for</span> (<span class=\"tok-number\">1</span>..<span class=\"tok-number\">32</span>) |n| {\n            odd[n] = row;\n            row &lt;&lt;= <span class=\"tok-number\">1</span>;\n        }<span class=\"tok-comment\">\n\n        // even = odd 的平方：even 表示 `x^2 mod POLY`。\n        </span><a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.square\">square</a>(&amp;even, &amp;odd);<span class=\"tok-comment\">\n        // odd = even 的平方：此时 odd 表示 `x^4 mod POLY`。\n        </span><a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.square\">square</a>(&amp;odd, &amp;even);<span class=\"tok-comment\">\n\n        // 继续平方，使每次编码的零的数量翻倍：\n        //\n        // 在过程的每一步：\n        // - square(even, odd)：even 获得对应当前长度两倍的算子。\n        // - square(odd, even)：odd 获得对应原始长度四倍的算子。\n        </span><span class=\"tok-kw\">var</span> len = length;\n        <span class=\"tok-kw\">while</span> (<span class=\"tok-null\">true</span>) {\n            <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.square\">square</a>(&amp;even, &amp;odd);\n            len &gt;&gt;= <span class=\"tok-number\">1</span>;\n            <span class=\"tok-kw\">if</span> (len == <span class=\"tok-number\">0</span>) <span class=\"tok-kw\">break</span> :zeroes;\n            <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.square\">square</a>(&amp;odd, &amp;even);\n            len &gt;&gt;= <span class=\"tok-number\">1</span>;\n            <span class=\"tok-kw\">if</span> (len == <span class=\"tok-number\">0</span>) <span class=\"tok-kw\">break</span>;\n        }\n\n        <span class=\"tok-builtin\">@memcpy</span>(&amp;even, &amp;odd);\n    }\n\n    <span class=\"tok-kw\">var</span> zeroes: [<span class=\"tok-number\">4</span>][<span class=\"tok-number\">256</span>]<span class=\"tok-type\">u32</span> = <span class=\"tok-null\">undefined</span>;\n    <span class=\"tok-kw\">for</span> (<span class=\"tok-number\">0</span>..<span class=\"tok-number\">256</span>) |n| {\n        zeroes[<span class=\"tok-number\">0</span>][n] = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.times\">times</a>(&amp;even, n);\n        zeroes[<span class=\"tok-number\">1</span>][n] = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.times\">times</a>(&amp;even, n &lt;&lt; <span class=\"tok-number\">8</span>);\n        zeroes[<span class=\"tok-number\">2</span>][n] = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.times\">times</a>(&amp;even, n &lt;&lt; <span class=\"tok-number\">16</span>);\n        zeroes[<span class=\"tok-number\">3</span>][n] = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.times\">times</a>(&amp;even, n &lt;&lt; <span class=\"tok-number\">24</span>);\n    }\n    <span class=\"tok-kw\">return</span> zeroes;\n}\n\n<span class=\"tok-comment\">/// 计算 `mat * vec`，运算位于 `GF(2)`，其中 `mat` 为 32×32 二进制矩阵，`vec`</span>\n<span class=\"tok-comment\">/// 为 32 位向量。这在某种程度上“模拟”了移位时</span>\n<span class=\"tok-comment\">/// 各位在 CRC 寄存器中的传播。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// - 在 GF(2)，即只含 0 和 1 的二元域中，乘法</span>\n<span class=\"tok-comment\">/// 对应 `AND`，加法对应 `XOR`。</span>\n<span class=\"tok-comment\">/// - 此点积对 `vec` 中值为 1 的位所对应的矩阵行进行异或，即相加，</span>\n<span class=\"tok-comment\">/// 从而确定输入向量各位对最终 CRC 状态的“贡献”。</span>\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">times</span>(mat: *<span class=\"tok-kw\">const</span> [<span class=\"tok-number\">32</span>]<span class=\"tok-type\">u32</span>, vec: <span class=\"tok-type\">u32</span>) <span class=\"tok-type\">u32</span> {\n    <span class=\"tok-kw\">var</span> sum: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">0</span>;\n    <span class=\"tok-kw\">var</span> v = vec;\n    <span class=\"tok-kw\">var</span> i: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">0</span>;\n    <span class=\"tok-kw\">while</span> (v != <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-kw\">if</span> (v &amp; <span class=\"tok-number\">1</span> != <span class=\"tok-number\">0</span>) sum ^= mat[i];\n        v &gt;&gt;= <span class=\"tok-number\">1</span>;\n        i += <span class=\"tok-number\">1</span>;\n    }\n    <span class=\"tok-kw\">return</span> sum;\n}\n\n<span class=\"tok-comment\">/// 计算 GF(2) 上矩阵的平方，即 `dst = dst x src`。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 这会生成将零的数量加倍的算子：若 `src` 表示将 CRC 向前推进 `k` 个零，则 `dest` 表示向前推进 2k 个零。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 由于模 POLY 的多项式乘法是线性的，`mat(mat(x)) = mat^2(x)` 具有连续应用两次算子的效果。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">square</span>(dst: *[<span class=\"tok-number\">32</span>]<span class=\"tok-type\">u32</span>, src: *<span class=\"tok-kw\">const</span> [<span class=\"tok-number\">32</span>]<span class=\"tok-type\">u32</span>) <span class=\"tok-type\">void</span> {\n    <span class=\"tok-kw\">for</span> (dst, src) |*d, s| {\n        d.* = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.times\">times</a>(src, s);\n    }\n}\n\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">shift</span>(table: *<span class=\"tok-kw\">const</span> [<span class=\"tok-number\">4</span>][<span class=\"tok-number\">256</span>]<span class=\"tok-type\">u32</span>, crc: <span class=\"tok-type\">u32</span>) <span class=\"tok-type\">u32</span> {\n    <span class=\"tok-kw\">return</span> table[<span class=\"tok-number\">0</span>][crc &amp; <span class=\"tok-number\">0xFF</span>] ^ table[<span class=\"tok-number\">1</span>][(crc &gt;&gt; <span class=\"tok-number\">8</span>) &amp; <span class=\"tok-number\">0xFF</span>] ^ table[<span class=\"tok-number\">2</span>][(crc &gt;&gt; <span class=\"tok-number\">16</span>) &amp; <span class=\"tok-number\">0xFF</span>] ^ table[<span class=\"tok-number\">3</span>][crc &gt;&gt; <span class=\"tok-number\">24</span>];\n}\n\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">crc32</span>(crc: <span class=\"tok-type\">u32</span>, input: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">u32</span> {\n    <span class=\"tok-kw\">var</span> crc0: <span class=\"tok-type\">u64</span> = ~crc;<span class=\"tok-comment\">\n\n    // 计算最多七个前导字节的 CRC，\n    // 使 `next` 指针对齐到八字节边界。\n    </span><span class=\"tok-kw\">var</span> next = input;\n    <span class=\"tok-kw\">while</span> (next.len &gt; <span class=\"tok-number\">0</span> <span class=\"tok-kw\">and</span> <span class=\"tok-builtin\">@intFromPtr</span>(next.ptr) &amp; <span class=\"tok-number\">7</span> != <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-kw\">asm</span> <span class=\"tok-kw\">volatile</span> (<span class=\"tok-str\">\"crc32b %[out], %[in]\"</span>\n            : [in] <span class=\"tok-str\">\"+r\"</span> (crc0),\n            : [out] <span class=\"tok-str\">\"rm\"</span> (next[<span class=\"tok-number\">0</span>]),\n        );\n        next = next[<span class=\"tok-number\">1</span>..];\n    }<span class=\"tok-comment\">\n\n    // 针对每组 LONG * 3 字节计算 CRC，执行三条彼此独立的\n    // CRC 指令，每条处理 LONG 字节。当目标上的 CRC 指令吞吐率为每\n    // 周期一条、延迟为三个周期时，此操作可提高性能。\n    //\n    </span><span class=\"tok-kw\">while</span> (next.len &gt;= <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.LONG\">LONG</a> * <span class=\"tok-number\">3</span>) {\n        <span class=\"tok-kw\">var</span> crc1: <span class=\"tok-type\">u64</span> = <span class=\"tok-number\">0</span>;\n        <span class=\"tok-kw\">var</span> crc2: <span class=\"tok-type\">u64</span> = <span class=\"tok-number\">0</span>;\n\n        <span class=\"tok-kw\">const</span> start = next.len;\n        <span class=\"tok-kw\">while</span> (<span class=\"tok-null\">true</span>) {<span class=\"tok-comment\">\n            // @alignCast() 是安全的，因为在此循环之前已将指针对齐到 8 字节。\n            </span><span class=\"tok-kw\">const</span> long: [*]<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u64</span> = <span class=\"tok-builtin\">@ptrCast</span>(<span class=\"tok-builtin\">@alignCast</span>(next));\n            <span class=\"tok-kw\">asm</span> <span class=\"tok-kw\">volatile</span> (\n                <span class=\"tok-str\">\\\\crc32q %[out0], %[in0]</span>\n                <span class=\"tok-str\">\\\\crc32q %[out1], %[in1]</span>\n                <span class=\"tok-str\">\\\\crc32q %[out2], %[in2]</span>\n                : [in0] <span class=\"tok-str\">\"+r\"</span> (crc0),\n                  [in1] <span class=\"tok-str\">\"+r\"</span> (crc1),\n                  [in2] <span class=\"tok-str\">\"+r\"</span> (crc2),\n                : [out0] <span class=\"tok-str\">\"rm\"</span> (long[<span class=\"tok-number\">0</span> * LONG / <span class=\"tok-number\">8</span>]),\n                  [out1] <span class=\"tok-str\">\"rm\"</span> (long[<span class=\"tok-number\">1</span> * LONG / <span class=\"tok-number\">8</span>]),\n                  [out2] <span class=\"tok-str\">\"rm\"</span> (long[<span class=\"tok-number\">2</span> * LONG / <span class=\"tok-number\">8</span>]),\n            );\n            next = next[<span class=\"tok-number\">8</span>..];\n            <span class=\"tok-kw\">if</span> (next.len &lt;= start - <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.LONG\">LONG</a>) <span class=\"tok-kw\">break</span>;\n        }\n\n        crc0 = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.shift\">shift</a>(&amp;<a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.long_lookup_table\">long_lookup_table</a>, <span class=\"tok-builtin\">@truncate</span>(crc0)) ^ crc1;\n        crc0 = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.shift\">shift</a>(&amp;<a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.long_lookup_table\">long_lookup_table</a>, <span class=\"tok-builtin\">@truncate</span>(crc0)) ^ crc2;\n        next = next[<a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.LONG\">LONG</a> * <span class=\"tok-number\">2</span> ..];\n    }<span class=\"tok-comment\">\n\n    // 与上面相同，但处理较小的 SHORT 字节块。\n    </span><span class=\"tok-kw\">while</span> (next.len &gt;= <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.SHORT\">SHORT</a> * <span class=\"tok-number\">3</span>) {\n        <span class=\"tok-kw\">var</span> crc1: <span class=\"tok-type\">u64</span> = <span class=\"tok-number\">0</span>;\n        <span class=\"tok-kw\">var</span> crc2: <span class=\"tok-type\">u64</span> = <span class=\"tok-number\">0</span>;\n\n        <span class=\"tok-kw\">const</span> start = next.len;\n        <span class=\"tok-kw\">while</span> (<span class=\"tok-null\">true</span>) {\n            <span class=\"tok-kw\">const</span> long: [*]<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u64</span> = <span class=\"tok-builtin\">@ptrCast</span>(<span class=\"tok-builtin\">@alignCast</span>(next));\n            <span class=\"tok-kw\">asm</span> <span class=\"tok-kw\">volatile</span> (\n                <span class=\"tok-str\">\\\\crc32q %[out0], %[in0]</span>\n                <span class=\"tok-str\">\\\\crc32q %[out1], %[in1]</span>\n                <span class=\"tok-str\">\\\\crc32q %[out2], %[in2]</span>\n                : [in0] <span class=\"tok-str\">\"+r\"</span> (crc0),\n                  [in1] <span class=\"tok-str\">\"+r\"</span> (crc1),\n                  [in2] <span class=\"tok-str\">\"+r\"</span> (crc2),\n                : [out0] <span class=\"tok-str\">\"rm\"</span> (long[<span class=\"tok-number\">0</span> * SHORT / <span class=\"tok-number\">8</span>]),\n                  [out1] <span class=\"tok-str\">\"rm\"</span> (long[<span class=\"tok-number\">1</span> * SHORT / <span class=\"tok-number\">8</span>]),\n                  [out2] <span class=\"tok-str\">\"rm\"</span> (long[<span class=\"tok-number\">2</span> * SHORT / <span class=\"tok-number\">8</span>]),\n            );\n            next = next[<span class=\"tok-number\">8</span>..];\n            <span class=\"tok-kw\">if</span> (next.len &lt;= start - <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.SHORT\">SHORT</a>) <span class=\"tok-kw\">break</span>;\n        }\n\n        crc0 = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.shift\">shift</a>(&amp;<a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.short_lookup_table\">short_lookup_table</a>, <span class=\"tok-builtin\">@truncate</span>(crc0)) ^ crc1;\n        crc0 = <a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.shift\">shift</a>(&amp;<a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.short_lookup_table\">short_lookup_table</a>, <span class=\"tok-builtin\">@truncate</span>(crc0)) ^ crc2;\n        next = next[<a href=\"/zig-docs/zh-cn/std/hash/crc/Crc32c/#std.hash.crc.Crc32c.SHORT\">SHORT</a> * <span class=\"tok-number\">2</span> ..];\n    }<span class=\"tok-comment\">\n\n    // 按 8 字节数据块计算，直到剩余数据不足 8 字节。\n    </span><span class=\"tok-kw\">while</span> (next.len &gt;= <span class=\"tok-number\">8</span>) {\n        <span class=\"tok-kw\">const</span> long: [*]<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u64</span> = <span class=\"tok-builtin\">@ptrCast</span>(<span class=\"tok-builtin\">@alignCast</span>(next));\n        <span class=\"tok-kw\">asm</span> <span class=\"tok-kw\">volatile</span> (<span class=\"tok-str\">\"crc32q %[out], %[in]\"</span>\n            : [in] <span class=\"tok-str\">\"+r\"</span> (crc0),\n            : [out] <span class=\"tok-str\">\"rm\"</span> (long[<span class=\"tok-number\">0</span>]),\n        );\n        next = next[<span class=\"tok-number\">8</span>..];\n    }<span class=\"tok-comment\">\n\n    // 仅使用单条指令处理最后几个字节。\n    </span><span class=\"tok-kw\">while</span> (next.len &gt; <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-kw\">asm</span> <span class=\"tok-kw\">volatile</span> (<span class=\"tok-str\">\"crc32b %[out], %[in]\"</span>\n            : [in] <span class=\"tok-str\">\"+r\"</span> (crc0),\n            : [out] <span class=\"tok-str\">\"rm\"</span> (next[<span class=\"tok-number\">0</span>]),\n        );\n        next = next[<span class=\"tok-number\">1</span>..];\n    }\n\n    <span class=\"tok-kw\">return</span> <span class=\"tok-builtin\">@truncate</span>(~crc0);\n}\n</code></pre></div></details>"}

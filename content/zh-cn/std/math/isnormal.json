t</span> increment_exp = <span class=\"tok-number\">1</span> &lt;&lt; <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatMantissaBits\">floatMantissaBits</a>(T);\n    <span class=\"tok-kw\">const</span> remove_sign = ~<span class=\"tok-builtin\">@as</span>(TBits, <span class=\"tok-number\">0</span>) &gt;&gt; <span class=\"tok-number\">1</span>;<span class=\"tok-comment\">\n\n    // 将指数加 1，如果溢出为 0 或变成 1，\n    // 则它原本全为零，即次正规数，或全为一，即特殊值 inf／nan。\n    // 移除符号位，因为全一时会溢出到该位。\n    // 对于 f80，虽然显式存储了整数部分，\n    // 但两者不一致时，实际上以指数为准。\n    </span><span class=\"tok-kw\">const</span> value = <span class=\"tok-builtin\">@as</span>(TBits, <span class=\"tok-builtin\">@bitCast</span>(x)) +% increment_exp;\n    <span class=\"tok-kw\">return</span> value &amp; remove_sign &gt;= (increment_exp &lt;&lt; <span class=\"tok-number\">1</span>);\n}\n\n<span class=\"tok-kw\">test</span> isNormal {<span class=\"tok-comment\">\n    // TODO：math.inf(T) 支持后，添加 `c_longdouble' 类型\n    </span><span class=\"tok-kw\">inline</span> <span class=\"tok-kw\">for</span> ([_]<span class=\"tok-type\">type</span>{ <span class=\"tok-type\">f16</span>, <span class=\"tok-type\">f32</span>, <span class=\"tok-type\">f64</span>, <span class=\"tok-type\">f80</span>, <span class=\"tok-type\">f128</span> }) |T| {\n        <span class=\"tok-kw\">const</span> TBits = <span class=\"tok-builtin\">@Int</span>(.unsigned, <span class=\"tok-builtin\">@bitSizeOf</span>(T));<span class=\"tok-comment\">\n\n        // 正规数\n        </span><span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(<span class=\"tok-builtin\">@as</span>(T, <span class=\"tok-number\">1.0</span>)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatMin\">floatMin</a>(T)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatMax\">floatMax</a>(T)));<span class=\"tok-comment\">\n\n        // 次正规数\n        </span><span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(<span class=\"tok-builtin\">@as</span>(T, -<span class=\"tok-number\">0.0</span>)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(<span class=\"tok-builtin\">@as</span>(T, <span class=\"tok-number\">0.0</span>)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(<span class=\"tok-builtin\">@as</span>(T, <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatTrueMin\">floatTrueMin</a>(T))));<span class=\"tok-comment\">\n\n        // 最大的次正规数\n        </span><span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(<span class=\"tok-builtin\">@as</span>(T, <span class=\"tok-builtin\">@bitCast</span>(~(~<span class=\"tok-builtin\">@as</span>(TBits, <span class=\"tok-number\">0</span>) &lt;&lt; <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatFractionalBits\">floatFractionalBits</a>(T))))));<span class=\"tok-comment\">\n\n        // 非有限数\n        </span><span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(-<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.inf\">inf</a>(T)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.inf\">inf</a>(T)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.nan\">nan</a>(T)));<span class=\"tok-comment\">\n\n        // 溢出边界情况（实现中有所说明，另见 #10133）。\n        </span><span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isnormal/#std.math.isnormal.isNormal\">isNormal</a>(<span class=\"tok-builtin\">@as</span>(T, <span class=\"tok-builtin\">@bitCast</span>(~<span class=\"tok-builtin\">@as</span>(TBits, <span class=\"tok-number\">0</span>)))));\n    }\n}\n</code></pre></div></details>"}

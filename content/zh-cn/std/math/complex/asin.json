n/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>;\n<span class=\"tok-kw\">const</span> math = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>;\n<span class=\"tok-kw\">const</span> cmath = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex\">complex</a>;\n<span class=\"tok-kw\">const</span> Complex = <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex\">cmath</a>.<a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>;<span class=\"tok-comment\">\n\n// 返回 z 的反正弦。\n</span><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">asin</span>(z: <span class=\"tok-kw\">anytype</span>) <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-builtin\">@TypeOf</span>(z.re, z.im)) {\n    <span class=\"tok-kw\">const</span> T = <span class=\"tok-builtin\">@TypeOf</span>(z.re, z.im);\n    <span class=\"tok-kw\">const</span> x = z.re;\n    <span class=\"tok-kw\">const</span> y = z.im;\n\n    <span class=\"tok-kw\">const</span> p = <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(T).init(<span class=\"tok-number\">1.0</span> - (x - y) * (x + y), -<span class=\"tok-number\">2.0</span> * x * y);\n    <span class=\"tok-kw\">const</span> q = <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(T).init(-y, x);\n    <span class=\"tok-kw\">const</span> r = <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex\">cmath</a>.<a href=\"/zig-docs/zh-cn/std/math/complex/log/#std.math.complex.log.log\">log</a>(q.add(<a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex\">cmath</a>.<a href=\"/zig-docs/zh-cn/std/math/complex/sqrt/#std.math.complex.sqrt.sqrt\">sqrt</a>(p)));\n\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(T).init(r.im, -r.re);\n}\n\n<span class=\"tok-kw\">test</span> asin {\n    <span class=\"tok-kw\">const</span> epsilon = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatEps\">floatEps</a>(<span class=\"tok-type\">f32</span>);\n    <span class=\"tok-kw\">const</span> a = <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>).init(<span class=\"tok-number\">5</span>, <span class=\"tok-number\">3</span>);\n    <span class=\"tok-kw\">const</span> c = <a href=\"/zig-docs/zh-cn/std/math/complex/asin/#std.math.complex.asin.asin\">asin</a>(a);\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expectApproxEqAbs\">expectApproxEqAbs</a>(<span class=\"tok-number\">1.0238227</span>, c.re, epsilon);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expectApproxEqAbs\">expectApproxEqAbs</a>(<span class=\"tok-number\">2.4529128</span>, c.im, epsilon);\n}\n</code></pre></div></details>"}

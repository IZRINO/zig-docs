.testing\">testing</a>;\n<span class=\"tok-kw\">const</span> math = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>;\n<span class=\"tok-kw\">const</span> cmath = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex\">complex</a>;\n<span class=\"tok-kw\">const</span> Complex = <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex\">cmath</a>.<a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>;\n\n<span class=\"tok-comment\">/// 返回 z 的复数 c 次幂。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">pow</span>(z: <span class=\"tok-kw\">anytype</span>, s: <span class=\"tok-kw\">anytype</span>) <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-builtin\">@TypeOf</span>(z.re, z.im, s.re, s.im)) {\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex\">cmath</a>.<a href=\"/zig-docs/zh-cn/std/math/complex/exp/#std.math.complex.exp.exp\">exp</a>(<a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex\">cmath</a>.<a href=\"/zig-docs/zh-cn/std/math/complex/log/#std.math.complex.log.log\">log</a>(z).mul(s));\n}\n\n<span class=\"tok-kw\">test</span> pow {\n    <span class=\"tok-kw\">const</span> epsilon = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.floatEps\">floatEps</a>(<span class=\"tok-type\">f32</span>);\n    <span class=\"tok-kw\">const</span> a = <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>).init(<span class=\"tok-number\">5</span>, <span class=\"tok-number\">3</span>);\n    <span class=\"tok-kw\">const</span> b = <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>).init(<span class=\"tok-number\">2.3</span>, -<span class=\"tok-number\">1.3</span>);\n    <span class=\"tok-kw\">const</span> c = <a href=\"/zig-docs/zh-cn/std/math/complex/pow/#std.math.complex.pow.pow\">pow</a>(a, b);\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expectApproxEqAbs\">expectApproxEqAbs</a>(<span class=\"tok-number\">58.049110</span>, c.re, epsilon);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expectApproxEqAbs\">expectApproxEqAbs</a>(-<span class=\"tok-number\">101.003433</span>, c.im, epsilon);\n}\n</code></pre></div></details>"}

\" href=\"#L88\" tabindex=\"-1\">88</a>\n<a id=\"L89\" href=\"#L89\" tabindex=\"-1\">89</a>\n<a id=\"L90\" href=\"#L90\" tabindex=\"-1\">90</a>\n<a id=\"L91\" href=\"#L91\" tabindex=\"-1\">91</a>\n<a id=\"L92\" href=\"#L92\" tabindex=\"-1\">92</a>\n<a id=\"L93\" href=\"#L93\" tabindex=\"-1\">93</a>\n<a id=\"L94\" href=\"#L94\" tabindex=\"-1\">94</a>\n<a id=\"L95\" href=\"#L95\" tabindex=\"-1\">95</a>\n<a id=\"L96\" href=\"#L96\" tabindex=\"-1\">96</a>\n<a id=\"L97\" href=\"#L97\" tabindex=\"-1\">97</a>\n<a id=\"L98\" href=\"#L98\" tabindex=\"-1\">98</a>\n<a id=\"L99\" href=\"#L99\" tabindex=\"-1\">99</a>\n<a id=\"L100\" href=\"#L100\" tabindex=\"-1\">100</a>\n<a id=\"L101\" href=\"#L101\" tabindex=\"-1\">101</a>\n<a id=\"L102\" href=\"#L102\" tabindex=\"-1\">102</a>\n<a id=\"L103\" href=\"#L103\" tabindex=\"-1\">103</a>\n<a id=\"L104\" href=\"#L104\" tabindex=\"-1\">104</a>\n<a id=\"L105\" href=\"#L105\" tabindex=\"-1\">105</a>\n<a id=\"L106\" href=\"#L106\" tabindex=\"-1\">106</a>\n<a id=\"L107\" href=\"#L107\" tabindex=\"-1\">107</a>\n<a id=\"L108\" href=\"#L108\" tabindex=\"-1\">108</a>\n<a id=\"L109\" href=\"#L109\" tabindex=\"-1\">109</a>\n<a id=\"L110\" href=\"#L110\" tabindex=\"-1\">110</a>\n<a id=\"L111\" href=\"#L111\" tabindex=\"-1\">111</a>\n<a id=\"L112\" href=\"#L112\" tabindex=\"-1\">112</a>\n<a id=\"L113\" href=\"#L113\" tabindex=\"-1\">113</a>\n<a id=\"L114\" href=\"#L114\" tabindex=\"-1\">114</a>\n<a id=\"L115\" href=\"#L115\" tabindex=\"-1\">115</a>\n<a id=\"L116\" href=\"#L116\" tabindex=\"-1\">116</a>\n<a id=\"L117\" href=\"#L117\" tabindex=\"-1\">117</a>\n<a id=\"L118\" href=\"#L118\" tabindex=\"-1\">118</a>\n<a id=\"L119\" href=\"#L119\" tabindex=\"-1\">119</a>\n<a id=\"L120\" href=\"#L120\" tabindex=\"-1\">120</a>\n<a id=\"L121\" href=\"#L121\" tabindex=\"-1\">121</a>\n<a id=\"L122\" href=\"#L122\" tabindex=\"-1\">122</a>\n<a id=\"L123\" href=\"#L123\" tabindex=\"-1\">123</a>\n<a id=\"L124\" href=\"#L124\" tabindex=\"-1\">124</a>\n<a id=\"L125\" href=\"#L125\" tabindex=\"-1\">125</a>\n<a id=\"L126\" href=\"#L126\" tabindex=\"-1\">126</a>\n<a id=\"L127\" href=\"#L127\" tabindex=\"-1\">127</a>\n<a id=\"L128\" href=\"#L128\" tabindex=\"-1\">128</a>\n<a id=\"L129\" href=\"#L129\" tabindex=\"-1\">129</a>\n<a id=\"L130\" href=\"#L130\" tabindex=\"-1\">130</a>\n<a id=\"L131\" href=\"#L131\" tabindex=\"-1\">131</a>\n<a id=\"L132\" href=\"#L132\" tabindex=\"-1\">132</a>\n<a id=\"L133\" href=\"#L133\" tabindex=\"-1\">133</a>\n<a id=\"L134\" href=\"#L134\" tabindex=\"-1\">134</a>\n<a id=\"L135\" href=\"#L135\" tabindex=\"-1\">135</a>\n<a id=\"L136\" href=\"#L136\" tabindex=\"-1\">136</a>\n<a id=\"L137\" href=\"#L137\" tabindex=\"-1\">137</a>\n<a id=\"L138\" href=\"#L138\" tabindex=\"-1\">138</a>\n<a id=\"L139\" href=\"#L139\" tabindex=\"-1\">139</a>\n<a id=\"L140\" href=\"#L140\" tabindex=\"-1\">140</a>\n<a id=\"L141\" href=\"#L141\" tabindex=\"-1\">141</a>\n<a id=\"L142\" href=\"#L142\" tabindex=\"-1\">142</a>\n<a id=\"L143\" href=\"#L143\" tabindex=\"-1\">143</a>\n<a id=\"L144\" href=\"#L144\" tabindex=\"-1\">144</a>\n<a id=\"L145\" href=\"#L145\" tabindex=\"-1\">145</a>\n<a id=\"L146\" href=\"#L146\" tabindex=\"-1\">146</a>\n<a id=\"L147\" href=\"#L147\" tabindex=\"-1\">147</a>\n<a id=\"L148\" href=\"#L148\" tabindex=\"-1\">148</a>\n<a id=\"L149\" href=\"#L149\" tabindex=\"-1\">149</a>\n<a id=\"L150\" href=\"#L150\" tabindex=\"-1\">150</a>\n<a id=\"L151\" href=\"#L151\" tabindex=\"-1\">151</a>\n<a id=\"L152\" href=\"#L152\" tabindex=\"-1\">152</a>\n<a id=\"L153\" href=\"#L153\" tabindex=\"-1\">153</a>\n<a id=\"L154\" href=\"#L154\" tabindex=\"-1\">154</a>\n<a id=\"L155\" href=\"#L155\" tabindex=\"-1\">155</a>\n<a id=\"L156\" href=\"#L156\" tabindex=\"-1\">156</a>\n<a id=\"L157\" href=\"#L157\" tabindex=\"-1\">157</a>\n<a id=\"L158\" href=\"#L158\" tabindex=\"-1\">158</a>\n<a id=\"L159\" href=\"#L159\" tabindex=\"-1\">159</a>\n<a id=\"L160\" href=\"#L160\" tabindex=\"-1\">160</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">// 移植自采用 MIT 许可证的 musl：\n// https://git.musl-libc.org/cgit/musl/tree/COPYRIGHT\n//\n// https://git.musl-libc.org/cgit/musl/tree/src/complex/cexpf.c\n// https://git.musl-libc.org/cgit/musl/tree/src/complex/cexp.c\n\n</span><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../../std.zig\"</span>);\n<span class=\"tok-kw\">const</span> testing = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>;\n<span class=\"tok-kw\">const</span> math = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>;\n<span class=\"tok-kw\">const</span> cmath = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex\">complex</a>;\n<span class=\"tok-kw\">const</span> Complex = <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex\">cmath</a>.<a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>;\n\n<span class=\"tok-kw\">const</span> ldexp_cexp = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"ldexp.zig\"</span>).ldexp_cexp;\n\n<span class=\"tok-comment\">/// 返回 e 的 z 次幂（e^z）。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">exp</span>(z: <span class=\"tok-kw\">anytype</span>) <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-builtin\">@TypeOf</span>(z.re, z.im)) {\n    <span class=\"tok-kw\">const</span> T = <span class=\"tok-builtin\">@TypeOf</span>(z.re, z.im);\n\n    <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">switch</span> (T) {\n        <span class=\"tok-type\">f32</span> =&gt; <a href=\"/zig-docs/zh-cn/std/math/complex/exp/#std.math.complex.exp.exp32\">exp32</a>(z),\n        <span class=\"tok-type\">f64</span> =&gt; <a href=\"/zig-docs/zh-cn/std/math/complex/exp/#std.math.complex.exp.exp64\">exp64</a>(z),\n        <span class=\"tok-kw\">else</span> =&gt; <span class=\"tok-builtin\">@compileError</span>(<span class=\"tok-str\">\"exp not implemented for \"</span> ++ <span class=\"tok-builtin\">@typeName</span>(z)),\n    };\n}\n\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">exp32</span>(z: <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>)) <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>) {\n    <span class=\"tok-kw\">const</span> exp_overflow = <span class=\"tok-number\">0x42b17218</span>;<span class=\"tok-comment\"> // max_exp * ln2 ~= 88.72283955\n    </span><span class=\"tok-kw\">const</span> cexp_overflow = <span class=\"tok-number\">0x43400074</span>;<span class=\"tok-comment\"> // (max_exp - min_denom_exp) * ln2\n\n    </span><span class=\"tok-kw\">const</span> x = z.re;\n    <span class=\"tok-kw\">const</span> y = z.im;\n\n    <span class=\"tok-kw\">const</span> hy = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u32</span>, <span class=\"tok-builtin\">@bitCast</span>(y)) &amp; <span class=\"tok-number\">0x7fffffff</span>;<span class=\"tok-comment\">\n    // cexp(x + i0) = exp(x) + i0\n    </span><span class=\"tok-kw\">if</span> (hy == <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>).init(<span class=\"tok-builtin\">@exp</span>(x), y);\n    }\n\n    <span class=\"tok-kw\">const</span> hx = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u32</span>, <span class=\"tok-builtin\">@bitCast</span>(x));<span class=\"tok-comment\">\n    // cexp(0 + iy) = cos(y) + isin(y)\n    </span><span class=\"tok-kw\">if</span> ((hx &amp; <span class=\"tok-number\">0x7fffffff</span>) == <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>).init(<span class=\"tok-builtin\">@cos</span>(y), <span class=\"tok-builtin\">@sin</span>(y));\n    }\n\n    <span class=\"tok-kw\">if</span> (hy &gt;= <span class=\"tok-number\">0x7f800000</span>) {<span class=\"tok-comment\">\n        // cexp(finite|nan +- i inf|nan) = nan + i nan\n        </span><span class=\"tok-kw\">if</span> ((hx &amp; <span class=\"tok-number\">0x7fffffff</span>) != <span class=\"tok-number\">0x7f800000</span>) {\n            <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>).init(y - y, y - y);\n        }<span class=\"tok-comment\"> // cexp(-inf +- i inf|nan) = 0 + i0\n        </span><span class=\"tok-kw\">else</span> <span class=\"tok-kw\">if</span> (hx &amp; <span class=\"tok-number\">0x80000000</span> != <span class=\"tok-number\">0</span>) {\n            <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>).init(<span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>);\n        }<span class=\"tok-comment\"> // cexp(+inf +- i inf|nan) = inf + i nan\n        </span><span class=\"tok-kw\">else</span> {\n            <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>).init(x, y - y);\n        }\n    }<span class=\"tok-comment\">\n\n    // 88.7 &lt;= x &lt;= 192，因此必须缩放\n    </span><span class=\"tok-kw\">if</span> (hx &gt;= exp_overflow <span class=\"tok-kw\">and</span> hx &lt;= cexp_overflow) {\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/ldexp/#std.math.complex.ldexp.ldexp_cexp\">ldexp_cexp</a>(z, <span class=\"tok-number\">0</span>);\n    }<span class=\"tok-comment\"> // - x &lt; exp_overflow =&gt; exp(x) 不会溢出（常见情况）\n    // - x &gt; cexp_overflow，因此当 s &gt; 0 时 exp(x) * s 溢出\n    // - x = +-inf\n    // - x = nan\n    </span><span class=\"tok-kw\">else</span> {\n        <span class=\"tok-kw\">const</span> exp_x = <span class=\"tok-builtin\">@exp</span>(x);\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f32</span>).init(exp_x * <span class=\"tok-builtin\">@cos</span>(y), exp_x * <span class=\"tok-builtin\">@sin</span>(y));\n    }\n}\n\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">exp64</span>(z: <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f64</span>)) <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f64</span>) {\n    <span class=\"tok-kw\">const</span> exp_overflow = <span class=\"tok-number\">0x40862e42</span>;<span class=\"tok-comment\"> // max_exp * ln2 的高位约为 710\n    </span><span class=\"tok-kw\">const</span> cexp_overflow = <span class=\"tok-number\">0x4096b8e4</span>;<span class=\"tok-comment\"> // (max_exp - min_denorm_exp) * ln2\n\n    </span><span class=\"tok-kw\">const</span> x = z.re;\n    <span class=\"tok-kw\">const</span> y = z.im;\n\n    <span class=\"tok-kw\">const</span> fy: <span class=\"tok-type\">u64</span> = <span class=\"tok-builtin\">@bitCast</span>(y);\n    <span class=\"tok-kw\">const</span> hy: <span class=\"tok-type\">u32</span> = <span class=\"tok-builtin\">@intCast</span>((fy &gt;&gt; <span class=\"tok-number\">32</span>) &amp; <span class=\"tok-number\">0x7fffffff</span>);\n    <span class=\"tok-kw\">const</span> ly: <span class=\"tok-type\">u32</span> = <span class=\"tok-builtin\">@truncate</span>(fy);<span class=\"tok-comment\">\n\n    // cexp(x + i0) = exp(x) + i0\n    </span><span class=\"tok-kw\">if</span> (hy | ly == <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f64</span>).init(<span class=\"tok-builtin\">@exp</span>(x), y);\n    }\n\n    <span class=\"tok-kw\">const</span> fx: <span class=\"tok-type\">u64</span> = <span class=\"tok-builtin\">@bitCast</span>(x);\n    <span class=\"tok-kw\">const</span> hx: <span class=\"tok-type\">u32</span> = <span class=\"tok-builtin\">@intCast</span>(fx &gt;&gt; <span class=\"tok-number\">32</span>);\n    <span class=\"tok-kw\">const</span> lx: <span class=\"tok-type\">u32</span> = <span class=\"tok-builtin\">@truncate</span>(fx);<span class=\"tok-comment\">\n\n    // cexp(0 + iy) = cos(y) + isin(y)\n    </span><span class=\"tok-kw\">if</span> ((hx &amp; <span class=\"tok-number\">0x7fffffff</span>) | lx == <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f64</span>).init(<span class=\"tok-builtin\">@cos</span>(y), <span class=\"tok-builtin\">@sin</span>(y));\n    }\n\n    <span class=\"tok-kw\">if</span> (hy &gt;= <span class=\"tok-number\">0x7ff00000</span>) {<span class=\"tok-comment\">\n        // cexp(finite|nan +- i inf|nan) = nan + i nan\n        </span><span class=\"tok-kw\">if</span> (lx != <span class=\"tok-number\">0</span> <span class=\"tok-kw\">or</span> (hx &amp; <span class=\"tok-number\">0x7fffffff</span>) != <span class=\"tok-number\">0x7ff00000</span>) {\n            <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/complex/#std.math.complex.Complex\">Complex</a>(<span class=\"tok-type\">f64</span>).init(y - y, y - y);\n        }<span class=\"tok-comment\"> // cexp(-inf +- i inf|nan) = 0 + i0\n        </span><span class=\"tok-kw\">else</span> <span class=\"tok-kw\">if</
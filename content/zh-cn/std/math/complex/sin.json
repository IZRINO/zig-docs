n/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expectApproxEqAbs\">expectApproxEqAbs</a>(-<span class=\"tok-number\">9.654126</span>, c.re, epsilon);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expectApproxEqAbs\">expectApproxEqAbs</a>(<span class=\"tok-number\">2.8416924</span>, c.im, epsilon);\n}\n</code></pre></div></details>"}

"#L65\" tabindex=\"-1\">65</a>\n<a id=\"L66\" href=\"#L66\" tabindex=\"-1\">66</a>\n<a id=\"L67\" href=\"#L67\" tabindex=\"-1\">67</a>\n<a id=\"L68\" href=\"#L68\" tabindex=\"-1\">68</a>\n<a id=\"L69\" href=\"#L69\" tabindex=\"-1\">69</a>\n<a id=\"L70\" href=\"#L70\" tabindex=\"-1\">70</a>\n<a id=\"L71\" href=\"#L71\" tabindex=\"-1\">71</a>\n<a id=\"L72\" href=\"#L72\" tabindex=\"-1\">72</a>\n<a id=\"L73\" href=\"#L73\" tabindex=\"-1\">73</a>\n<a id=\"L74\" href=\"#L74\" tabindex=\"-1\">74</a>\n<a id=\"L75\" href=\"#L75\" tabindex=\"-1\">75</a>\n<a id=\"L76\" href=\"#L76\" tabindex=\"-1\">76</a>\n<a id=\"L77\" href=\"#L77\" tabindex=\"-1\">77</a>\n<a id=\"L78\" href=\"#L78\" tabindex=\"-1\">78</a>\n<a id=\"L79\" href=\"#L79\" tabindex=\"-1\">79</a>\n<a id=\"L80\" href=\"#L80\" tabindex=\"-1\">80</a>\n<a id=\"L81\" href=\"#L81\" tabindex=\"-1\">81</a>\n<a id=\"L82\" href=\"#L82\" tabindex=\"-1\">82</a>\n<a id=\"L83\" href=\"#L83\" tabindex=\"-1\">83</a>\n<a id=\"L84\" href=\"#L84\" tabindex=\"-1\">84</a>\n<a id=\"L85\" href=\"#L85\" tabindex=\"-1\">85</a>\n<a id=\"L86\" href=\"#L86\" tabindex=\"-1\">86</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../std.zig\"</span>);\n<span class=\"tok-kw\">const</span> math = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>;\n<span class=\"tok-kw\">const</span> expect = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>;\n<span class=\"tok-kw\">const</span> TypeId = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/lang/#std.lang\">builtin</a>.<a href=\"/zig-docs/zh-cn/std/lang/#std.lang.TypeId\">TypeId</a>;\n<span class=\"tok-kw\">const</span> maxInt = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math.maxInt\">maxInt</a>;\n\n<span class=\"tok-comment\">/// 返回 x 的平方根。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 特殊情况：</span>\n<span class=\"tok-comment\">///  - sqrt(+inf)  = +inf</span>\n<span class=\"tok-comment\">///  - sqrt(+-0)   = +-0</span>\n<span class=\"tok-comment\">///  - sqrt(x)     = nan，如果 x &lt; 0</span>\n<span class=\"tok-comment\">///  - sqrt(nan)   = nan</span>\n<span class=\"tok-comment\">/// TODO: 确定是否应直接在 @sqrt 内置函数中实现这些逻辑。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">sqrt</span>(x: <span class=\"tok-kw\">anytype</span>) <a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.Sqrt\">Sqrt</a>(<span class=\"tok-builtin\">@TypeOf</span>(x)) {\n    <span class=\"tok-kw\">const</span> T = <span class=\"tok-builtin\">@TypeOf</span>(x);\n    <span class=\"tok-kw\">switch</span> (<span class=\"tok-builtin\">@typeInfo</span>(T)) {\n        .float, .<span class=\"tok-type\">comptime_float</span> =&gt; <span class=\"tok-kw\">return</span> <span class=\"tok-builtin\">@sqrt</span>(x),\n        .<span class=\"tok-type\">comptime_int</span> =&gt; <span class=\"tok-kw\">comptime</span> {\n            <span class=\"tok-kw\">if</span> (x &gt; <a href=\"/zig-docs/zh-cn/std/math/#std.math.maxInt\">maxInt</a>(<span class=\"tok-type\">u128</span>)) {\n                <span class=\"tok-builtin\">@compileError</span>(<span class=\"tok-str\">\"sqrt not implemented for comptime_int greater than 128 bits\"</span>);\n            }\n            <span class=\"tok-kw\">if</span> (x &lt; <span class=\"tok-number\">0</span>) {\n                <span class=\"tok-builtin\">@compileError</span>(<span class=\"tok-str\">\"sqrt on negative number\"</span>);\n            }\n            <span class=\"tok-kw\">return</span> <span class=\"tok-builtin\">@as</span>(T, <a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u128</span>, x));\n        },\n        .int =&gt; |IntType| <span class=\"tok-kw\">switch</span> (IntType.signedness) {\n            .signed =&gt; <span class=\"tok-builtin\">@compileError</span>(<span class=\"tok-str\">\"sqrt not implemented for signed integers\"</span>),\n            .unsigned =&gt; <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(T, x),\n        },\n        <span class=\"tok-kw\">else</span> =&gt; <span class=\"tok-builtin\">@compileError</span>(<span class=\"tok-str\">\"sqrt not implemented for \"</span> ++ <span class=\"tok-builtin\">@typeName</span>(T)),\n    }\n}\n\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">sqrt_int</span>(<span class=\"tok-kw\">comptime</span> T: <span class=\"tok-type\">type</span>, value: T) <a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.Sqrt\">Sqrt</a>(T) {\n    <span class=\"tok-kw\">if</span> (<span class=\"tok-builtin\">@typeInfo</span>(T).int.bits &lt;= <span class=\"tok-number\">2</span>) {\n        <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">if</span> (value == <span class=\"tok-number\">0</span>) <span class=\"tok-number\">0</span> <span class=\"tok-kw\">else</span> <span class=\"tok-number\">1</span>;<span class=\"tok-comment\"> // 对少量位的快捷处理，以简化通用情况。\n    </span>} <span class=\"tok-kw\">else</span> {\n        <span class=\"tok-kw\">const</span> bits = <span class=\"tok-builtin\">@typeInfo</span>(T).int.bits;\n        <span class=\"tok-kw\">const</span> max = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math.maxInt\">maxInt</a>(T);\n        <span class=\"tok-kw\">const</span> minustwo = (<span class=\"tok-builtin\">@as</span>(T, <span class=\"tok-number\">2</span>) ^ max) + <span class=\"tok-number\">1</span>;<span class=\"tok-comment\"> // 无符号整数无法表示 -2\n        </span><span class=\"tok-kw\">var</span> op = value;\n        <span class=\"tok-kw\">var</span> res: T = <span class=\"tok-number\">0</span>;\n        <span class=\"tok-kw\">var</span> one: T = <span class=\"tok-number\">1</span> &lt;&lt; ((bits - <span class=\"tok-number\">1</span>) &amp; minustwo);<span class=\"tok-comment\"> // 能够由 T 表示的最大四的幂\n\n        // \"one\" 初始为不大于参数的最大四次幂。\n        </span><span class=\"tok-kw\">while</span> (one &gt; op) {\n            one &gt;&gt;= <span class=\"tok-number\">2</span>;\n        }\n\n        <span class=\"tok-kw\">while</span> (one != <span class=\"tok-number\">0</span>) {\n            <span class=\"tok-kw\">const</span> c = op &gt;= res + one;\n            <span class=\"tok-kw\">if</span> (c) op -= res + one;\n            res &gt;&gt;= <span class=\"tok-number\">1</span>;\n            <span class=\"tok-kw\">if</span> (c) res += one;\n            one &gt;&gt;= <span class=\"tok-number\">2</span>;\n        }\n\n        <span class=\"tok-kw\">return</span> <span class=\"tok-builtin\">@as</span>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.Sqrt\">Sqrt</a>(T), <span class=\"tok-builtin\">@intCast</span>(res));\n    }\n}\n\n<span class=\"tok-kw\">test</span> sqrt_int {\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u32</span>, <span class=\"tok-number\">3</span>) == <span class=\"tok-number\">1</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u32</span>, <span class=\"tok-number\">4</span>) == <span class=\"tok-number\">2</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u32</span>, <span class=\"tok-number\">5</span>) == <span class=\"tok-number\">2</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u32</span>, <span class=\"tok-number\">8</span>) == <span class=\"tok-number\">2</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u32</span>, <span class=\"tok-number\">9</span>) == <span class=\"tok-number\">3</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u32</span>, <span class=\"tok-number\">10</span>) == <span class=\"tok-number\">3</span>);\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u0</span>, <span class=\"tok-number\">0</span>) == <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u1</span>, <span class=\"tok-number\">1</span>) == <span class=\"tok-number\">1</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u2</span>, <span class=\"tok-number\">3</span>) == <span class=\"tok-number\">1</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u3</span>, <span class=\"tok-number\">4</span>) == <span class=\"tok-number\">2</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u4</span>, <span class=\"tok-number\">8</span>) == <span class=\"tok-number\">2</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/sqrt/#std.math.sqrt.sqrt_int\">sqrt_int</a>(<span class=\"tok-type\">u4</span>, <span class=\"tok-number\">9</span>) == <span class=\"tok-number\">3</span>);\n}\n\n<span class=\"tok-comment\">/// 返回当操作数类型为 `T` 时，`sqrt` 将返回的类型。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">Sqrt</span>(<span class=\"tok-kw\">comptime</span> T: <span class=\"tok-type\">type</span>) <span class=\"tok-type\">type</span> {\n    <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">switch</span> (<span class=\"tok-builtin\">@typeInfo</span>(T)) {\n        .int =&gt; |int| <span class=\"tok-builtin\">@Int</span>(.unsigned, (int.bits + <span class=\"tok-number\">1</span>) / <span class=\"tok-number\">2</span>),\n        <span class=\"tok-kw\">else</span> =&gt; T,\n    };\n}\n</code></pre></div></details>"}

Int</a>(<span class=\"tok-type\">i32</span>);\n    }\n\n    <span class=\"tok-kw\">return</span> e - exponentBias;\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"type dispatch\"</span> {\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/ilogb/#std.math.ilogb.ilogb\">ilogb</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f32</span>, <span class=\"tok-number\">0.2</span>)) == <a href=\"/zig-docs/zh-cn/std/math/ilogb/#std.math.ilogb.ilogbX\">ilogbX</a>(<span class=\"tok-type\">f32</span>, <span class=\"tok-number\">0.2</span>));\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/ilogb/#std.math.ilogb.ilogb\">ilogb</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f64</span>, <span class=\"tok-number\">0.2</span>)) == <a href=\"/zig-docs/zh-cn/std/math/ilogb/#std.math.ilogb.ilogbX\">ilogbX</a>(<span class=\"tok-type\">f64</span>, <span class=\"tok-number\">0.2</span>));\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"16\"</span> {\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/ilogb/#std.math.ilogb.ilogbX\">ilogbX</a>(<span class=\"tok-type\">f16</span>, <span class=\"tok-number\">0.0</span>) == <a href=\"/zig-docs/zh-cn/std/math/ilogb/#std.math.ilogb.fp_ilogb0\">fp_ilogb0</a>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/ilogb/#std.math.ilogb.ilogbX\">ilogbX</a>(<span class=\"tok-type\">f16</span>, <span class=\"tok-number\">0.5</span>) == -<span class=\"tok-number\">1</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/st
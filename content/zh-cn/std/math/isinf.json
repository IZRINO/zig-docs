span class=\"tok-type\">f128</span> }) |T| {\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isinf/#std.math.isinf.isInf\">isInf</a>(<span class=\"tok-builtin\">@as</span>(T, <span class=\"tok-number\">0.0</span>)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isinf/#std.math.isinf.isInf\">isInf</a>(<span class=\"tok-builtin\">@as</span>(T, -<span class=\"tok-number\">0.0</span>)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/isinf/#std.math.isinf.isInf\">isInf</a>(<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.inf\">inf</a>(T)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/isinf/#std.math.isinf.isInf\">isInf</a>(-<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.inf\">inf</a>(T)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isinf/#std.math.isinf.isInf\">isInf</a>(<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.nan\">nan</a>(T)));\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(!<a href=\"/zig-docs/zh-cn/std/math/isinf/#std.math.isinf.isInf\">isInf</a>(-<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/float/#std.math.float.nan\">nan</a>(T)));\n    }\n}\n\n<span class=\"tok-kw\">test</span> isPositiveInf {\n    <span class=\"tok-kw\">inline</span> <span cl
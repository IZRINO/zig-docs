{"id":"std/math/lcm","kind":"std","title":"std.math.lcm","sourcePath":"std/math/lcm.zig","sourceUrl":"https://ziglang.org/documentation/0.17.0/std/#std.math.lcm","file":"std/math/lcm.json","headings":[{"depth":2,"slug":"std.math.lcm","text":"std.math.lcm"},{"depth":3,"slug":"std.math.lcm.lcm","text":"std.math.lcm.lcm"},{"depth":3,"slug":"std.math.lcm.std","text":"std.math.lcm.std"},{"depth":2,"slug":"source","text":"源码"}],"symbols":[{"id":"std/math/lcm.zig:1:2327","name":"std.math.lcm","anchor":"std.math.lcm","category":"namespace","sourceLine":1},{"id":"std/math/lcm.zig:7:2329","name":"std.math.lcm.lcm","anchor":"std.math.lcm.lcm","category":"function","sourceLine":7},{"id":"std/math/lcm.zig:2:2328","name":"std.math.lcm.std","anchor":"std.math.lcm.std","category":"alias","sourceLine":2}],"html":"<div id=\"std.math.lcm\"></div>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L1\">源码行 1</a></p>\n<div class=\"api-description\"><p>最小公倍数（https://mathworld.wolfram.com/LeastCommonMultiple.html）</p>\n</div>\n<div class=\"api-members\"><ul>\n<li><a href=\"/zig-docs/zh-cn/std/#std\"><code>std</code></a></li>\n<li><a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\"><code>lcm</code></a></li>\n</ul></div>\n<section class=\"api-entry\" id=\"std.math.lcm.lcm\"><h3><code>std.math.lcm.lcm</code></h3>\n<p class=\"api-kind\">函数</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L7\">源码行 7</a></p>\n<div class=\"api-description\"><p>返回两个整数（<code>a</code> 和 <code>b</code>）的最小公倍数（LCM）。\n例如，<code>8</code> 和 <code>12</code> 的最小公倍数为 <code>24</code>，即 <code>lcm(8, 12) == 24</code>。\n若任一参数为零，则返回 0。</p>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">lcm</span>(a: <span class=\"tok-kw\">anytype</span>, b: <span class=\"tok-kw\">anytype</span>) <span class=\"tok-builtin\">@TypeOf</span>(a, b)</code></pre>\n<h4>用法示例</h4><pre><code><span class=\"tok-kw\">test</span> lcm {\n    <span class=\"tok-kw\">const</span> expectEqual = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expectEqual\">expectEqual</a>;\n\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>), <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">1</span>, <span class=\"tok-number\">0</span>), <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(-<span class=\"tok-number\">1</span>, <span class=\"tok-number\">0</span>), <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">0</span>, <span class=\"tok-number\">1</span>), <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">0</span>, -<span class=\"tok-number\">1</span>), <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">7</span>, <span class=\"tok-number\">1</span>), <span class=\"tok-number\">7</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">7</span>, -<span class=\"tok-number\">1</span>), <span class=\"tok-number\">7</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">8</span>, <span class=\"tok-number\">12</span>), <span class=\"tok-number\">24</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(-<span class=\"tok-number\">23</span>, <span class=\"tok-number\">15</span>), <span class=\"tok-number\">345</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">120</span>, <span class=\"tok-number\">84</span>), <span class=\"tok-number\">840</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">84</span>, -<span class=\"tok-number\">120</span>), <span class=\"tok-number\">840</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">1216342683557601535506311712</span>, <span class=\"tok-number\">436522681849110124616458784</span>), <span class=\"tok-number\">16592536571065866494401400422922201534178938447014944</span>);\n}</code></pre>\n</section>\n<section class=\"api-entry\" id=\"std.math.lcm.std\"><h3><code>std.math.lcm.std</code></h3>\n<p class=\"api-kind\">别名</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L2\">源码行 2</a></p>\n<p>别名目标 <a href=\"/zig-docs/zh-cn/std/#std\"><code>std</code></a></p>\n</section>\n<details class=\"source-code\" id=\"source\" data-pagefind-ignore=\"\"><summary>源码</summary><p><code>std/math/lcm.zig</code></p><div class=\"source-grid\"><pre class=\"line-numbers\" aria-hidden=\"true\" data-copy-ignore=\"\"><code><a id=\"L1\" href=\"#L1\" tabindex=\"-1\">1</a>\n<a id=\"L2\" href=\"#L2\" tabindex=\"-1\">2</a>\n<a id=\"L3\" href=\"#L3\" tabindex=\"-1\">3</a>\n<a id=\"L4\" href=\"#L4\" tabindex=\"-1\">4</a>\n<a id=\"L5\" href=\"#L5\" tabindex=\"-1\">5</a>\n<a id=\"L6\" href=\"#L6\" tabindex=\"-1\">6</a>\n<a id=\"L7\" href=\"#L7\" tabindex=\"-1\">7</a>\n<a id=\"L8\" href=\"#L8\" tabindex=\"-1\">8</a>\n<a id=\"L9\" href=\"#L9\" tabindex=\"-1\">9</a>\n<a id=\"L10\" href=\"#L10\" tabindex=\"-1\">10</a>\n<a id=\"L11\" href=\"#L11\" tabindex=\"-1\">11</a>\n<a id=\"L12\" href=\"#L12\" tabindex=\"-1\">12</a>\n<a id=\"L13\" href=\"#L13\" tabindex=\"-1\">13</a>\n<a id=\"L14\" href=\"#L14\" tabindex=\"-1\">14</a>\n<a id=\"L15\" href=\"#L15\" tabindex=\"-1\">15</a>\n<a id=\"L16\" href=\"#L16\" tabindex=\"-1\">16</a>\n<a id=\"L17\" href=\"#L17\" tabindex=\"-1\">17</a>\n<a id=\"L18\" href=\"#L18\" tabindex=\"-1\">18</a>\n<a id=\"L19\" href=\"#L19\" tabindex=\"-1\">19</a>\n<a id=\"L20\" href=\"#L20\" tabindex=\"-1\">20</a>\n<a id=\"L21\" href=\"#L21\" tabindex=\"-1\">21</a>\n<a id=\"L22\" href=\"#L22\" tabindex=\"-1\">22</a>\n<a id=\"L23\" href=\"#L23\" tabindex=\"-1\">23</a>\n<a id=\"L24\" href=\"#L24\" tabindex=\"-1\">24</a>\n<a id=\"L25\" href=\"#L25\" tabindex=\"-1\">25</a>\n<a id=\"L26\" href=\"#L26\" tabindex=\"-1\">26</a>\n<a id=\"L27\" href=\"#L27\" tabindex=\"-1\">27</a>\n<a id=\"L28\" href=\"#L28\" tabindex=\"-1\">28</a>\n<a id=\"L29\" href=\"#L29\" tabindex=\"-1\">29</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">//! 最小公倍数（https://mathworld.wolfram.com/LeastCommonMultiple.html）</span>\n<span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n\n<span class=\"tok-comment\">/// 返回两个整数（`a` 和 `b`）的最小公倍数（LCM）。</span>\n<span class=\"tok-comment\">/// 例如，`8` 和 `12` 的最小公倍数为 `24`，即 `lcm(8, 12) == 24`。</span>\n<span class=\"tok-comment\">/// 若任一参数为零，则返回 0。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">lcm</span>(a: <span class=\"tok-kw\">anytype</span>, b: <span class=\"tok-kw\">anytype</span>) <span class=\"tok-builtin\">@TypeOf</span>(a, b) {<span class=\"tok-comment\">\n    // C++ 和 Python 的行为\n    // 若参数为零，则返回值为 0。\n    </span><span class=\"tok-kw\">if</span> (a == <span class=\"tok-number\">0</span> <span class=\"tok-kw\">or</span> b == <span class=\"tok-number\">0</span>) <span class=\"tok-kw\">return</span> <span class=\"tok-number\">0</span>;\n    <span class=\"tok-kw\">return</span> <span class=\"tok-builtin\">@abs</span>(b) * (<span class=\"tok-builtin\">@abs</span>(a) / <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-builtin\">@abs</span>(a), <span class=\"tok-builtin\">@abs</span>(b)));\n}\n\n<span class=\"tok-kw\">test</span> lcm {\n    <span class=\"tok-kw\">const</span> expectEqual = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expectEqual\">expectEqual</a>;\n\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>), <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">1</span>, <span class=\"tok-number\">0</span>), <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(-<span class=\"tok-number\">1</span>, <span class=\"tok-number\">0</span>), <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">0</span>, <span class=\"tok-number\">1</span>), <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">0</span>, -<span class=\"tok-number\">1</span>), <span class=\"tok-number\">0</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">7</span>, <span class=\"tok-number\">1</span>), <span class=\"tok-number\">7</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">7</span>, -<span class=\"tok-number\">1</span>), <span class=\"tok-number\">7</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">8</span>, <span class=\"tok-number\">12</span>), <span class=\"tok-number\">24</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(-<span class=\"tok-number\">23</span>, <span class=\"tok-number\">15</span>), <span class=\"tok-number\">345</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">120</span>, <span class=\"tok-number\">84</span>), <span class=\"tok-number\">840</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">84</span>, -<span class=\"tok-number\">120</span>), <span class=\"tok-number\">840</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/zh-cn/std/math/lcm/#std.math.lcm.lcm\">lcm</a>(<span class=\"tok-number\">1216342683557601535506311712</span>, <span class=\"tok-number\">436522681849110124616458784</span>), <span class=\"tok-number\">16592536571065866494401400422922201534178938447014944</span>);\n}\n</code></pre></div></details>"}

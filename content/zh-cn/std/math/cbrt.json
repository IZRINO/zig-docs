abindex=\"-1\">120</a>\n<a id=\"L121\" href=\"#L121\" tabindex=\"-1\">121</a>\n<a id=\"L122\" href=\"#L122\" tabindex=\"-1\">122</a>\n<a id=\"L123\" href=\"#L123\" tabindex=\"-1\">123</a>\n<a id=\"L124\" href=\"#L124\" tabindex=\"-1\">124</a>\n<a id=\"L125\" href=\"#L125\" tabindex=\"-1\">125</a>\n<a id=\"L126\" href=\"#L126\" tabindex=\"-1\">126</a>\n<a id=\"L127\" href=\"#L127\" tabindex=\"-1\">127</a>\n<a id=\"L128\" href=\"#L128\" tabindex=\"-1\">128</a>\n<a id=\"L129\" href=\"#L129\" tabindex=\"-1\">129</a>\n<a id=\"L130\" href=\"#L130\" tabindex=\"-1\">130</a>\n<a id=\"L131\" href=\"#L131\" tabindex=\"-1\">131</a>\n<a id=\"L132\" href=\"#L132\" tabindex=\"-1\">132</a>\n<a id=\"L133\" href=\"#L133\" tabindex=\"-1\">133</a>\n<a id=\"L134\" href=\"#L134\" tabindex=\"-1\">134</a>\n<a id=\"L135\" href=\"#L135\" tabindex=\"-1\">135</a>\n<a id=\"L136\" href=\"#L136\" tabindex=\"-1\">136</a>\n<a id=\"L137\" href=\"#L137\" tabindex=\"-1\">137</a>\n<a id=\"L138\" href=\"#L138\" tabindex=\"-1\">138</a>\n<a id=\"L139\" href=\"#L139\" tabindex=\"-1\">139</a>\n<a id=\"L140\" href=\"#L140\" tabindex=\"-1\">140</a>\n<a id=\"L141\" href=\"#L141\" tabindex=\"-1\">141</a>\n<a id=\"L142\" href=\"#L142\" tabindex=\"-1\">142</a>\n<a id=\"L143\" href=\"#L143\" tabindex=\"-1\">143</a>\n<a id=\"L144\" href=\"#L144\" tabindex=\"-1\">144</a>\n<a id=\"L145\" href=\"#L145\" tabindex=\"-1\">145</a>\n<a id=\"L146\" href=\"#L146\" tabindex=\"-1\">146</a>\n<a id=\"L147\" href=\"#L147\" tabindex=\"-1\">147</a>\n<a id=\"L148\" href=\"#L148\" tabindex=\"-1\">148</a>\n<a id=\"L149\" href=\"#L149\" tabindex=\"-1\">149</a>\n<a id=\"L150\" href=\"#L150\" tabindex=\"-1\">150</a>\n<a id=\"L151\" href=\"#L151\" tabindex=\"-1\">151</a>\n<a id=\"L152\" href=\"#L152\" tabindex=\"-1\">152</a>\n<a id=\"L153\" href=\"#L153\" tabindex=\"-1\">153</a>\n<a id=\"L154\" href=\"#L154\" tabindex=\"-1\">154</a>\n<a id=\"L155\" href=\"#L155\" tabindex=\"-1\">155</a>\n<a id=\"L156\" href=\"#L156\" tabindex=\"-1\">156</a>\n<a id=\"L157\" href=\"#L157\" tabindex=\"-1\">157</a>\n<a id=\"L158\" href=\"#L158\" tabindex=\"-1\">158</a>\n<a id=\"L159\" href=\"#L159\" tabindex=\"-1\">159</a>\n<a id=\"L160\" href=\"#L160\" tabindex=\"-1\">160</a>\n<a id=\"L161\" href=\"#L161\" tabindex=\"-1\">161</a>\n<a id=\"L162\" href=\"#L162\" tabindex=\"-1\">162</a>\n<a id=\"L163\" href=\"#L163\" tabindex=\"-1\">163</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">// 移植自采用 MIT 许可证的 musl：\n// https://git.musl-libc.org/cgit/musl/tree/COPYRIGHT\n//\n// https://git.musl-libc.org/cgit/musl/tree/src/math/cbrtf.c\n// https://git.musl-libc.org/cgit/musl/tree/src/math/cbrt.c\n\n</span><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../std.zig\"</span>);\n<span class=\"tok-kw\">const</span> math = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>;\n<span class=\"tok-kw\">const</span> expect = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>;\n\n<span class=\"tok-comment\">/// 返回 x 的立方根。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// 特殊情况：</span>\n<span class=\"tok-comment\">///  - cbrt(+-0)   = +-0</span>\n<span class=\"tok-comment\">///  - cbrt(+-inf) = +-inf</span>\n<span class=\"tok-comment\">///  - cbrt(nan)   = nan</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">cbrt</span>(x: <span class=\"tok-kw\">anytype</span>) <span class=\"tok-builtin\">@TypeOf</span>(x) {\n    <span class=\"tok-kw\">const</span> T = <span class=\"tok-builtin\">@TypeOf</span>(x);\n    <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">switch</span> (T) {\n        <span class=\"tok-type\">f32</span> =&gt; <a href=\"/zig-docs/zh-cn/std/math/cbrt/#std.math.cbrt.cbrt32\">cbrt32</a>(x),\n        <span class=\"tok-type\">f64</span> =&gt; <a href=\"/zig-docs/zh-cn/std/math/cbrt/#std.math.cbrt.cbrt64\">cbrt64</a>(x),\n        <span class=\"tok-kw\">else</span> =&gt; <span class=\"tok-builtin\">@compileError</span>(<span class=\"tok-str\">\"cbrt not implemented for \"</span> ++ <span class=\"tok-builtin\">@typeName</span>(T)),\n    };\n}\n\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">cbrt32</span>(x: <span class=\"tok-type\">f32</span>) <span class=\"tok-type\">f32</span> {\n    <span class=\"tok-kw\">const</span> B1: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">709958130</span>;<span class=\"tok-comment\"> // (127 - 127.0 / 3 - 0.03306235651) * 2^23\n    </span><span class=\"tok-kw\">const</span> B2: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">642849266</span>;<span class=\"tok-comment\"> // (127 - 127.0 / 3 - 24 / 3 - 0.03306235651) * 2^23\n\n    </span><span class=\"tok-kw\">var</span> u = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u32</span>, <span class=\"tok-builtin\">@bitCast</span>(x));\n    <span class=\"tok-kw\">var</span> hx = u &amp; <span class=\"tok-number\">0x7FFFFFFF</span>;<span class=\"tok-comment\">\n\n    // cbrt(nan, inf) = 本身\n    </span><span class=\"tok-kw\">if</span> (hx &gt;= <span class=\"tok-number\">0x7F800000</span>) {\n        <span class=\"tok-kw\">return</span> x + x;\n    }<span class=\"tok-comment\">\n\n    // 约 5 位精度的 cbrt\n    </span><span class=\"tok-kw\">if</span> (hx &lt; <span class=\"tok-number\">0x00800000</span>) {<span class=\"tok-comment\">\n        // cbrt(+-0) = 本身\n        </span><span class=\"tok-kw\">if</span> (hx == <span class=\"tok-number\">0</span>) {\n            <span class=\"tok-kw\">return</span> x;\n        }\n        u = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u32</span>, <span class=\"tok-builtin\">@bitCast</span>(x * <span class=\"tok-number\">0x1.0p24</span>));\n        hx = u &amp; <span class=\"tok-number\">0x7FFFFFFF</span>;\n        hx = hx / <span class=\"tok-number\">3</span> + B2;\n    } <span class=\"tok-kw\">else</span> {\n        hx = hx / <span class=\"tok-number\">3</span> + B1;\n    }\n\n    u &amp;= <span class=\"tok-number\">0x80000000</span>;\n    u |= hx;<span class=\"tok-comment\">\n\n    // 第一步牛顿迭代达到 16 位精度\n    </span><span class=\"tok-kw\">var</span> t: <span class=\"tok-type\">f64</span> = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f32</span>, <span class=\"tok-builtin\">@bitCast</span>(u));\n    <span class=\"tok-kw\">var</span> r: <span class=\"tok-type\">f64</span> = t * t * t;\n    t = t * (<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f64</span>, x) + x + r) / (x + r + r);<span class=\"tok-comment\">\n\n    // 第二步牛顿迭代达到 47 位精度\n    </span>r = t * t * t;\n    t = t * (<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f64</span>, x) + x + r) / (x + r + r);\n\n    <span class=\"tok-kw\">return</span> <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f32</span>, <span class=\"tok-builtin\">@floatCast</span>(t));\n}\n\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">cbrt64</span>(x: <span class=\"tok-type\">f64</span>) <span class=\"tok-type\">f64</span> {\n    <span class=\"tok-kw\">const</span> B1: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">715094163</span>;<span class=\"tok-comment\"> // (1023 - 1023 / 3 - 0.03306235651 * 2^20\n    </span><span class=\"tok-kw\">const</span> B2: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">696219795</span>;<span class=\"tok-comment\"> // (1023 - 1023 / 3 - 54 / 3 - 0.03306235651 * 2^20\n\n    // |1 / cbrt(x) - p(x)| &lt; 2^(23.5)\n    </span><span class=\"tok-kw\">const</span> P0: <span class=\"tok-type\">f64</span> = <span class=\"tok-number\">1.87595182427177009643</span>;\n    <span class=\"tok-kw\">const</span> P1: <span class=\"tok-type\">f64</span> = -<span class=\"tok-number\">1.88497979543377169875</span>;\n    <span class=\"tok-kw\">const</span> P2: <span class=\"tok-type\">f64</span> = <span class=\"tok-number\">1.621429720105354466140</span>;\n    <span class=\"tok-kw\">const</span> P3: <span class=\"tok-type\">f64</span> = -<span class=\"tok-number\">0.758397934778766047437</span>;\n    <span class=\"tok-kw\">const</span> P4: <span class=\"tok-type\">f64</span> = <span class=\"tok-number\">0.145996192886612446982</span>;\n\n    <span class=\"tok-kw\">var</span> u = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u64</span>, <span class=\"tok-builtin\">@bitCast</span>(x));\n    <span class=\"tok-kw\">var</span> hx = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u32</span>, <span class=\"tok-builtin\">@intCast</span>(u &gt;&gt; <span class=\"tok-number\">32</span>)) &amp; <span class=\"tok-number\">0x7FFFFFFF</span>;<span class=\"tok-comment\">\n\n    // cbrt(nan, inf) = 本身\n    </span><span class=\"tok-kw\">if</span> (hx &gt;= <span class=\"tok-number\">0x7FF00000</span>) {\n        <span class=\"tok-kw\">return</span> x + x;\n    }<span class=\"tok-comment\">\n\n    // 约 5 位精度的 cbrt\n    </span><span class=\"tok-kw\">if</span> (hx &lt; <span class=\"tok-number\">0x00100000</span>) {\n        u = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u64</span>, <span class=\"tok-builtin\">@bitCast</span>(x * <span class=\"tok-number\">0x1.0p54</span>));\n        hx = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u32</span>, <span class=\"tok-builtin\">@intCast</span>(u &gt;&gt; <span class=\"tok-number\">32</span>)) &amp; <span class=\"tok-number\">0x7FFFFFFF</span>;<span class=\"tok-comment\">\n\n        // cbrt(+-0) = 本身\n        </span><span class=\"tok-kw\">if</span> (hx == <span class=\"tok-number\">0</span>) {\n            <span class=\"tok-kw\">return</span> x;\n        }\n        hx = hx / <span class=\"tok-number\">3</span> + B2;\n    } <span class=\"tok-kw\">else</span> {\n        hx = hx / <span class=\"tok-number\">3</span> + B1;\n    }\n\n    u &amp;= <span class=\"tok-number\">1</span> &lt;&lt; <span class=\"tok-number\">63</span>;\n    u |= <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u64</span>, hx) &lt;&lt; <span class=\"tok-number\">32</span>;\n    <span class=\"tok-kw\">var</span> t = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f64</span>, <span class=\"tok-builtin\">@bitCast</span>(u));<span class=\"tok-comment\">\n\n    // 计算到 23 位精度的立方根\n    // cbrt(x) = t * cbrt(x / t^3) ~= t * P(t^3 / x)\n    </span><span class=\"tok-kw\">const</span> r = (t * t) * (t / x);\n    t = t * ((P0 + r * (P1 + r * P2)) + ((r * r) * r) * (P3 + r * P4));<span class=\"tok-comment\">\n\n    // 将 t 向远离 0 的方向舍入至 23 位\n    </span>u = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u64</span>, <span class=\"tok-builtin\">@bitCast</span>(t));\n    u = (u + <span class=\"tok-number\">0x80000000</span>) &amp; <span class=\"tok-number\">0xFFFFFFFFC0000000</span>;\n    t = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f64</span>, <span class=\"tok-builtin\">@bitCast</span>(u));<span class=\"tok-comment\">\n\n    // 执行一步牛顿迭代以达到 53 位\n    </span><span class=\"tok-kw\">const</span> s = t * t;\n    <span class=\"tok-kw\">var</span> q = x / s;\n    <span class=\"tok-kw\">const</span> w = t + t;\n    q = (q - t) / (w + q);\n\n    <span class=\"tok-kw\">return</span> t + t * q;\n}\n\n<span class=\"tok-kw\">test</span> cbrt {\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/math/cbrt/#std.math.cbrt.cbrt\">cbrt</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f32</span>, <span class=\"tok-number\">0.0</span>)) == <a href=\"/zig-docs/zh-cn/std/math/cbrt/#std.math.cbrt.cbrt32\">cbrt32</a>(<span class=\"tok-number\">0.0</span>));\n    <span class=\"tok-kw\">try</span
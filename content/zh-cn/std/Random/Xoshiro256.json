"#L119\" tabindex=\"-1\">119</a>\n<a id=\"L120\" href=\"#L120\" tabindex=\"-1\">120</a>\n<a id=\"L121\" href=\"#L121\" tabindex=\"-1\">121</a>\n<a id=\"L122\" href=\"#L122\" tabindex=\"-1\">122</a>\n<a id=\"L123\" href=\"#L123\" tabindex=\"-1\">123</a>\n<a id=\"L124\" href=\"#L124\" tabindex=\"-1\">124</a>\n<a id=\"L125\" href=\"#L125\" tabindex=\"-1\">125</a>\n<a id=\"L126\" href=\"#L126\" tabindex=\"-1\">126</a>\n<a id=\"L127\" href=\"#L127\" tabindex=\"-1\">127</a>\n<a id=\"L128\" href=\"#L128\" tabindex=\"-1\">128</a>\n<a id=\"L129\" href=\"#L129\" tabindex=\"-1\">129</a>\n<a id=\"L130\" href=\"#L130\" tabindex=\"-1\">130</a>\n<a id=\"L131\" href=\"#L131\" tabindex=\"-1\">131</a>\n<a id=\"L132\" href=\"#L132\" tabindex=\"-1\">132</a>\n<a id=\"L133\" href=\"#L133\" tabindex=\"-1\">133</a>\n<a id=\"L134\" href=\"#L134\" tabindex=\"-1\">134</a>\n<a id=\"L135\" href=\"#L135\" tabindex=\"-1\">135</a>\n<a id=\"L136\" href=\"#L136\" tabindex=\"-1\">136</a>\n<a id=\"L137\" href=\"#L137\" tabindex=\"-1\">137</a>\n<a id=\"L138\" href=\"#L138\" tabindex=\"-1\">138</a>\n<a id=\"L139\" href=\"#L139\" tabindex=\"-1\">139</a>\n<a id=\"L140\" href=\"#L140\" tabindex=\"-1\">140</a>\n<a id=\"L141\" href=\"#L141\" tabindex=\"-1\">141</a>\n<a id=\"L142\" href=\"#L142\" tabindex=\"-1\">142</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">//! Xoshiro256++ - https://prng.di.unimi.it/xoshiro256plusplus.c</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! 伪随机数生成器</span>\n\n<span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n<span class=\"tok-kw\">const</span> math = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>;\n<span class=\"tok-kw\">const</span> Xoshiro256 = <span class=\"tok-builtin\">@This</span>();\n\ns: [<span class=\"tok-number\">4</span>]<span class=\"tok-type\">u64</span>,\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">init</span>(init_s: <span class=\"tok-type\">u64</span>) <a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256\">Xoshiro256</a> {\n    <span class=\"tok-kw\">var</span> x = <a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256\">Xoshiro256</a>{\n        .s = <span class=\"tok-null\">undefined</span>,\n    };\n\n    x.seed(init_s);\n    <span class=\"tok-kw\">return</span> x;\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">random</span>(self: *<a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256\">Xoshiro256</a>) <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Random/#std.Random\">Random</a> {\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Random/#std.Random\">Random</a>.<a href=\"/zig-docs/zh-cn/std/Random/#std.Random.init\">init</a>(self, <a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256.fill\">fill</a>);\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">next</span>(self: *<a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256\">Xoshiro256</a>) <span class=\"tok-type\">u64</span> {\n    <span class=\"tok-kw\">const</span> r = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math.rotl\">rotl</a>(<span class=\"tok-type\">u64</span>, self.s[<span class=\"tok-number\">0</span>] +% self.s[<span class=\"tok-number\">3</span>], <span class=\"tok-number\">23</span>) +% self.s[<span class=\"tok-number\">0</span>];\n\n    <span class=\"tok-kw\">const</span> t = self.s[<span class=\"tok-number\">1</span>] &lt;&lt; <span class=\"tok-number\">17</span>;\n\n    self.s[<span class=\"tok-number\">2</span>] ^= self.s[<span class=\"tok-number\">0</span>];\n    self.s[<span class=\"tok-number\">3</span>] ^= self.s[<span class=\"tok-number\">1</span>];\n    self.s[<span class=\"tok-number\">1</span>] ^= self.s[<span class=\"tok-number\">2</span>];\n    self.s[<span class=\"tok-number\">0</span>] ^= self.s[<span class=\"tok-number\">3</span>];\n\n    self.s[<span class=\"tok-number\">2</span>] ^= t;\n\n    self.s[<span class=\"tok-number\">3</span>] = <a href=\"/zig-docs/zh-cn/std/math/#std.math\">math</a>.<a href=\"/zig-docs/zh-cn/std/math/#std.math.rotl\">rotl</a>(<span class=\"tok-type\">u64</span>, self.s[<span class=\"tok-number\">3</span>], <span class=\"tok-number\">45</span>);\n\n    <span class=\"tok-kw\">return</span> r;\n}<span class=\"tok-comment\">\n\n// 在序列中向前跳过 2^128 个位置\n</span><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">jump</span>(self: *<a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256\">Xoshiro256</a>) <span class=\"tok-type\">void</span> {\n    <span class=\"tok-kw\">var</span> s: <span class=\"tok-type\">u256</span> = <span class=\"tok-number\">0</span>;\n\n    <span class=\"tok-kw\">var</span> table: <span class=\"tok-type\">u256</span> = <span class=\"tok-number\">0x39abdc4529b1661ca9582618e03fc9aad5a61266f0c9392c180ec6d33cfd0aba</span>;\n\n    <span class=\"tok-kw\">while</span> (table != <span class=\"tok-number\">0</span>) : (table &gt;&gt;= <span class=\"tok-number\">1</span>) {\n        <span class=\"tok-kw\">if</span> (<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u1</span>, <span class=\"tok-builtin\">@truncate</span>(table)) != <span class=\"tok-number\">0</span>) {\n            s ^= <span class=\"tok-builtin\">@bitCast</span>(self.s);\n        }\n        _ = self.next();\n    }\n\n    self.s = <span class=\"tok-builtin\">@bitCast</span>(s);\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">seed</span>(self: *<a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256\">Xoshiro256</a>, init_s: <span class=\"tok-type\">u64</span>) <span class=\"tok-type\">void</span> {<span class=\"tok-comment\">\n    // Xoshiro 需要 256 位种子。\n    </span><span class=\"tok-kw\">var</span> gen = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Random/#std.Random\">Random</a>.<a href=\"/zig-docs/zh-cn/std/Random/SplitMix64/#std.Random.SplitMix64\">SplitMix64</a>.<a href=\"/zig-docs/zh-cn/std/Random/SplitMix64/#std.Random.SplitMix64.init\">init</a>(init_s);\n\n    self.s[<span class=\"tok-number\">0</span>] = gen.next();\n    self.s[<span class=\"tok-number\">1</span>] = gen.next();\n    self.s[<span class=\"tok-number\">2</span>] = gen.next();\n    self.s[<span class=\"tok-number\">3</span>] = gen.next();\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">fill</span>(self: *<a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256\">Xoshiro256</a>, buf: []<span class=\"tok-type\">u8</span>) <span class=\"tok-type\">void</span> {\n    <span class=\"tok-kw\">var</span> i: <span class=\"tok-type\">usize</span> = <span class=\"tok-number\">0</span>;\n    <span class=\"tok-kw\">const</span> aligned_len = buf.len - (buf.len &amp; <span class=\"tok-number\">7</span>);<span class=\"tok-comment\">\n\n    // 完整的 8 字节段。\n    </span><span class=\"tok-kw\">while</span> (i &lt; aligned_len) : (i += <span class=\"tok-number\">8</span>) {\n        <span class=\"tok-kw\">var</span> n = self.next();\n        <span class=\"tok-kw\">comptime</span> <span class=\"tok-kw\">var</span> j: <span class=\"tok-type\">usize</span> = <span class=\"tok-number\">0</span>;\n        <span class=\"tok-kw\">inline</span> <span class=\"tok-kw\">while</span> (j &lt; <span class=\"tok-number\">8</span>) : (j += <span class=\"tok-number\">1</span>) {\n            buf[i + j] = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u8</span>, <span class=\"tok-builtin\">@truncate</span>(n));\n            n &gt;&gt;= <span class=\"tok-number\">8</span>;\n        }\n    }<span class=\"tok-comment\">\n\n    // 剩余部分。（截断流）\n    </span><span class=\"tok-kw\">if</span> (i != buf.len) {\n        <span class=\"tok-kw\">var</span> n = self.next();\n        <span class=\"tok-kw\">while</span> (i &lt; buf.len) : (i += <span class=\"tok-number\">1</span>) {\n            buf[i] = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u8</span>, <span class=\"tok-builtin\">@truncate</span>(n));\n            n &gt;&gt;= <span class=\"tok-number\">8</span>;\n        }\n    }\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"sequence\"</span> {\n    <span class=\"tok-kw\">var</span> r = <a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256\">Xoshiro256</a>.<a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256.init\">init</a>(<span class=\"tok-number\">0</span>);\n\n    <span class=\"tok-kw\">const</span> seq1 = [_]<span class=\"tok-type\">u64</span>{\n        <span class=\"tok-number\">0x53175d61490b23df</span>,\n        <span class=\"tok-number\">0x61da6f3dc380d507</span>,\n        <span class=\"tok-number\">0x5c0fdf91ec9a7bfc</span>,\n        <span class=\"tok-number\">0x02eebf8c3bbe5e1a</span>,\n        <span class=\"tok-number\">0x7eca04ebaf4a5eea</span>,\n        <span class=\"tok-number\">0x0543c37757f08d9a</span>,\n    };\n\n    <span class=\"tok-kw\">for</span> (seq1) |s| {\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(s == r.next());\n    }\n\n    r.jump();\n\n    <span class=\"tok-kw\">const</span> seq2 = [_]<span class=\"tok-type\">u64</span>{\n        <span class=\"tok-number\">0xae1db5c5e27807be</span>,\n        <span class=\"tok-number\">0xb584c6a7fd8709fe</span>,\n        <span class=\"tok-number\">0xc46a0ee9330fb6e</span>,\n        <span class=\"tok-number\">0xdc0c9606f49ed76e</span>,\n        <span class=\"tok-number\">0x1f5bb6540f6651fb</span>,\n        <span class=\"tok-number\">0x72fa2ca734601488</span>,\n    };\n\n    <span class=\"tok-kw\">for</span> (seq2) |s| {\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(s == r.next());\n    }\n}\n\n<span class=\"tok-kw\">test</span> fill {\n    <span class=\"tok-kw\">var</span> r = <a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256\">Xoshiro256</a>.<a href=\"/zig-docs/zh-cn/std/Random/Xoshiro256/#std.Random.Xoshiro256.init\">init</a>(<span class=\"tok-number\">0</span>);\n\n    <span class=\"tok-kw\">const</span> seq = [_]<span class=\"tok-type\">u64</span>{\n        <span class=\"tok-number\">0x53175d61490b23df</span>,\n        <span class=\"tok-number\">0x61da6f3dc380d507</span>,\n        <span class=\"tok-number\">0x5c0fdf91ec9a7bfc</span>,\n        <span class=\"tok-number\">0x02eebf8c3bbe5e1a</span>,\n        <span class=\"tok-number\">0x7eca04ebaf4a5eea</span>,\n        <span class=\"tok-number\">0x0543c37757f08d9a</span>,\n    };\n\n    <span class=\"tok-kw\">for</span> (seq) |s| {\n        <span class=\"tok-kw\">var</span> buf0: [<span class=\"tok-number\">8</span>]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n        <span class=\"tok-kw\">var</span> buf1: [<span class=\"tok-number\">7</span>]<span class=\"tok-type\">u8</span> = <span class=\"tok-null\">undefined</span>;\n        <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>.<a href=\"/zig-docs/zh-cn/std/mem/#std.mem.writeInt\">writeInt</a>(<span class=\"tok-type\">u64</span>, &amp;buf0, s, .little);\n        r.fill(&amp;buf1);\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/zh-cn/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/mem/#std.mem\">mem</a>.<a href=\"/zig-docs/zh-cn/std/mem/#std.mem.eql\">eql</a>(<span class=\"tok-type\">u8</span>, buf0[<span class=\"tok-number\">0</span>..<span class=\"tok-number\">7</span>], buf1[<span class=\"tok-number\">0</span>..]));\n    }\n}\n</code></pre></div></details>"}

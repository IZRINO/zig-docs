.<a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">ChaCha8IETF</a>;\n\n<span class=\"tok-kw\">const</span> State = [<span class=\"tok-number\">8</span> * <a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.block_length\">block_length</a>]<span class=\"tok-type\">u8</span>;\n\nstate: <a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha.State\">State</a>,\noffset: <span class=\"tok-type\">usize</span>,\n\n<span class=\"tok-kw\">const</span> nonce: [<a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.nonce_length\">nonce_length</a>]<span class=\"tok-type\">u8</span> = <span class=\"tok-builtin\">@splat</span>(<span class=\"tok-number\">0</span>);\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> secret_seed_length = <a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a>;\n\n<span class=\"tok-comment\">/// 种子必须均匀、保密，且长度为 `secret_seed_length` 字节。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">init</span>(secret_seed: [<a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha.secret_seed_length\">secret_seed_length</a>]<span class=\"tok-type\">u8</span>) <a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha\">Self</a> {\n    <span class=\"tok-kw\">var</span> self: <a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha\">Self</a> = .{ .state = <span class=\"tok-null\">undefined</span>, .offset = <span class=\"tok-number\">0</span> };\n    <a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.stream\">stream</a>(&amp;self.state, <span class=\"tok-number\">0</span>, secret_seed, <a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha.nonce\">nonce</a>);\n    <span class=\"tok-kw\">return</span> self;\n}\n\n<span class=\"tok-comment\">/// 注入熵以刷新内部状态。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">addEntropy</span>(self: *<a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha\">Self</a>, bytes: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">void</span> {\n    <span class=\"tok-kw\">var</span> i: <span class=\"tok-type\">usize</span> = <span class=\"tok-number\">0</span>;\n    <span class=\"tok-kw\">while</span> (i + <a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a> &lt;= bytes.len) : (i += <a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a>) {\n        <a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.xor\">xor</a>(\n            self.state[<span class=\"tok-number\">0</span>..<a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a>],\n            self.state[<span class=\"tok-number\">0</span>..<a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a>],\n            <span class=\"tok-number\">0</span>,\n            bytes[i..][<span class=\"tok-number\">0</span>..<a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a>].*,\n            <a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha.nonce\">nonce</a>,\n        );\n    }\n    <span class=\"tok-kw\">if</span> (i &lt; bytes.len) {\n        <span class=\"tok-kw\">var</span> k: [<a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a>]<span class=\"tok-type\">u8</span> = <span class=\"tok-builtin\">@splat</span>(<span class=\"tok-number\">0</span>);\n        <span class=\"tok-kw\">const</span> src = bytes[i..];\n        <span class=\"tok-builtin\">@memcpy</span>(k[<span class=\"tok-number\">0</span>..src.len], src);\n        <a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.xor\">xor</a>(\n            self.state[<span class=\"tok-number\">0</span>..<a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a>],\n            self.state[<span class=\"tok-number\">0</span>..<a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a>],\n            <span class=\"tok-number\">0</span>,\n            k,\n            <a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha.nonce\">nonce</a>,\n        );\n    }\n    self.refill();\n}\n\n<span class=\"tok-comment\">/// 返回由当前随机数生成器提供支持的 `std.Random` 结构体。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">random</span>(self: *<a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha\">Self</a>) <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Random/#std.Random\">Random</a> {\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Random/#std.Random\">Random</a>.<a href=\"/zig-docs/zh-cn/std/Random/#std.Random.init\">init</a>(self, <a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha.fill\">fill</a>);\n}<span class=\"tok-comment\">\n\n// 用随机字节重新填充缓冲区，并覆盖先前的密钥。\n</span><span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">refill</span>(self: *<a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha\">Self</a>) <span class=\"tok-type\">void</span> {\n    <a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.stream\">stream</a>(&amp;self.state, <span class=\"tok-number\">0</span>, self.state[<span class=\"tok-number\">0</span>..<a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a>].*, <a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha.nonce\">nonce</a>);\n    self.offset = <span class=\"tok-number\">0</span>;\n}\n\n<span class=\"tok-comment\">/// 使用随机字节填充缓冲区。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">fill</span>(self: *<a href=\"/zig-docs/zh-cn/std/Random/ChaCha/#std.Random.ChaCha\">Self</a>, buf_: []<span class=\"tok-type\">u8</span>) <span class=\"tok-type\">void</span> {\n    <span class=\"tok-kw\">const</span> bytes = self.state[<a href=\"/zig-docs/zh-cn/std/crypto/chacha20/#std.crypto.chacha20.ChaCha8IETF\">Cipher</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.crypto.stream.chacha.ChaCha8IETF.key_length\">key_length</a>..];\n    <span class=\"tok-kw\">var</span> buf = buf_;\n\n    <span class=\"tok-kw\">const</span> avail = bytes.len - self.offset;\n    <span class=\"tok-kw\">if</span> (avail &gt; <span class=\"tok-number\">0</span>) {<span class=\"tok-comment\">\n        // 当前数据块的字节\n        </span><span class=\"tok-kw\">const</span> n = <span class=\"tok-builtin\">@min</span>(avail, buf.len);\n        <span class=\"tok-builtin\">@memcpy</span>(buf[<span class=\"tok-number\">0</span>..n], bytes[self.offset..][<span class=\"tok-number\">0</span>..n]);\n        <span class=\"tok-builtin\">@memset</span>(bytes[self.offset..][<span class=\"tok-number\">0</span>..n], <span class=\"tok-number\">0</span>);\n        buf = buf[n..];\n        self.offset += n;\n    }\n    <span class=\"tok-kw\">if</span> (buf.len == <span class=\"tok-number\">0</span>) <span class=\"tok-kw\">return</span>;\n\n    self.refill();<span class=\"tok-comment\">\n\n    // 完整块\n    </span><span class=\"tok-kw\">while</span> (buf.len &gt;= bytes.len) {\n        <span class=\"tok-builtin\">@memcpy</span>(buf[<span class=\"tok-number\">0</span>..bytes.len], bytes);\n        buf = buf[bytes.len..];\n        self.refill();\n    }<span class=\"tok-comment\">\n\n    // 剩余字节\n    </span><span class=\"tok-kw\">if</span> (buf.len &gt; <span class=\"tok-number\">0</span>) {\n        <span class=\"tok-builtin\">@memcpy</span>(buf, bytes[<span class=\"tok-number\">0</span>..buf.len]);\n        <span class=\"tok-builtin\">@memset</span>(bytes[<span class=\"tok-number\">0</span>..buf.len], <span class=\"tok-number\">0</span>);\n        self.offset = buf.len;\n    }\n}\n</code></pre></div></details>"}

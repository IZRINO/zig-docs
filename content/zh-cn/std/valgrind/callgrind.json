<a id=\"L51\" href=\"#L51\" tabindex=\"-1\">51</a>\n<a id=\"L52\" href=\"#L52\" tabindex=\"-1\">52</a>\n<a id=\"L53\" href=\"#L53\" tabindex=\"-1\">53</a>\n<a id=\"L54\" href=\"#L54\" tabindex=\"-1\">54</a>\n<a id=\"L55\" href=\"#L55\" tabindex=\"-1\">55</a>\n<a id=\"L56\" href=\"#L56\" tabindex=\"-1\">56</a>\n<a id=\"L57\" href=\"#L57\" tabindex=\"-1\">57</a>\n<a id=\"L58\" href=\"#L58\" tabindex=\"-1\">58</a>\n<a id=\"L59\" href=\"#L59\" tabindex=\"-1\">59</a>\n<a id=\"L60\" href=\"#L60\" tabindex=\"-1\">60</a>\n<a id=\"L61\" href=\"#L61\" tabindex=\"-1\">61</a>\n<a id=\"L62\" href=\"#L62\" tabindex=\"-1\">62</a>\n<a id=\"L63\" href=\"#L63\" tabindex=\"-1\">63</a>\n<a id=\"L64\" href=\"#L64\" tabindex=\"-1\">64</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../std.zig\"</span>);\n<span class=\"tok-kw\">const</span> valgrind = <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/valgrind/#std.valgrind\">valgrind</a>;\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> ClientRequest = <span class=\"tok-kw\">enum</span>(<span class=\"tok-type\">usize</span>) {\n    DumpStats = <a href=\"/zig-docs/zh-cn/std/valgrind/#std.valgrind\">valgrind</a>.<a href=\"/zig-docs/zh-cn/std/valgrind/#std.valgrind.ToolBase\">ToolBase</a>(<span class=\"tok-str\">\"CT\"</span>.*),\n    ZeroStats,\n    ToggleCollect,\n    DumpStatsAt,\n    StartInstrumentation,\n    StopInstrumentation,\n};\n\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">doClientRequestExpr</span>(default: <span class=\"tok-type\">usize</span>, request: <a href=\"/zig-docs/zh-cn/std/valgrind/callgrind/#std.valgrind.callgrind.ClientRequest\">ClientRequest</a>, a1: <span class=\"tok-type\">usize</span>, a2: <span class=\"tok-type\">usize</span>, a3: <span class=\"tok-type\">usize</span>, a4: <span class=\"tok-type\">usize</span>, a5: <span class=\"tok-type\">usize</span>) <span class=\"tok-type\">usize</span> {\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/valgrind/#std.valgrind\">valgrind</a>.<a href=\"/zig-docs/zh-cn/std/valgrind/#std.valgrind.doClientRequest\">doClientRequest</a>(default, <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">usize</span>, <span class=\"tok-builtin\">@intCast</span>(<span class=\"tok-builtin\">@backingInt</span>(request))), a1, a2, a3, a4, a5);\n}\n\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">doClientRequestStmt</span>(request: <a href=\"/zig-docs/zh-cn/std/valgrind/callgrind/#std.valgrind.callgrind.ClientRequest\">ClientRequest</a>, a1: <span class=\"tok-type\">usize</span>, a2: <span class=\"tok-type\">usize</span>, a3: <span class=\"tok-type\">usize</span>, a4: <span class=\"tok-type\">usize</span>, a5: <span class=\"tok-type\">usize</span>) <span class=\"tok-type\">void</span> {\n    _ = <a href=\"/zig-docs/zh-cn/std/valgrind/callgrind/#std.valgrind.callgrind.doClientRequestExpr\">doClientRequestExpr</a>(<span class=\"tok-number\">0</span>, request, a1, a2, a3, a4, a5);\n}\n\n<span class=\"tok-comment\">/// 转储各成本中心的当前状态，然后将其清零</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">dumpStats</span>() <span class=\"tok-type\">void</span> {\n    <a href=\"/zig-docs/zh-cn/std/valgrind/callgrind/#std.valgrind.callgrind.doClientRequestStmt\">doClientRequestStmt</a>(.DumpStats, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>);\n}\n\n<span class=\"tok-comment\">/// 转储当前成本中心状态，然后将其清零。</span>\n<span class=\"tok-comment\">/// 参数会附加到说明转储触发原因的字符串之后。此字符串会作为</span>\n<span class=\"tok-comment\">/// 描述字段写入性能分析数据转储。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">dumpStatsAt</span>(pos_str: [*:<span class=\"tok-number\">0</span>]<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">void</span> {\n    <a href=\"/zig-docs/zh-cn/std/valgrind/callgrind/#std.valgrind.callgrind.doClientRequestStmt\">doClientRequestStmt</a>(.DumpStatsAt, <span class=\"tok-builtin\">@intFromPtr</span>(pos_str), <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>);\n}\n\n<span class=\"tok-comment\">/// 零代价中心</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">zeroStats</span>() <span class=\"tok-type\">void</span> {\n    <a href=\"/zig-docs/zh-cn/std/valgrind/callgrind/#std.valgrind.callgrind.doClientRequestStmt\">doClientRequestStmt</a>(.ZeroStats, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>);\n}\n\n<span class=\"tok-comment\">/// 切换收集状态。</span>\n<span class=\"tok-comment\">/// 收集状态指定是否记录</span>\n<span class=\"tok-comment\">/// 事件的发生，或忽略事件。通过递增</span>\n<span class=\"tok-comment\">/// 成本中心的计数器记录事件。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">toggleCollect</span>() <span class=\"tok-type\">void</span> {\n    <a href=\"/zig-docs/zh-cn/std/valgrind/callgrind/#std.valgrind.callgrind.doClientRequestStmt\">doClientRequestStmt</a>(.ToggleCollect, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>);\n}\n\n<span class=\"tok-comment\">/// 如果尚未启用，则启动完整 callgrind 插桩。</span>\n<span class=\"tok-comment\">/// 进行缓存模拟时，会清空模拟缓存；</span>\n<span class=\"tok-comment\">/// 这会导致之后出现人为的缓存预热阶段，</span>\n<span class=\"tok-comment\">/// 产生现实中不会发生的缓存未命中。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">startInstrumentation</span>() <span class=\"tok-type\">void</span> {\n    <a href=\"/zig-docs/zh-cn/std/valgrind/callgrind/#std.valgrind.callgrind.doClientRequestStmt\">doClientRequestStmt</a>(.StartInstrumentation, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>);\n}\n\n<span class=\"tok-comment\">/// 若尚未关闭，则停止全部 Callgrind 插桩。</span>\n<span class=\"tok-comment\">/// 这会刷新 Valgrind 的翻译缓存，之后不再执行额外</span>\n<span class=\"tok-comment\">/// 插桩，实际运行速度与 \"none\" 工具</span>\n<span class=\"tok-comment\">/// 相同，即开销最小。</span>\n<span class=\"tok-comment\">/// 可用于让无关代码绕过 Callgrind 的统计汇总。</span>\n<span class=\"tok-comment\">/// 若希望启动 Callgrind 时即采用此模式，以忽略准备阶段，</span>\n<span class=\"tok-comment\">/// 使用选项 \"--instr-atstart=no\"。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">stopInstrumentation</span>() <span class=\"tok-type\">void</span> {\n    <a href=\"/zig-docs/zh-cn/std/valgrind/callgrind/#std.valgrind.callgrind.doClientRequestStmt\">doClientRequestStmt</a>(.StopInstrumentation, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>, <span class=\"tok-number\">0</span>);\n}\n</code></pre></div></details>"}

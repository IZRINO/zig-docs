dex=\"-1\">136</a>\n<a id=\"L137\" href=\"#L137\" tabindex=\"-1\">137</a>\n<a id=\"L138\" href=\"#L138\" tabindex=\"-1\">138</a>\n<a id=\"L139\" href=\"#L139\" tabindex=\"-1\">139</a>\n<a id=\"L140\" href=\"#L140\" tabindex=\"-1\">140</a>\n<a id=\"L141\" href=\"#L141\" tabindex=\"-1\">141</a>\n<a id=\"L142\" href=\"#L142\" tabindex=\"-1\">142</a>\n<a id=\"L143\" href=\"#L143\" tabindex=\"-1\">143</a>\n<a id=\"L144\" href=\"#L144\" tabindex=\"-1\">144</a>\n<a id=\"L145\" href=\"#L145\" tabindex=\"-1\">145</a>\n<a id=\"L146\" href=\"#L146\" tabindex=\"-1\">146</a>\n<a id=\"L147\" href=\"#L147\" tabindex=\"-1\">147</a>\n<a id=\"L148\" href=\"#L148\" tabindex=\"-1\">148</a>\n<a id=\"L149\" href=\"#L149\" tabindex=\"-1\">149</a>\n<a id=\"L150\" href=\"#L150\" tabindex=\"-1\">150</a>\n<a id=\"L151\" href=\"#L151\" tabindex=\"-1\">151</a>\n<a id=\"L152\" href=\"#L152\" tabindex=\"-1\">152</a>\n<a id=\"L153\" href=\"#L153\" tabindex=\"-1\">153</a>\n<a id=\"L154\" href=\"#L154\" tabindex=\"-1\">154</a>\n<a id=\"L155\" href=\"#L155\" tabindex=\"-1\">155</a>\n<a id=\"L156\" href=\"#L156\" tabindex=\"-1\">156</a>\n<a id=\"L157\" href=\"#L157\" tabindex=\"-1\">157</a>\n<a id=\"L158\" href=\"#L158\" tabindex=\"-1\">158</a>\n<a id=\"L159\" href=\"#L159\" tabindex=\"-1\">159</a>\n<a id=\"L160\" href=\"#L160\" tabindex=\"-1\">160</a>\n<a id=\"L161\" href=\"#L161\" tabindex=\"-1\">161</a>\n<a id=\"L162\" href=\"#L162\" tabindex=\"-1\">162</a>\n<a id=\"L163\" href=\"#L163\" tabindex=\"-1\">163</a>\n<a id=\"L164\" href=\"#L164\" tabindex=\"-1\">164</a>\n<a id=\"L165\" href=\"#L165\" tabindex=\"-1\">165</a>\n<a id=\"L166\" href=\"#L166\" tabindex=\"-1\">166</a>\n<a id=\"L167\" href=\"#L167\" tabindex=\"-1\">167</a>\n<a id=\"L168\" href=\"#L168\" tabindex=\"-1\">168</a>\n<a id=\"L169\" href=\"#L169\" tabindex=\"-1\">169</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"../std.zig\"</span>);\n\n<span class=\"tok-comment\">/// 压缩和解压时，给定缓冲区用作</span>\n<span class=\"tok-comment\">/// 历史窗口，因此其大小必须至少达到此值。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> max_window_len = <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.history_len\">history_len</a> * <span class=\"tok-number\">2</span>;\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> history_len = <span class=\"tok-number\">32768</span>;\n\n<span class=\"tok-comment\">/// Deflate 是一种无损数据压缩文件格式，</span>\n<span class=\"tok-comment\">/// 结合使用 LZ77 与 Huffman 编码。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Compress = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"flate/Compress.zig\"</span>);\n\n<span class=\"tok-comment\">/// Inflate 是解码过程，消耗 Deflate 位流，</span>\n<span class=\"tok-comment\">/// 产生原始完整大小的数据。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Decompress = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"flate/Decompress.zig\"</span>);\n\n<span class=\"tok-comment\">/// deflate 位流主体的容器。容器在 deflate 位流之前添加头部，</span>\n<span class=\"tok-comment\">/// 在其之后添加尾部。可以是 gzip、zlib 或 raw，即无头部、</span>\n<span class=\"tok-comment\">/// 无尾部的原始位流。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// zlib 格式定义于 RFC 1950。头部为 2 字节，尾部为 4 字节的</span>\n<span class=\"tok-comment\">/// Adler-32 校验和。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// gzip 格式定义于 RFC 1952。头部至少为 10 字节，尾部包含 4 字节的</span>\n<span class=\"tok-comment\">/// CRC32 校验和及 4 字节的未压缩数据长度。</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// rfc 1950：https://datatracker.ietf.org/doc/html/rfc1950#page-4</span>\n<span class=\"tok-comment\">/// rfc 1952：https://datatracker.ietf.org/doc/html/rfc1952#page-5</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Container = <span class=\"tok-kw\">enum</span> {\n    raw,<span class=\"tok-comment\"> // 无头部或尾部\n    </span>gzip,<span class=\"tok-comment\"> // gzip 头部和尾部\n    </span>zlib,<span class=\"tok-comment\"> // zlib 头部与尾部\n\n    </span><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">size</span>(w: <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container\">Container</a>) <span class=\"tok-type\">usize</span> {\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container.headerSize\">headerSize</a>(w) + <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container.footerSize\">footerSize</a>(w);\n    }\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">headerSize</span>(w: <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container\">Container</a>) <span class=\"tok-type\">usize</span> {\n        <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container.header\">header</a>(w).len;\n    }\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">footerSize</span>(w: <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container\">Container</a>) <span class=\"tok-type\">usize</span> {\n        <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">switch</span> (w) {\n            .gzip =&gt; <span class=\"tok-number\">8</span>,\n            .zlib =&gt; <span class=\"tok-number\">4</span>,\n            .raw =&gt; <span class=\"tok-number\">0</span>,\n        };\n    }\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> list = [_]<a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container\">Container</a>{ .raw, .gzip, .zlib };\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Error = <span class=\"tok-kw\">error</span>{\n        BadGzipHeader,\n        BadZlibHeader,\n        WrongGzipChecksum,\n        WrongGzipSize,\n        WrongZlibChecksum,\n    };\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">header</span>(container: <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container\">Container</a>) []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span> {\n        <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">switch</span> (container) {<span class=\"tok-comment\">\n            // GZIP 的 10 字节头部（https://datatracker.ietf.org/doc/html/rfc1952#page-5）：\n            //  - ID1，标识 1，始终为 0x1f\n            //  - ID2，标识 2，始终为 0x8b\n            //  - CM，压缩方法，始终为 8 = deflate\n            //  - FLG，标志，全部设为 0\n            //  - 4 字节 MTIME，修改时间，未使用，全部设为零\n            //  - XFL，额外标志，全部设为零\n            //  - OS，操作系统，03 = Unix\n            </span>.gzip =&gt; &amp;[_]<span class=\"tok-type\">u8</span>{ <span class=\"tok-number\">0x1f</span>, <span class=\"tok-number\">0x8b</span>, <span class=\"tok-number\">0x08</span>, <span class=\"tok-number\">0x00</span>, <span class=\"tok-number\">0x00</span>, <span class=\"tok-number\">0x00</span>, <span class=\"tok-number\">0x00</span>, <span class=\"tok-number\">0x00</span>, <span class=\"tok-number\">0x00</span>, <span class=\"tok-number\">0x03</span> },<span class=\"tok-comment\">\n            // ZLIB 有一个双字节报头（https://datatracker.ietf.org/doc/html/rfc1950#page-4）：\n            // 第一个字节：\n            //  - 前四位为 CINFO，即压缩信息；默认 deflate 窗口大小对应 7。\n            //  - 后四位为 CM，即压缩方法；deflate 对应 8。\n            // 第二个字节：\n            //  - 两位为 FLEVEL，即压缩级别，值为：0=最快，1=快速，2=默认，3=最佳。\n            //  - 下一位 FDICT 在提供字典时置位。\n            //  - 最后五位 FCHECK 构成模 31 校验和。\n            //\n            // CINFO = 7, CM = 8, FLEVEL = 0b10, FDICT = 0, FCHECK = 0b11100\n            </span>.zlib =&gt; &amp;[_]<span class=\"tok-type\">u8</span>{ <span class=\"tok-number\">0x78</span>, <span class=\"tok-number\">0b10_0_11100</span> },\n            .raw =&gt; &amp;.{},\n        };\n    }\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Hasher = <span class=\"tok-kw\">union</span>(Container) {\n        raw: <span class=\"tok-type\">void</span>,\n        gzip: <span class=\"tok-kw\">struct</span> {\n            crc: <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/hash/#std.hash\">hash</a>.<a href=\"/zig-docs/zh-cn/std/hash/crc/#std.hash.crc.%40%22CRC-32%2FISO-HDLC%22\">Crc32</a> = .init(),\n            count: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">0</span>,\n        },\n        zlib: <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/hash/#std.hash\">hash</a>.<a href=\"/zig-docs/zh-cn/std/hash/Adler32/#std.hash.Adler32\">Adler32</a>,\n\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">init</span>(containter: <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container\">Container</a>) <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container.Hasher\">Hasher</a> {\n            <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">switch</span> (containter) {\n                .gzip =&gt; .{ .gzip = .{} },\n                .zlib =&gt; .{ .zlib = .{} },\n                .raw =&gt; .raw,\n            };\n        }\n\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">container</span>(h: <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container.Hasher\">Hasher</a>) <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container\">Container</a> {\n            <span class=\"tok-kw\">return</span> h;\n        }\n\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">update</span>(h: *<a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container.Hasher\">Hasher</a>, buf: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">void</span> {\n            <span class=\"tok-kw\">switch</span> (h.*) {\n                .raw =&gt; {},\n                .gzip =&gt; |*gzip| {\n                    gzip.crc.update(buf);\n                    gzip.count +%= <span class=\"tok-builtin\">@truncate</span>(buf.len);\n                },\n                .zlib =&gt; |*zlib| {\n                    zlib.update(buf);\n                },\n            }\n        }\n\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">writeFooter</span>(hasher: *<a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container.Hasher\">Hasher</a>, writer: *<a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/Writer/#std.Io.Writer\">Writer</a>) <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/zh-cn/std/Io/Writer/#std.Io.Writer\">Writer</a>.<a href=\"/zig-docs/zh-cn/std/Io/Writer/#std.Io.Writer.Error\">Error</a>!<span class=\"tok-type\">void</span> {\n            <span class=\"tok-kw\">switch</span> (hasher.*) {\n                .gzip =&gt; |*gzip| {<span class=\"tok-comment\">\n                    // GZIP 的 8 字节尾部\n                    //  - 4 字节，CRC32（CRC-32）\n                    //  - 4 字节，ISIZE（输入大小）：原始未压缩输入数据的大小对 2^32 取模\n                    //\n                    </span><span class=\"tok-kw\">try</span> writer.writeInt(<span class=\"tok-type\">u32</span>, gzip.crc.final(), .little);\n                    <span class=\"tok-kw\">try</span> writer.writeInt(<span class=\"tok-type\">u32</span>, gzip.count, .little);\n                },\n                .zlib =&gt; |*zlib| {<span class=\"tok-comment\">\n                    // ZLIB（RFC 1950）采用大端，与 GZIP（RFC 1952）不同。\n                    // 4 字节 ADLER32（Adler-32 校验和）。\n                    // 根据 Adler-32 算法计算的未压缩数据\n                    // 校验和值，不包括任何\n                    // 字典数据。\n                    </span><span class=\"tok-kw\">try</span> writer.writeInt(<span class=\"tok-type\">u32</span>, zlib.adler, .big);\n                },\n                .raw =&gt; {},\n            }\n        }\n    };\n\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Metadata = <span class=\"tok-kw\">union</span>(Container) {\n        raw: <span class=\"tok-type\">void</span>,\n        gzip: <span class=\"tok-kw\">struct</span> {\n            crc: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">0</span>,\n            count: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">0</span>,\n        },\n        zlib: <span class=\"tok-kw\">struct</span> {\n            adler: <span class=\"tok-type\">u32</span> = <span class=\"tok-number\">0</span>,\n        },\n\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">init</span>(containter: <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container\">Container</a>) <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container.Metadata\">Metadata</a> {\n            <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">switch</span> (containter) {\n                .gzip =&gt; .{ .gzip = .{} },\n                .zlib =&gt; .{ .zlib = .{} },\n                .raw =&gt; .raw,\n            };\n        }\n\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">container</span>(m: <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container.Metadata\">Metadata</a>) <a href=\"/zig-docs/zh-cn/std/compress/flate/#std.compress.flate.Container\">Container</a> {\n            <span class=\"tok-kw\">return</span> m;\n        }\n    };\n};\n\n<span class=\"tok-kw\">test</span> {\n    _ = <a href=\"/zig-docs/zh-cn/std/compress/flate/Compress/#std.compress.flate.Compress\">Compress</a>;\n    _ = <a href=\"/zig-docs/zh-cn/std/compress/flate/Decompress/#std.compress.flate.Decompress\">Decompress</a>;\n}\n</code></pre></div></details>"}

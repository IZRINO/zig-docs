href=\"#L8\" tabindex=\"-1\">8</a>\n<a id=\"L9\" href=\"#L9\" tabindex=\"-1\">9</a>\n<a id=\"L10\" href=\"#L10\" tabindex=\"-1\">10</a>\n<a id=\"L11\" href=\"#L11\" tabindex=\"-1\">11</a>\n<a id=\"L12\" href=\"#L12\" tabindex=\"-1\">12</a>\n<a id=\"L13\" href=\"#L13\" tabindex=\"-1\">13</a>\n<a id=\"L14\" href=\"#L14\" tabindex=\"-1\">14</a>\n<a id=\"L15\" href=\"#L15\" tabindex=\"-1\">15</a>\n<a id=\"L16\" href=\"#L16\" tabindex=\"-1\">16</a>\n<a id=\"L17\" href=\"#L17\" tabindex=\"-1\">17</a>\n<a id=\"L18\" href=\"#L18\" tabindex=\"-1\">18</a>\n<a id=\"L19\" href=\"#L19\" tabindex=\"-1\">19</a>\n<a id=\"L20\" href=\"#L20\" tabindex=\"-1\">20</a>\n<a id=\"L21\" href=\"#L21\" tabindex=\"-1\">21</a>\n<a id=\"L22\" href=\"#L22\" tabindex=\"-1\">22</a>\n<a id=\"L23\" href=\"#L23\" tabindex=\"-1\">23</a>\n<a id=\"L24\" href=\"#L24\" tabindex=\"-1\">24</a>\n<a id=\"L25\" href=\"#L25\" tabindex=\"-1\">25</a>\n<a id=\"L26\" href=\"#L26\" tabindex=\"-1\">26</a>\n<a id=\"L27\" href=\"#L27\" tabindex=\"-1\">27</a>\n<a id=\"L28\" href=\"#L28\" tabindex=\"-1\">28</a>\n<a id=\"L29\" href=\"#L29\" tabindex=\"-1\">29</a>\n<a id=\"L30\" href=\"#L30\" tabindex=\"-1\">30</a>\n<a id=\"L31\" href=\"#L31\" tabindex=\"-1\">31</a>\n<a id=\"L32\" href=\"#L32\" tabindex=\"-1\">32</a>\n<a id=\"L33\" href=\"#L33\" tabindex=\"-1\">33</a>\n<a id=\"L34\" href=\"#L34\" tabindex=\"-1\">34</a>\n<a id=\"L35\" href=\"#L35\" tabindex=\"-1\">35</a>\n<a id=\"L36\" href=\"#L36\" tabindex=\"-1\">36</a>\n<a id=\"L37\" href=\"#L37\" tabindex=\"-1\">37</a>\n<a id=\"L38\" href=\"#L38\" tabindex=\"-1\">38</a>\n<a id=\"L39\" href=\"#L39\" tabindex=\"-1\">39</a>\n<a id=\"L40\" href=\"#L40\" tabindex=\"-1\">40</a>\n<a id=\"L41\" href=\"#L41\" tabindex=\"-1\">41</a>\n<a id=\"L42\" href=\"#L42\" tabindex=\"-1\">42</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> builtin = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"builtin\"</span>);\n<span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std.zig\"</span>);\n<span class=\"tok-kw\">const</span> native_os = <a href=\"/zig-docs/zh-cn/std/os/#std.os.builtin\">builtin</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.os.builtin.os\">os</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.os.builtin.os.tag\">tag</a>;\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> linux = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"os/linux.zig\"</span>);\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> plan9 = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"os/plan9.zig\"</span>);\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> uefi = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"os/uefi.zig\"</span>);\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> wasi = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"os/wasi.zig\"</span>);\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> emscripten = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"os/emscripten.zig\"</span>);\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> windows = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"os/windows.zig\"</span>);\n\n<span class=\"tok-comment\">/// 返回 Zig 标准库在给定目标上与操作系统交互时</span>\n<span class=\"tok-comment\">/// 是否需要 libc。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">targetRequiresLibC</span>(target: *<span class=\"tok-kw\">const</span> <a href=\"/zig-docs/zh-cn/std/#std\">std</a>.<a href=\"/zig-docs/zh-cn/std/Target/#std.Target\">Target</a>) <span class=\"tok-type\">bool</span> {\n    <span class=\"tok-kw\">if</span> (target.requiresLibC()) <span class=\"tok-kw\">return</span> <span class=\"tok-null\">true</span>;\n    <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">switch</span> (target.os.tag) {\n        .linux =&gt; <span class=\"tok-kw\">switch</span> (target.cpu.arch) {<span class=\"tok-comment\">\n            // https://codeberg.org/ziglang/zig/issues/30943\n            </span>.hppa,\n            .hppa64,\n            =&gt; <span class=\"tok-null\">true</span>,\n            <span class=\"tok-kw\">else</span> =&gt; <span class=\"tok-null\">false</span>,\n        },\n        .freebsd =&gt; <span class=\"tok-null\">true</span>,<span class=\"tok-comment\"> // https://codeberg.org/ziglang/zig/issues/30981\n        </span>.netbsd =&gt; <span class=\"tok-null\">true</span>,<span class=\"tok-comment\"> // https://codeberg.org/ziglang/zig/issues/30980\n        </span>.openbsd =&gt; <span class=\"tok-null\">true</span>,<span class=\"tok-comment\"> // https://codeberg.org/ziglang/zig/issues/30982\n        </span><span class=\"tok-kw\">else</span> =&gt; <span class=\"tok-null\">false</span>,\n    };\n}\n\n<span class=\"tok-comment\">/// 返回 Zig 标准库在当前目标上与操作系统交互时</span>\n<span class=\"tok-comment\">/// 是否需要 libc。</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">requiresLibC</span>() <span class=\"tok-type\">bool</span> {\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/zh-cn/std/os/#std.os.targetRequiresLibC\">targetRequiresLibC</a>(&amp;<a href=\"/zig-docs/zh-cn/std/os/#std.os.builtin\">builtin</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.os.builtin.target\">target</a>);\n}\n\n<span class=\"tok-kw\">test</span> {\n    _ = <a href=\"/zig-docs/zh-cn/std/os/linux/#std.os.linux\">linux</a>;\n    <span class=\"tok-kw\">if</span> (<a href=\"/zig-docs/zh-cn/std/os/#std.os.native_os\">native_os</a> == .uefi) _ = <a href=\"/zig-docs/zh-cn/std/os/uefi/#std.os.uefi\">uefi</a>;\n    _ = <a href=\"/zig-docs/zh-cn/std/os/wasi/#std.os.wasi\">wasi</a>;\n    _ = <a href=\"/zig-docs/zh-cn/std/os/windows/#std.os.windows\">windows</a>;\n}\n</code></pre></div></details>"}

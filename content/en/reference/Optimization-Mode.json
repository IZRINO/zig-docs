{"id":"reference/Optimization-Mode","kind":"langref","title":"Optimization Mode","sourceUrl":"https://ziglang.org/documentation/0.17.0/#Optimization-Mode","file":"reference/Optimization-Mode.json","headings":[{"depth":2,"slug":"Optimization-Mode","text":"Optimization Mode"},{"depth":3,"slug":"debug","text":"debug"},{"depth":3,"slug":"fast","text":"fast"},{"depth":3,"slug":"safe","text":"safe"},{"depth":3,"slug":"small","text":"small"}],"html":"<h2 id=\"Optimization-Mode\" class=\"chapter-anchor\" aria-hidden=\"true\"><a href=\"/zig-docs/en/reference/Optimization-Mode/#Optimization-Mode\">Optimization Mode</a> </h2>\n\n      <p>\n      Zig has four optimization modes:\n      </p>\n      <ul>\n        <li><a href=\"/zig-docs/en/reference/Optimization-Mode/#debug\">debug</a> (default)</li>\n        <li><a href=\"/zig-docs/en/reference/Optimization-Mode/#fast\">fast</a></li>\n        <li><a href=\"/zig-docs/en/reference/Optimization-Mode/#safe\">safe</a></li>\n        <li><a href=\"/zig-docs/en/reference/Optimization-Mode/#small\">small</a></li>\n      </ul>\n      <p>\n      To add standard build options to a <code class=\"file\">build.zig</code> file:\n      </p>\n      <div class=\"expressive-code\"><figure class=\"frame has-title\"><figcaption class=\"header\"><span class=\"title\">build.zig</span></figcaption><pre data-language=\"zig\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#BF3441;--1:#F97583\">const</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">std</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#005CC5;--1:#79B8FF\">@import</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#032F62;--1:#9ECBFF\">\"std\"</span><span style=\"--0:#24292E;--1:#E1E4E8\">);</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#BF3441;--1:#F97583\">pub</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">fn</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#6F42C1;--1:#B392F0\">build</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#AE4B07;--1:#FFAB70\">b</span><span style=\"--0:#24292E;--1:#E1E4E8\">: </span><span style=\"--0:#BF3441;--1:#F97583\">*</span><span style=\"--0:#AE4B07;--1:#FFAB70\">std</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#AE4B07;--1:#FFAB70\">Build</span><span style=\"--0:#24292E;--1:#E1E4E8\">) </span><span style=\"--0:#BF3441;--1:#F97583\">void</span><span style=\"--0:#24292E;--1:#E1E4E8\"> {</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#BF3441;--1:#F97583\">const</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">optimize</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">b</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#6F42C1;--1:#B392F0\">standardOptimizeOption</span><span style=\"--0:#24292E;--1:#E1E4E8\">(.{});</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#BF3441;--1:#F97583\">const</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">exe</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">b</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#6F42C1;--1:#B392F0\">addExecutable</span><span style=\"--0:#24292E;--1:#E1E4E8\">(.{</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">        </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#AE4B07;--1:#FFAB70\">name</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#032F62;--1:#9ECBFF\">\"example\"</span><span style=\"--0:#24292E;--1:#E1E4E8\">,</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">        </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#AE4B07;--1:#FFAB70\">root_module</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">b</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#6F42C1;--1:#B392F0\">createModule</span><span style=\"--0:#24292E;--1:#E1E4E8\">(.{</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">            </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#AE4B07;--1:#FFAB70\">root_source_file</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">b</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#6F42C1;--1:#B392F0\">path</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#032F62;--1:#9ECBFF\">\"example.zig\"</span><span style=\"--0:#24292E;--1:#E1E4E8\">),</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">            </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#AE4B07;--1:#FFAB70\">optimize</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#BF3441;--1:#F97583\">=</span><span style=\"--0:#24292E;--1:#E1E4E8\"> </span><span style=\"--0:#AE4B07;--1:#FFAB70\">optimize</span><span style=\"--0:#24292E;--1:#E1E4E8\">,</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">        </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">}),</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\"><span style=\"--0:#24292E;--1:#E1E4E8\">    </span></span><span style=\"--0:#24292E;--1:#E1E4E8\">});</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span class=\"indent\">    </span><span style=\"--0:#AE4B07;--1:#FFAB70\">b</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#AE4B07;--1:#FFAB70\">default_step</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#6F42C1;--1:#B392F0\">dependOn</span><span style=\"--0:#24292E;--1:#E1E4E8\">(</span><span style=\"--0:#BF3441;--1:#F97583\">&amp;</span><span style=\"--0:#AE4B07;--1:#FFAB70\">exe</span><span style=\"--0:#24292E;--1:#E1E4E8\">.</span><span style=\"--0:#AE4B07;--1:#FFAB70\">step</span><span style=\"--0:#24292E;--1:#E1E4E8\">);</span></div></div>\n<div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">}</span></div></div></code></pre></figure></div>\n\n      <p>\n      This causes these options to be available:\n      </p>\n      <dl>\n        <dt><kbd>-Doptimize=debug</kbd></dt><dd>Optimizations off and safety on (default)</dd>\n        <dt><kbd>-Doptimize=safe</kbd></dt><dd>Optimizations on and safety on</dd>\n        <dt><kbd>-Doptimize=fast</kbd></dt><dd>Optimizations on and safety off</dd>\n        <dt><kbd>-Doptimize=small</kbd></dt><dd>Size optimizations on and safety off</dd>\n      </dl>\n      <h3 id=\"debug\"><a href=\"/zig-docs/en/reference/Optimization-Mode/#debug\">debug</a> </h3>\n\n      <div class=\"expressive-code\"><figure class=\"frame is-terminal has-title\"><figcaption class=\"header\"><span class=\"title\">Terminal</span></figcaption><pre data-language=\"shellsession\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">$ zig build-exe example.zig</span></div></div>\n</code></pre></figure></div>\n      <ul>\n        <li>Fast compilation speed</li>\n        <li>Safety checks enabled</li>\n        <li>Slow runtime performance</li>\n        <li>Large binary size</li>\n        <li>No reproducible build requirement</li>\n      </ul>\n      \n      <h3 id=\"fast\"><a href=\"/zig-docs/en/reference/Optimization-Mode/#fast\">fast</a> </h3>\n\n      <div class=\"expressive-code\"><figure class=\"frame is-terminal has-title\"><figcaption class=\"header\"><span class=\"title\">Terminal</span></figcaption><pre data-language=\"shellsession\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">$ zig build-exe example.zig -Ofast</span></div></div>\n</code></pre></figure></div>\n      <ul>\n        <li>Fast runtime performance</li>\n        <li>Safety checks disabled</li>\n        <li>Slow compilation speed</li>\n        <li>Large binary size</li>\n        <li>Reproducible build</li>\n      </ul>\n      \n      <h3 id=\"safe\"><a href=\"/zig-docs/en/reference/Optimization-Mode/#safe\">safe</a> </h3>\n\n      <div class=\"expressive-code\"><figure class=\"frame is-terminal has-title\"><figcaption class=\"header\"><span class=\"title\">Terminal</span></figcaption><pre data-language=\"shellsession\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">$ zig build-exe example.zig -Osafe</span></div></div>\n</code></pre></figure></div>\n      <ul>\n        <li>Medium runtime performance</li>\n        <li>Safety checks enabled</li>\n        <li>Slow compilation speed</li>\n        <li>Large binary size</li>\n        <li>Reproducible build</li>\n      </ul>\n      \n      <h3 id=\"small\"><a href=\"/zig-docs/en/reference/Optimization-Mode/#small\">small</a> </h3>\n\n      <div class=\"expressive-code\"><figure class=\"frame is-terminal has-title\"><figcaption class=\"header\"><span class=\"title\">Terminal</span></figcaption><pre data-language=\"shellsession\" data-code-frame=\"true\" tabindex=\"0\"><code><div class=\"ec-line\"><div class=\"code\"><span style=\"--0:#24292E;--1:#E1E4E8\">$ zig build-exe example.zig -Osmall</span></div></div>\n</code></pre></figure></div>\n      <ul>\n        <li>Medium runtime performance</li>\n        <li>Safety checks disabled</li>\n        <li>Slow compilation speed</li>\n        <li>Small binary size</li>\n        <li>Reproducible build</li>\n      </ul>\n      \n      <p>See also:</p><ul>\n<li><a href=\"/zig-docs/en/reference/Compile-Variables/#Compile-Variables\">Compile Variables</a></li>\n<li><a href=\"/zig-docs/en/reference/Zig-Build-System/#Zig-Build-System\">Zig Build System</a></li>\n<li><a href=\"/zig-docs/en/reference/Illegal-Behavior/#Illegal-Behavior\">Illegal Behavior</a></li>\n</ul>\n\n      \n\n      "}

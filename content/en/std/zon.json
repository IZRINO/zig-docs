{"id":"std/zon","kind":"std","title":"std.zon","sourcePath":"std/zon.zig","sourceUrl":"https://ziglang.org/documentation/0.17.0/std/#std.zon","file":"std/zon.json","headings":[{"depth":2,"slug":"std.zon","text":"std.zon"},{"depth":3,"slug":"std.zon.fmt","text":"std.zon.fmt"},{"depth":3,"slug":"std.zon.Formatter","text":"std.zon.Formatter"},{"depth":3,"slug":"std.zon.Formatter.format","text":"std.zon.Formatter.format"},{"depth":3,"slug":"std.zon.parse","text":"std.zon.parse"},{"depth":3,"slug":"std.zon.Serializer","text":"std.zon.Serializer"},{"depth":3,"slug":"std.zon.std","text":"std.zon.std"},{"depth":3,"slug":"std.zon.stringify","text":"std.zon.stringify"},{"depth":2,"slug":"source","text":"Source code"}],"symbols":[{"id":"std/zon.zig:1:31645","name":"std.zon","anchor":"std.zon","category":"namespace","sourceLine":1},{"id":"std/zon.zig:47:31650","name":"std.zon.fmt","anchor":"std.zon.fmt","category":"function","sourceLine":47},{"id":"std/zon.zig:74:31651","name":"std.zon.Formatter","anchor":"std.zon.Formatter","category":"type-function","sourceLine":74},{"id":"std/zon.zig:79:31652","name":"std.zon.Formatter.format","anchor":"std.zon.Formatter.format","category":"function","sourceLine":79},{"id":"std/zon.zig:42:31647","name":"std.zon.parse","anchor":"std.zon.parse","category":"alias","sourceLine":42},{"id":"std/zon.zig:44:31649","name":"std.zon.Serializer","anchor":"std.zon.Serializer","category":"alias","sourceLine":44},{"id":"std/zon.zig:40:31646","name":"std.zon.std","anchor":"std.zon.std","category":"alias","sourceLine":40},{"id":"std/zon.zig:43:31648","name":"std.zon.stringify","anchor":"std.zon.stringify","category":"alias","sourceLine":43}],"html":"<div id=\"std.zon\"></div>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L1\">Source line 1</a></p>\n<div class=\"api-description\"><p>ZON parsing and stringification.</p>\n<p>ZON (\"Zig Object Notation\") is a textual file format. Outside of <code>nan</code> and <code>inf</code> literals, ZON's\ngrammar is a subset of Zig's.</p>\n<p>Supported Zig primitives:</p>\n<ul>\n<li>boolean literals</li>\n<li>number literals (including <code>nan</code> and <code>inf</code>)</li>\n<li>character literals</li>\n<li>enum literals</li>\n<li><code>null</code> literals</li>\n<li>string literals</li>\n<li>multiline string literals</li>\n</ul>\n<p>Supported Zig container types:</p>\n<ul>\n<li>anonymous struct literals</li>\n<li>anonymous tuple literals</li>\n</ul>\n<p>Here is an example ZON object:</p>\n<pre><code>.{\n    .a = 1.5,\n    .b = \"hello, world!\",\n    .c = .{ true, false },\n    .d = .{ 1, 2, 3 },\n    .e = .{ .x = 13, .y = 67 },\n}\n</code></pre>\n<p>Individual primitives are also valid ZON, for example:</p>\n<pre><code>\"This string is a valid ZON object.\"\n</code></pre>\n<p>ZON may not contain type names.</p>\n<p>ZON does not have syntax for pointers, but the parsers will allocate as needed to match the\ngiven Zig types. Similarly, the serializer will traverse pointers.</p>\n</div>\n<div class=\"api-members\"><ul>\n<li><a href=\"/zig-docs/en/std/#std\"><code>std</code></a></li>\n<li><a href=\"/zig-docs/en/std/zon/parse/#std.zon.parse\"><code>parse</code></a></li>\n<li><a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify\"><code>stringify</code></a></li>\n<li><a href=\"/zig-docs/en/std/zon/Serializer/#std.zon.Serializer\"><code>Serializer</code></a></li>\n<li><a href=\"/zig-docs/en/std/zon/#std.zon.fmt\"><code>fmt</code></a></li>\n<li><a href=\"/zig-docs/en/std/zon/#std.zon.Formatter\"><code>Formatter</code></a></li>\n</ul></div>\n<section class=\"api-entry\" id=\"std.zon.fmt\"><h3><code>std.zon.fmt</code></h3>\n<p class=\"api-kind\">function</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L47\">Source line 47</a></p>\n<div class=\"api-description\"><p>Returns a formatter that formats the given value using stringify.</p>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">fmt</span>(value: <span class=\"tok-kw\">anytype</span>, options: <a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify\">stringify</a>.<a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify.SerializeOptions\">SerializeOptions</a>) <a href=\"/zig-docs/en/std/zon/#std.zon.Formatter\">Formatter</a>(<span class=\"tok-builtin\">@TypeOf</span>(value))</code></pre>\n<h4>Parameters</h4><div class=\"api-parameters\">\n<pre><code>options: <a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify\">stringify</a>.<a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify.SerializeOptions\">SerializeOptions</a></code></pre>\n</div>\n<h4>Example usage</h4><pre><code><span class=\"tok-kw\">test</span> fmt {\n    <span class=\"tok-kw\">const</span> expectFmt = <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectFmt\">expectFmt</a>;\n    <span class=\"tok-kw\">try</span> expectFmt(<span class=\"tok-str\">\"123\"</span>, <span class=\"tok-str\">\"{f}\"</span>, .{<a href=\"/zig-docs/en/std/zon/#std.zon.fmt\">fmt</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u32</span>, <span class=\"tok-number\">123</span>), .{})});\n    <span class=\"tok-kw\">try</span> expectFmt(\n        <span class=\"tok-str\">\\\\.{</span>\n        <span class=\"tok-str\">\\\\    .num = 927,</span>\n        <span class=\"tok-str\">\\\\    .msg = \"hello\",</span>\n        <span class=\"tok-str\">\\\\    .sub = .{ .mybool = true },</span>\n        <span class=\"tok-str\">\\\\}</span>\n    , <span class=\"tok-str\">\"{f}\"</span>, .{<a href=\"/zig-docs/en/std/zon/#std.zon.fmt\">fmt</a>(<span class=\"tok-kw\">struct</span> {\n        num: <span class=\"tok-type\">u32</span>,\n        msg: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>,\n        sub: <span class=\"tok-kw\">struct</span> {\n            mybool: <span class=\"tok-type\">bool</span>,\n        },\n    }{\n        .num = <span class=\"tok-number\">927</span>,\n        .msg = <span class=\"tok-str\">\"hello\"</span>,\n        .sub = .{ .mybool = <span class=\"tok-null\">true</span> },\n    }, .{})});\n}</code></pre>\n</section>\n<section class=\"api-entry\" id=\"std.zon.Formatter\"><h3><code>std.zon.Formatter</code></h3>\n<p class=\"api-kind\">type-function</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L74\">Source line 74</a></p>\n<div class=\"api-description\"><p>Formats the given value using stringify.</p>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">Formatter</span>(<span class=\"tok-kw\">comptime</span> T: <span class=\"tok-type\">type</span>) <span class=\"tok-type\">type</span></code></pre>\n<h4>Parameters</h4><div class=\"api-parameters\">\n<pre><code>T: <span class=\"tok-type\">type</span></code></pre>\n</div>\n<h4>Fields</h4><div class=\"api-fields\">\n<pre><code>value: T</code></pre><div class=\"fieldDocs\"></div>\n<pre><code>options: <a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify\">stringify</a>.<a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify.SerializeOptions\">SerializeOptions</a></code></pre><div class=\"fieldDocs\"></div>\n</div>\n<div class=\"api-members\"><ul>\n<li><a href=\"/zig-docs/en/std/zon/#std.zon.Formatter.format\"><code>format</code></a></li>\n</ul></div>\n</section>\n<section class=\"api-entry\" id=\"std.zon.Formatter.format\"><h3><code>std.zon.Formatter.format</code></h3>\n<p class=\"api-kind\">function</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L79\">Source line 79</a></p>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">format</span>(self: <span class=\"tok-builtin\">@This</span>(), writer: *<a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/en/std/Io/Writer/#std.Io.Writer\">Writer</a>) <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/en/std/Io/Writer/#std.Io.Writer\">Writer</a>.<a href=\"/zig-docs/en/std/Io/Writer/#std.Io.Writer.Error\">Error</a>!<span class=\"tok-type\">void</span></code></pre>\n<h4>Parameters</h4><div class=\"api-parameters\">\n<pre><code>self: <span class=\"tok-builtin\">@This</span>()</code></pre>\n<pre><code>writer: *<a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/en/std/Io/Writer/#std.Io.Writer\">Writer</a></code></pre>\n</div>\n<h4>Errors</h4><dl>\n<dt>WriteFailed</dt><dd><p>See the <code><a href=\"/zig-docs/en/std/Io/Writer/#std.Io.Writer\">Writer</a></code> implementation for detailed diagnostics.</p>\n</dd>\n</dl>\n</section>\n<section class=\"api-entry\" id=\"std.zon.parse\"><h3><code>std.zon.parse</code></h3>\n<p class=\"api-kind\">alias</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L42\">Source line 42</a></p>\n<p>Alias of <a href=\"/zig-docs/en/std/zon/parse/#std.zon.parse\"><code>std.zon.parse</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.zon.Serializer\"><h3><code>std.zon.Serializer</code></h3>\n<p class=\"api-kind\">alias</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L44\">Source line 44</a></p>\n<p>Alias of <a href=\"/zig-docs/en/std/zon/Serializer/#std.zon.Serializer\"><code>std.zon.Serializer</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.zon.std\"><h3><code>std.zon.std</code></h3>\n<p class=\"api-kind\">alias</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L40\">Source line 40</a></p>\n<p>Alias of <a href=\"/zig-docs/en/std/#std\"><code>std</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.zon.stringify\"><h3><code>std.zon.stringify</code></h3>\n<p class=\"api-kind\">alias</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L43\">Source line 43</a></p>\n<p>Alias of <a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify\"><code>std.zon.stringify</code></a></p>\n</section>\n<details class=\"source-code\" id=\"source\" data-pagefind-ignore=\"\"><summary>Source code</summary><p><code>std/zon.zig</code></p><div class=\"source-grid\"><pre class=\"line-numbers\" aria-hidden=\"true\" data-copy-ignore=\"\"><code><a id=\"L1\" href=\"#L1\" tabindex=\"-1\">1</a>\n<a id=\"L2\" href=\"#L2\" tabindex=\"-1\">2</a>\n<a id=\"L3\" href=\"#L3\" tabindex=\"-1\">3</a>\n<a id=\"L4\" href=\"#L4\" tabindex=\"-1\">4</a>\n<a id=\"L5\" href=\"#L5\" tabindex=\"-1\">5</a>\n<a id=\"L6\" href=\"#L6\" tabindex=\"-1\">6</a>\n<a id=\"L7\" href=\"#L7\" tabindex=\"-1\">7</a>\n<a id=\"L8\" href=\"#L8\" tabindex=\"-1\">8</a>\n<a id=\"L9\" href=\"#L9\" tabindex=\"-1\">9</a>\n<a id=\"L10\" href=\"#L10\" tabindex=\"-1\">10</a>\n<a id=\"L11\" href=\"#L11\" tabindex=\"-1\">11</a>\n<a id=\"L12\" href=\"#L12\" tabindex=\"-1\">12</a>\n<a id=\"L13\" href=\"#L13\" tabindex=\"-1\">13</a>\n<a id=\"L14\" href=\"#L14\" tabindex=\"-1\">14</a>\n<a id=\"L15\" href=\"#L15\" tabindex=\"-1\">15</a>\n<a id=\"L16\" href=\"#L16\" tabindex=\"-1\">16</a>\n<a id=\"L17\" href=\"#L17\" tabindex=\"-1\">17</a>\n<a id=\"L18\" href=\"#L18\" tabindex=\"-1\">18</a>\n<a id=\"L19\" href=\"#L19\" tabindex=\"-1\">19</a>\n<a id=\"L20\" href=\"#L20\" tabindex=\"-1\">20</a>\n<a id=\"L21\" href=\"#L21\" tabindex=\"-1\">21</a>\n<a id=\"L22\" href=\"#L22\" tabindex=\"-1\">22</a>\n<a id=\"L23\" href=\"#L23\" tabindex=\"-1\">23</a>\n<a id=\"L24\" href=\"#L24\" tabindex=\"-1\">24</a>\n<a id=\"L25\" href=\"#L25\" tabindex=\"-1\">25</a>\n<a id=\"L26\" href=\"#L26\" tabindex=\"-1\">26</a>\n<a id=\"L27\" href=\"#L27\" tabindex=\"-1\">27</a>\n<a id=\"L28\" href=\"#L28\" tabindex=\"-1\">28</a>\n<a id=\"L29\" href=\"#L29\" tabindex=\"-1\">29</a>\n<a id=\"L30\" href=\"#L30\" tabindex=\"-1\">30</a>\n<a id=\"L31\" href=\"#L31\" tabindex=\"-1\">31</a>\n<a id=\"L32\" href=\"#L32\" tabindex=\"-1\">32</a>\n<a id=\"L33\" href=\"#L33\" tabindex=\"-1\">33</a>\n<a id=\"L34\" href=\"#L34\" tabindex=\"-1\">34</a>\n<a id=\"L35\" href=\"#L35\" tabindex=\"-1\">35</a>\n<a id=\"L36\" href=\"#L36\" tabindex=\"-1\">36</a>\n<a id=\"L37\" href=\"#L37\" tabindex=\"-1\">37</a>\n<a id=\"L38\" href=\"#L38\" tabindex=\"-1\">38</a>\n<a id=\"L39\" href=\"#L39\" tabindex=\"-1\">39</a>\n<a id=\"L40\" href=\"#L40\" tabindex=\"-1\">40</a>\n<a id=\"L41\" href=\"#L41\" tabindex=\"-1\">41</a>\n<a id=\"L42\" href=\"#L42\" tabindex=\"-1\">42</a>\n<a id=\"L43\" href=\"#L43\" tabindex=\"-1\">43</a>\n<a id=\"L44\" href=\"#L44\" tabindex=\"-1\">44</a>\n<a id=\"L45\" href=\"#L45\" tabindex=\"-1\">45</a>\n<a id=\"L46\" href=\"#L46\" tabindex=\"-1\">46</a>\n<a id=\"L47\" href=\"#L47\" tabindex=\"-1\">47</a>\n<a id=\"L48\" href=\"#L48\" tabindex=\"-1\">48</a>\n<a id=\"L49\" href=\"#L49\" tabindex=\"-1\">49</a>\n<a id=\"L50\" href=\"#L50\" tabindex=\"-1\">50</a>\n<a id=\"L51\" href=\"#L51\" tabindex=\"-1\">51</a>\n<a id=\"L52\" href=\"#L52\" tabindex=\"-1\">52</a>\n<a id=\"L53\" href=\"#L53\" tabindex=\"-1\">53</a>\n<a id=\"L54\" href=\"#L54\" tabindex=\"-1\">54</a>\n<a id=\"L55\" href=\"#L55\" tabindex=\"-1\">55</a>\n<a id=\"L56\" href=\"#L56\" tabindex=\"-1\">56</a>\n<a id=\"L57\" href=\"#L57\" tabindex=\"-1\">57</a>\n<a id=\"L58\" href=\"#L58\" tabindex=\"-1\">58</a>\n<a id=\"L59\" href=\"#L59\" tabindex=\"-1\">59</a>\n<a id=\"L60\" href=\"#L60\" tabindex=\"-1\">60</a>\n<a id=\"L61\" href=\"#L61\" tabindex=\"-1\">61</a>\n<a id=\"L62\" href=\"#L62\" tabindex=\"-1\">62</a>\n<a id=\"L63\" href=\"#L63\" tabindex=\"-1\">63</a>\n<a id=\"L64\" href=\"#L64\" tabindex=\"-1\">64</a>\n<a id=\"L65\" href=\"#L65\" tabindex=\"-1\">65</a>\n<a id=\"L66\" href=\"#L66\" tabindex=\"-1\">66</a>\n<a id=\"L67\" href=\"#L67\" tabindex=\"-1\">67</a>\n<a id=\"L68\" href=\"#L68\" tabindex=\"-1\">68</a>\n<a id=\"L69\" href=\"#L69\" tabindex=\"-1\">69</a>\n<a id=\"L70\" href=\"#L70\" tabindex=\"-1\">70</a>\n<a id=\"L71\" href=\"#L71\" tabindex=\"-1\">71</a>\n<a id=\"L72\" href=\"#L72\" tabindex=\"-1\">72</a>\n<a id=\"L73\" href=\"#L73\" tabindex=\"-1\">73</a>\n<a id=\"L74\" href=\"#L74\" tabindex=\"-1\">74</a>\n<a id=\"L75\" href=\"#L75\" tabindex=\"-1\">75</a>\n<a id=\"L76\" href=\"#L76\" tabindex=\"-1\">76</a>\n<a id=\"L77\" href=\"#L77\" tabindex=\"-1\">77</a>\n<a id=\"L78\" href=\"#L78\" tabindex=\"-1\">78</a>\n<a id=\"L79\" href=\"#L79\" tabindex=\"-1\">79</a>\n<a id=\"L80\" href=\"#L80\" tabindex=\"-1\">80</a>\n<a id=\"L81\" href=\"#L81\" tabindex=\"-1\">81</a>\n<a id=\"L82\" href=\"#L82\" tabindex=\"-1\">82</a>\n<a id=\"L83\" href=\"#L83\" tabindex=\"-1\">83</a>\n<a id=\"L84\" href=\"#L84\" tabindex=\"-1\">84</a>\n<a id=\"L85\" href=\"#L85\" tabindex=\"-1\">85</a>\n<a id=\"L86\" href=\"#L86\" tabindex=\"-1\">86</a>\n<a id=\"L87\" href=\"#L87\" tabindex=\"-1\">87</a>\n<a id=\"L88\" href=\"#L88\" tabindex=\"-1\">88</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">//! ZON parsing and stringification.</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! ZON (\"Zig Object Notation\") is a textual file format. Outside of `nan` and `inf` literals, ZON's</span>\n<span class=\"tok-comment\">//! grammar is a subset of Zig's.</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! Supported Zig primitives:</span>\n<span class=\"tok-comment\">//! * boolean literals</span>\n<span class=\"tok-comment\">//! * number literals (including `nan` and `inf`)</span>\n<span class=\"tok-comment\">//! * character literals</span>\n<span class=\"tok-comment\">//! * enum literals</span>\n<span class=\"tok-comment\">//! * `null` literals</span>\n<span class=\"tok-comment\">//! * string literals</span>\n<span class=\"tok-comment\">//! * multiline string literals</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! Supported Zig container types:</span>\n<span class=\"tok-comment\">//! * anonymous struct literals</span>\n<span class=\"tok-comment\">//! * anonymous tuple literals</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! Here is an example ZON object:</span>\n<span class=\"tok-comment\">//! ```</span>\n<span class=\"tok-comment\">//! .{</span>\n<span class=\"tok-comment\">//!     .a = 1.5,</span>\n<span class=\"tok-comment\">//!     .b = \"hello, world!\",</span>\n<span class=\"tok-comment\">//!     .c = .{ true, false },</span>\n<span class=\"tok-comment\">//!     .d = .{ 1, 2, 3 },</span>\n<span class=\"tok-comment\">//!     .e = .{ .x = 13, .y = 67 },</span>\n<span class=\"tok-comment\">//! }</span>\n<span class=\"tok-comment\">//! ```</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! Individual primitives are also valid ZON, for example:</span>\n<span class=\"tok-comment\">//! ```</span>\n<span class=\"tok-comment\">//! \"This string is a valid ZON object.\"</span>\n<span class=\"tok-comment\">//! ```</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! ZON may not contain type names.</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! ZON does not have syntax for pointers, but the parsers will allocate as needed to match the</span>\n<span class=\"tok-comment\">//! given Zig types. Similarly, the serializer will traverse pointers.</span>\n\n<span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> parse = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"zon/parse.zig\"</span>);\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> stringify = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"zon/stringify.zig\"</span>);\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> Serializer = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"zon/Serializer.zig\"</span>);\n\n<span class=\"tok-comment\">/// Returns a formatter that formats the given value using stringify.</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">fmt</span>(value: <span class=\"tok-kw\">anytype</span>, options: <a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify\">stringify</a>.<a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify.SerializeOptions\">SerializeOptions</a>) <a href=\"/zig-docs/en/std/zon/#std.zon.Formatter\">Formatter</a>(<span class=\"tok-builtin\">@TypeOf</span>(value)) {\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/en/std/zon/#std.zon.Formatter\">Formatter</a>(<span class=\"tok-builtin\">@TypeOf</span>(value)){ .value = value, .options = options };\n}\n\n<span class=\"tok-kw\">test</span> fmt {\n    <span class=\"tok-kw\">const</span> expectFmt = <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectFmt\">expectFmt</a>;\n    <span class=\"tok-kw\">try</span> expectFmt(<span class=\"tok-str\">\"123\"</span>, <span class=\"tok-str\">\"{f}\"</span>, .{<a href=\"/zig-docs/en/std/zon/#std.zon.fmt\">fmt</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u32</span>, <span class=\"tok-number\">123</span>), .{})});\n    <span class=\"tok-kw\">try</span> expectFmt(\n        <span class=\"tok-str\">\\\\.{</span>\n        <span class=\"tok-str\">\\\\    .num = 927,</span>\n        <span class=\"tok-str\">\\\\    .msg = \"hello\",</span>\n        <span class=\"tok-str\">\\\\    .sub = .{ .mybool = true },</span>\n        <span class=\"tok-str\">\\\\}</span>\n    , <span class=\"tok-str\">\"{f}\"</span>, .{<a href=\"/zig-docs/en/std/zon/#std.zon.fmt\">fmt</a>(<span class=\"tok-kw\">struct</span> {\n        num: <span class=\"tok-type\">u32</span>,\n        msg: []<span class=\"tok-kw\">const</span> <span class=\"tok-type\">u8</span>,\n        sub: <span class=\"tok-kw\">struct</span> {\n            mybool: <span class=\"tok-type\">bool</span>,\n        },\n    }{\n        .num = <span class=\"tok-number\">927</span>,\n        .msg = <span class=\"tok-str\">\"hello\"</span>,\n        .sub = .{ .mybool = <span class=\"tok-null\">true</span> },\n    }, .{})});\n}\n\n<span class=\"tok-comment\">/// Formats the given value using stringify.</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">Formatter</span>(<span class=\"tok-kw\">comptime</span> T: <span class=\"tok-type\">type</span>) <span class=\"tok-type\">type</span> {\n    <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">struct</span> {\n        value: T,\n        options: <a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify\">stringify</a>.<a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify.SerializeOptions\">SerializeOptions</a>,\n\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">format</span>(self: <span class=\"tok-builtin\">@This</span>(), writer: *<a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/en/std/Io/Writer/#std.Io.Writer\">Writer</a>) <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/Io/#std.Io\">Io</a>.<a href=\"/zig-docs/en/std/Io/Writer/#std.Io.Writer\">Writer</a>.<a href=\"/zig-docs/en/std/Io/Writer/#std.Io.Writer.Error\">Error</a>!<span class=\"tok-type\">void</span> {\n            <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify\">stringify</a>.<a href=\"/zig-docs/en/std/zon/stringify/#std.zon.stringify.serialize\">serialize</a>(self.value, self.options, writer);\n        }\n    };\n}\n\n<span class=\"tok-kw\">test</span> {\n    _ = <a href=\"/zig-docs/en/std/zon/parse/#std.zon.parse\">parse</a>;\n    _ = <a h
e>log2</code></a></li>\n</ul></div>\n<section class=\"api-entry\" id=\"std.math.log2.builtin\"><h3><code>std.math.log2.builtin</code></h3>\n<p class=\"api-kind\">constant</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L2\">Source line 2</a></p>\n</section>\n<section class=\"api-entry\" id=\"std.math.log2.expect\"><h3><code>std.math.log2.expect</code></h3>\n<p class=\"api-kind\">alias</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L4\">Source line 4</a></p>\n<p>Alias of <a href=\"/zig-docs/en/std/testing/#std.testing.expect\"><code>std.testing.expect</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.math.log2.log2\"><h3><code>std.math.log2.log2</code></h3>\n<p class=\"api-kind\">function</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L13\">Source line 13</a></p>\n<div class=\"api-description\"><p>Returns the base-2 logarithm of x.</p>\n<p>Special Cases:</p>\n<ul>\n<li>log2(+inf)  = +inf</li>\n<li>log2(0)     = -inf</li>\n<li>log2(x)     = nan if x &lt; 0</li>\n<li>log2(nan)   = nan</li>\n</ul>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">log2</span>(x: <span class=\"tok-kw\">anytype</span>) <span class=\"tok-builtin\">@TypeOf</span>(x)</code></pre>\n<h4>Example usage</h4><pre><code><span class=\"tok-kw\">test</span> log2 {<span class=\"tok-comment\">\n    // https://github.com/ziglang/zig/issues/13703\n    </span><span class=\"tok-kw\">if</span> (<a href=\"/zig-docs/en/std/math/log2/#std.math.log2.builtin\">builtin</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.math.log2.builtin.cpu\">cpu</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.math.log2.builtin.cpu.arch\">arch</a> == .aarch64 <span class=\"tok-kw\">and</span> <a href=\"/zig-docs/en/std/math/log2/#std.math.log2.builtin\">builtin</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.math.log2.builtin.os\">os</a>.<a href=\"https://ziglang.org/documentation/0.17.0/std/#std.math.log2.builtin.os.tag\">tag</a> == .windows) <span class=\"tok-kw\">return</span> <span class=\"tok-kw\">error</span>.SkipZigTest;\n\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/en/std/math/log2/#std.math.log2.log2\">log2</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f32</span>, <span class=\"tok-number\">0.2</span>)) == <span class=\"tok-builtin\">@log2</span>(<span class=\"tok-number\">0.2</span>));\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/en/std/math/log2/#std.math.log2.log2\">log2</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f64</span>, <span class=\"tok-number\">0.2</span>)) == <span class=\"tok-builtin\">@log2</span>(<span class=\"tok-number\">0.2</span>));\n    <span class=\"tok-kw\">comptime</span> {\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/en/std/math/log2/#std.math.log2.log2\">log2</a>(<span class=\"tok-number\">1</span>) == <span class=\"tok-number\">0</span>);\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/en/std/math/log2/#std.math.log2.log2\">log2</a>(<span class=\"tok-number\">15</span>) == <span class=\"tok-number\">3</span>);\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/en/std/math/log2/#std.math.log2.log2\">log2</a>(<span class=\"tok-number\">16</span>) == <span class=\"tok-number\">4</span>);\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/en/std/math/log2/#std.math.log2.log2\">log2</a>(<span class=\"tok-number\">1</span> &lt;&lt; <span class=\"tok-number\">4073</span>) == <span class=\"tok-number\">4073</span>);\n    }\n}</code></pre>\n</section>\n<section class=\"api-entry\" id=\"std.math.log2.math\"><h3><code>std.math.log2.math</code></h3>\n<p class=\"api-kind\">alias</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L3\">Source line 3</a></p>\n<p>Alias of <a href=\"/zig-docs/en/std/math/#std.math\"><code>std.math</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.math.log2.std\"><h3><code>std.math.log2.std</code></h3>\n<p class=\"api-kind\">alias</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L1\">Source line 1</a></p>\n<p>Alias of <a href=\"/zig-docs/en/std/#std\"><code>std</code></a></p>\n</section>\n<details class=\"source-code\" id=\"source\" data-pagefind-ignore=\"\"><summary>Source code</summary><p><code>std/math/log2.zig</code></p><div class=\"source-grid\"><pre class=\"line-numbers\" aria-hidden=\"true\" data-copy-ignore=\"\"><code><a id=\"L1\" href=\"#L1\" tabindex=\"-1\">1</a>\n<a id=\"L2\" href=\"#L2\" tabindex=\"-1\">2</a>\n<a id=\"L3\" href=\"#L3\" tabindex=\"-1\">3</a>\n<a id=\"L4\" href=\"#L4\" tabindex=\"-1\">4</a>\n<a id=\"L5\" href=\"#L5\" tabindex=\"-1\">5</a>\n<a id=\"L6\" href=\"#L6\" tabindex=\"-1\">6</a>\n<a id=\"L7\" href=\"#L7\" tabindex=\"-1\">7</a>\n<a id=\"L8\" href=\"#L8\" tabindex=\"-1\">8</a>\n<a id=\"L9\" href=\"#L9\" tabindex=\"-1\">9</a>\n<a id=\"L10\" href=\"#L10\" tabindex=\"-1\">10</a>\n<a id=\"L11\" href=\"#L11\" tabindex=\"-1\">11</a>\n<a id=\"L12\" href=\"#L12\" tabindex=\"-1\">12</a>\n<a id=\"L13\" href=\"#L13\" tabindex=\"-1\">13</a>\n<a id=\"L14\" href=\"#L14\" tabindex=\"-1\">14</a>\n<a id=\"L15\" href=\"#L15\" tabindex=\"-1\">15</a>\n<a id=\"L16\" href=\"#L16\" tabindex=\"-1\">16</a>\n<a id=\"L17\" href=\"#L17\" tabindex=\"-1\">17</a>\n<a id=\"L18\" href=\"#L18\" tabindex=\"-1\">18</a>\n<a id=\"L19\" href=\"#L19\" tabindex=\"-1\">19</a>\n<a id=\"L20\" href=\"#L20\" tabindex=\"-1\">20</a>\n<a id=\"L21
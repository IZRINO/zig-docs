as</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L7\">Source line 7</a></p>\n<div class=\"api-description\"><p>Returns a * FLT_RADIX ^ exp.</p>\n<p>Zig only supports binary base IEEE-754 floats. Hence FLT_RADIX=2, and this is an alias for ldexp.</p>\n</div>\n<p>Alias of <a href=\"/zig-docs/en/std/math/ldexp/#std.math.ldexp.ldexp\"><code>std.math.ldexp.ldexp</code></a></p>\n</section>\n<section class=\"api-entry\" id=\"std.math.scalbn.std\"><h3><code>std.math.scalbn.std</code></h3>\n<p class=\"api-kind\">alias</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L1\">Source line 1</a></p>\n<p>Alias of <a href=\"/zig-docs/en/std/#std\"><code>std</code></a></p>\n</section>\n<details class=\"source-code\" id=\"source\" data-pagefind-ignore=\"\"><summary>Source code</summary><p><code>std/math/scalbn.zig</code></p><div class=\"source-grid\"><pre class=\"line-numbers\" aria-hidden=\"true\" data-copy-ignore=\"\"><code><a id=\"L1\" href=\"#L1\" tabindex=\"-1\">1</a>\n<a id=\"L2\" href=\"#L2\" tabindex=\"-1\">2</a>\n<a id=\"L3\" href=\"#L3\" tabindex=\"-1\">3</a>\n<a id=\"L4\" href=\"#L4\" tabindex=\"-1\">4</a>\n<a id=\"L5\" href=\"#L5\" tabindex=\"-1\">5</a>\n<a id=\"L6\" href=\"#L6\" tabindex=\"-1\">6</a>\n<a id=\"L7\" href=\"#L7\" tabindex=\"-1\">7</a>\n<a id=\"L8\" href=\"#L8\" tabindex=\"-1\">8</a>\n<a id=\"L9\" href=\"#L9\" tabindex=\"-1\">9</a>\n<a id=\"L10\" href=\"#L10\" tabindex=\"-1\">10</a>\n<a id=\"L11\" href=\"#L11\" tabindex=\"-1\">11</a>\n<a id=\"L12\" href=\"#L12\" tabindex=\"-1\">12</a>\n<a id=\"L13\" href=\"#L13\" tabindex=\"-1\">13</a>\n<a id=\"L14\" href=\"#L14\" tabindex=\"-1\">14</a>\n<a id=\"L15\" href=\"#L15\" tabindex=\"-1\">15</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n<span class=\"tok-kw\">const</span> expect = <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>;\n\n<span class=\"tok-comment\">/// Returns a * FLT_RADIX ^ exp.</span>\n<span class=\"tok-comment\">///</span>\n<span class=\"tok-comment\">/// Zig only supports binary base IEEE-754 floats. Hence FLT_RADIX=2, and this is an alias for ldexp.</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">const</span> scalbn = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"ldexp.zig\"</span>).ldexp;\n\n<span class=\"tok-kw\">test</span> scalbn {<span class=\"tok-comment\">\n    // Verify we are using base 2.\n    </span><span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/en/std/math/ldexp/#std.math.ldexp.ldexp\">scalbn</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f16</span>, <span class=\"tok-number\">1.5</span>), <span class=\"tok-number\">4</span>) == <span class=\"tok-number\">24.0</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/en/std/math/ldexp/#std.math.ldexp.ldexp\">scalbn</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f32</span>, <span class=\"tok-number\">1.5</span>), <span class=\"tok-number\">4</span>) == <span class=\"tok-number\">24.0</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/en/std/math/ldexp/#std.math.ldexp.ldexp\">scalbn</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f64</span>, <span class=\"tok-number\">1.5</span>), <span class=\"tok-number\">4</span>) == <span class=\"tok-number\">24.0</span>);\n    <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing.expect\">expect</a>(<a href=\"/zig-docs/en/std/math/ldexp/#std.math.ldexp.ldexp\">scalbn</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">f128</span>, <span class=\"tok-number\">1.5</span>), <span class=\"tok-number\">4</span>) == <span class=\"tok-number\">24.0</span>);\n}\n</code></pre></div></details>"}

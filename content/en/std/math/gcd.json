{"id":"std/math/gcd","kind":"std","title":"std.math.gcd","sourcePath":"std/math/gcd.zig","sourceUrl":"https://ziglang.org/documentation/0.17.0/std/#std.math.gcd","file":"std/math/gcd.json","headings":[{"depth":2,"slug":"std.math.gcd","text":"std.math.gcd"},{"depth":3,"slug":"std.math.gcd.gcd","text":"std.math.gcd.gcd"},{"depth":3,"slug":"std.math.gcd.std","text":"std.math.gcd.std"},{"depth":2,"slug":"source","text":"Source code"}],"symbols":[{"id":"std/math/gcd.zig:1:1893","name":"std.math.gcd","anchor":"std.math.gcd","category":"namespace","sourceLine":1},{"id":"std/math/gcd.zig:6:1895","name":"std.math.gcd.gcd","anchor":"std.math.gcd.gcd","category":"function","sourceLine":6},{"id":"std/math/gcd.zig:2:1894","name":"std.math.gcd.std","anchor":"std.math.gcd.std","category":"alias","sourceLine":2}],"html":"<div id=\"std.math.gcd\"></div>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L1\">Source line 1</a></p>\n<div class=\"api-description\"><p>Greatest common divisor (<a href=\"https://mathworld.wolfram.com/GreatestCommonDivisor.html\">https://mathworld.wolfram.com/GreatestCommonDivisor.html</a>)</p>\n</div>\n<div class=\"api-members\"><ul>\n<li><a href=\"/zig-docs/en/std/#std\"><code>std</code></a></li>\n<li><a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\"><code>gcd</code></a></li>\n</ul></div>\n<section class=\"api-entry\" id=\"std.math.gcd.gcd\"><h3><code>std.math.gcd.gcd</code></h3>\n<p class=\"api-kind\">function</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L6\">Source line 6</a></p>\n<div class=\"api-description\"><p>Returns the greatest common divisor (GCD) of two unsigned integers (<code>a</code> and <code>b</code>) which are not both zero.\nFor example, the GCD of <code>8</code> and <code>12</code> is <code>4</code>, that is, <code>gcd(8, 12) == 4</code>.</p>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">gcd</span>(a: <span class=\"tok-kw\">anytype</span>, b: <span class=\"tok-kw\">anytype</span>) <span class=\"tok-builtin\">@TypeOf</span>(a, b)</code></pre>\n<h4>Example usage</h4><pre><code><span class=\"tok-kw\">test</span> gcd {\n    <span class=\"tok-kw\">const</span> expectEqual = <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectEqual\">expectEqual</a>;\n\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">0</span>, <span class=\"tok-number\">5</span>), <span class=\"tok-number\">5</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">5</span>, <span class=\"tok-number\">0</span>), <span class=\"tok-number\">5</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">8</span>, <span class=\"tok-number\">12</span>), <span class=\"tok-number\">4</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">12</span>, <span class=\"tok-number\">8</span>), <span class=\"tok-number\">4</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">33</span>, <span class=\"tok-number\">77</span>), <span class=\"tok-number\">11</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">77</span>, <span class=\"tok-number\">33</span>), <span class=\"tok-number\">11</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">49865</span>, <span class=\"tok-number\">69811</span>), <span class=\"tok-number\">9973</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">300_000</span>, <span class=\"tok-number\">2_300_000</span>), <span class=\"tok-number\">100_000</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">90000000_000_000_000_000_000</span>, <span class=\"tok-number\">2</span>), <span class=\"tok-number\">2</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u80</span>, <span class=\"tok-number\">90000000_000_000_000_000_000</span>), <span class=\"tok-number\">2</span>), <span class=\"tok-number\">2</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">300_000</span>, <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u32</span>, <span class=\"tok-number\">2_300_000</span>)), <span class=\"tok-number\">100_000</span>);\n}</code></pre>\n</section>\n<section class=\"api-entry\" id=\"std.math.gcd.std\"><h3><code>std.math.gcd.std</code></h3>\n<p class=\"api-kind\">alias</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L2\">Source line 2</a></p>\n<p>Alias of <a href=\"/zig-docs/en/std/#std\"><code>std</code></a></p>\n</section>\n<details class=\"source-code\" id=\"source\" data-pagefind-ignore=\"\"><summary>Source code</summary><p><code>std/math/gcd.zig</code></p><div class=\"source-grid\"><pre class=\"line-numbers\" aria-hidden=\"true\" data-copy-ignore=\"\"><code><a id=\"L1\" href=\"#L1\" tabindex=\"-1\">1</a>\n<a id=\"L2\" href=\"#L2\" tabindex=\"-1\">2</a>\n<a id=\"L3\" href=\"#L3\" tabindex=\"-1\">3</a>\n<a id=\"L4\" href=\"#L4\" tabindex=\"-1\">4</a>\n<a id=\"L5\" href=\"#L5\" tabindex=\"-1\">5</a>\n<a id=\"L6\" href=\"#L6\" tabindex=\"-1\">6</a>\n<a id=\"L7\" href=\"#L7\" tabindex=\"-1\">7</a>\n<a id=\"L8\" href=\"#L8\" tabindex=\"-1\">8</a>\n<a id=\"L9\" href=\"#L9\" tabindex=\"-1\">9</a>\n<a id=\"L10\" href=\"#L10\" tabindex=\"-1\">10</a>\n<a id=\"L11\" href=\"#L11\" tabindex=\"-1\">11</a>\n<a id=\"L12\" href=\"#L12\" tabindex=\"-1\">12</a>\n<a id=\"L13\" href=\"#L13\" tabindex=\"-1\">13</a>\n<a id=\"L14\" href=\"#L14\" tabindex=\"-1\">14</a>\n<a id=\"L15\" href=\"#L15\" tabindex=\"-1\">15</a>\n<a id=\"L16\" href=\"#L16\" tabindex=\"-1\">16</a>\n<a id=\"L17\" href=\"#L17\" tabindex=\"-1\">17</a>\n<a id=\"L18\" href=\"#L18\" tabindex=\"-1\">18</a>\n<a id=\"L19\" href=\"#L19\" tabindex=\"-1\">19</a>\n<a id=\"L20\" href=\"#L20\" tabindex=\"-1\">20</a>\n<a id=\"L21\" href=\"#L21\" tabindex=\"-1\">21</a>\n<a id=\"L22\" href=\"#L22\" tabindex=\"-1\">22</a>\n<a id=\"L23\" href=\"#L23\" tabindex=\"-1\">23</a>\n<a id=\"L24\" href=\"#L24\" tabindex=\"-1\">24</a>\n<a id=\"L25\" href=\"#L25\" tabindex=\"-1\">25</a>\n<a id=\"L26\" href=\"#L26\" tabindex=\"-1\">26</a>\n<a id=\"L27\" href=\"#L27\" tabindex=\"-1\">27</a>\n<a id=\"L28\" href=\"#L28\" tabindex=\"-1\">28</a>\n<a id=\"L29\" href=\"#L29\" tabindex=\"-1\">29</a>\n<a id=\"L30\" href=\"#L30\" tabindex=\"-1\">30</a>\n<a id=\"L31\" href=\"#L31\" tabindex=\"-1\">31</a>\n<a id=\"L32\" href=\"#L32\" tabindex=\"-1\">32</a>\n<a id=\"L33\" href=\"#L33\" tabindex=\"-1\">33</a>\n<a id=\"L34\" href=\"#L34\" tabindex=\"-1\">34</a>\n<a id=\"L35\" href=\"#L35\" tabindex=\"-1\">35</a>\n<a id=\"L36\" href=\"#L36\" tabindex=\"-1\">36</a>\n<a id=\"L37\" href=\"#L37\" tabindex=\"-1\">37</a>\n<a id=\"L38\" href=\"#L38\" tabindex=\"-1\">38</a>\n<a id=\"L39\" href=\"#L39\" tabindex=\"-1\">39</a>\n<a id=\"L40\" href=\"#L40\" tabindex=\"-1\">40</a>\n<a id=\"L41\" href=\"#L41\" tabindex=\"-1\">41</a>\n<a id=\"L42\" href=\"#L42\" tabindex=\"-1\">42</a>\n<a id=\"L43\" href=\"#L43\" tabindex=\"-1\">43</a>\n<a id=\"L44\" href=\"#L44\" tabindex=\"-1\">44</a>\n<a id=\"L45\" href=\"#L45\" tabindex=\"-1\">45</a>\n<a id=\"L46\" href=\"#L46\" tabindex=\"-1\">46</a>\n<a id=\"L47\" href=\"#L47\" tabindex=\"-1\">47</a>\n<a id=\"L48\" href=\"#L48\" tabindex=\"-1\">48</a>\n<a id=\"L49\" href=\"#L49\" tabindex=\"-1\">49</a>\n<a id=\"L50\" href=\"#L50\" tabindex=\"-1\">50</a>\n<a id=\"L51\" href=\"#L51\" tabindex=\"-1\">51</a>\n<a id=\"L52\" href=\"#L52\" tabindex=\"-1\">52</a>\n<a id=\"L53\" href=\"#L53\" tabindex=\"-1\">53</a>\n<a id=\"L54\" href=\"#L54\" tabindex=\"-1\">54</a>\n<a id=\"L55\" href=\"#L55\" tabindex=\"-1\">55</a>\n<a id=\"L56\" href=\"#L56\" tabindex=\"-1\">56</a>\n<a id=\"L57\" href=\"#L57\" tabindex=\"-1\">57</a>\n<a id=\"L58\" href=\"#L58\" tabindex=\"-1\">58</a>\n<a id=\"L59\" href=\"#L59\" tabindex=\"-1\">59</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">//! Greatest common divisor (https://mathworld.wolfram.com/GreatestCommonDivisor.html)</span>\n<span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n\n<span class=\"tok-comment\">/// Returns the greatest common divisor (GCD) of two unsigned integers (`a` and `b`) which are not both zero.</span>\n<span class=\"tok-comment\">/// For example, the GCD of `8` and `12` is `4`, that is, `gcd(8, 12) == 4`.</span>\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">gcd</span>(a: <span class=\"tok-kw\">anytype</span>, b: <span class=\"tok-kw\">anytype</span>) <span class=\"tok-builtin\">@TypeOf</span>(a, b) {\n    <span class=\"tok-kw\">const</span> N = <span class=\"tok-kw\">switch</span> (<span class=\"tok-builtin\">@TypeOf</span>(a, b)) {<span class=\"tok-comment\">\n        // convert comptime_int to some sized int type for @ctz\n        </span><span class=\"tok-type\">comptime_int</span> =&gt; <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/math/#std.math\">math</a>.<a href=\"/zig-docs/en/std/math/#std.math.IntFittingRange\">IntFittingRange</a>(<span class=\"tok-builtin\">@min</span>(a, b), <span class=\"tok-builtin\">@max</span>(a, b)),\n        <span class=\"tok-kw\">else</span> =&gt; |T| T,\n    };\n    <span class=\"tok-kw\">if</span> (<span class=\"tok-builtin\">@typeInfo</span>(N) != .int <span class=\"tok-kw\">or</span> <span class=\"tok-builtin\">@typeInfo</span>(N).int.signedness != .unsigned) {\n        <span class=\"tok-builtin\">@compileError</span>(<span class=\"tok-str\">\"`a` and `b` must be usigned integers\"</span>);\n    }<span class=\"tok-comment\">\n\n    // using an optimised form of Stein's algorithm:\n    // https://en.wikipedia.org/wiki/Binary_GCD_algorithm\n    </span><a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/debug/#std.debug\">debug</a>.<a href=\"/zig-docs/en/std/debug/#std.debug.assert\">assert</a>(a != <span class=\"tok-number\">0</span> <span class=\"tok-kw\">or</span> b != <span class=\"tok-number\">0</span>);\n\n    <span class=\"tok-kw\">if</span> (a == <span class=\"tok-number\">0</span>) <span class=\"tok-kw\">return</span> b;\n    <span class=\"tok-kw\">if</span> (b == <span class=\"tok-number\">0</span>) <span class=\"tok-kw\">return</span> a;\n\n    <span class=\"tok-kw\">var</span> x: N = a;\n    <span class=\"tok-kw\">var</span> y: N = b;\n\n    <span class=\"tok-kw\">const</span> xz = <span class=\"tok-builtin\">@ctz</span>(x);\n    <span class=\"tok-kw\">const</span> yz = <span class=\"tok-builtin\">@ctz</span>(y);\n    <span class=\"tok-kw\">const</span> shift = <span class=\"tok-builtin\">@min</span>(xz, yz);\n    x &gt;&gt;= <span class=\"tok-builtin\">@intCast</span>(xz);\n    y &gt;&gt;= <span class=\"tok-builtin\">@intCast</span>(yz);\n\n    <span class=\"tok-kw\">var</span> diff = y -% x;\n    <span class=\"tok-kw\">while</span> (diff != <span class=\"tok-number\">0</span>) : (diff = y -% x) {<span class=\"tok-comment\">\n        // ctz is invariant under negation, we\n        // put it here to ease data dependencies,\n        // makes the CPU happy.\n        </span><span class=\"tok-kw\">const</span> zeros = <span class=\"tok-builtin\">@ctz</span>(diff);\n        <span class=\"tok-kw\">if</span> (x &gt; y) diff = -%diff;\n        y = <span class=\"tok-builtin\">@min</span>(x, y);\n        x = diff &gt;&gt; <span class=\"tok-builtin\">@intCast</span>(zeros);\n    }\n    <span class=\"tok-kw\">return</span> y &lt;&lt; <span class=\"tok-builtin\">@intCast</span>(shift);\n}\n\n<span class=\"tok-kw\">test</span> gcd {\n    <span class=\"tok-kw\">const</span> expectEqual = <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectEqual\">expectEqual</a>;\n\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">0</span>, <span class=\"tok-number\">5</span>), <span class=\"tok-number\">5</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">5</span>, <span class=\"tok-number\">0</span>), <span class=\"tok-number\">5</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">8</span>, <span class=\"tok-number\">12</span>), <span class=\"tok-number\">4</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">12</span>, <span class=\"tok-number\">8</span>), <span class=\"tok-number\">4</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">33</span>, <span class=\"tok-number\">77</span>), <span class=\"tok-number\">11</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">77</span>, <span class=\"tok-number\">33</span>), <span class=\"tok-number\">11</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">49865</span>, <span class=\"tok-number\">69811</span>), <span class=\"tok-number\">9973</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">300_000</span>, <span class=\"tok-number\">2_300_000</span>), <span class=\"tok-number\">100_000</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">90000000_000_000_000_000_000</span>, <span class=\"tok-number\">2</span>), <span class=\"tok-number\">2</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u80</span>, <span class=\"tok-number\">90000000_000_000_000_000_000</span>), <span class=\"tok-number\">2</span>), <span class=\"tok-number\">2</span>);\n    <span class=\"tok-kw\">try</span> expectEqual(<a href=\"/zig-docs/en/std/math/gcd/#std.math.gcd.gcd\">gcd</a>(<span class=\"tok-number\">300_000</span>, <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u32</span>, <span class=\"tok-number\">2_300_000</span>)), <span class=\"tok-number\">100_000</span>);\n}\n</code></pre></div></details>"}

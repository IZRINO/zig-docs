.log10\"></div>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L1\">Source line 1</a></p>\n<div class=\"api-members\"><ul>\n<li><a href=\"/zig-docs/en/std/#std\"><code>std</code></a></li>\n<li><a href=\"/zig-docs/en/std/testing/#std.testing\"><code>testing</code></a></li>\n<li><a href=\"/zig-docs/en/std/math/log10/#std.math.log10.log10\"><code>log10</code></a></li>\n<li><a href=\"/zig-docs/en/std/math/log10/#std.math.log10.log10_int\"><code>log10_int</code></a></li>\n<li><a href=\"/zig-docs/en/std/math/log10/#std.math.log10.pow10\"><code>pow10</code></a></li>\n<li><a href=\"/zig-docs/en/std/math/log10/#std.math.log10.log10_int_u8\"><code>log10_int_u8</code></a></li>\n<li><a href=\"/zig-docs/en/std/math/log10/#std.math.log10.less_than_5\"><code>less_than_5</code></a></li>\n</ul></div>\n<section class=\"api-entry\" id=\"std.math.log10.less_than_5\"><h3><code>std.math.log10.less_than_5</code></h3>\n<p class=\"api-kind\">function</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L117\">Source line 117</a></p>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">inline</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">less_than_5</span>(x: <span class=\"tok-type\">u32</span>) <span class=\"tok-type\">u32</span></code></pre>\n<h4>Parameters</h4><div class=\"api-parameters\">\n<pre><code>x: <span class=\"tok-type\">u32</span></code></pre>\n</div>\n</section>\n<section class=\"api-entry\" id=\"std.math.log10.log10\"><h3><code>std.math.log10.log10</code></h3>\n<p class=\"api-kind\">function</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L11\">Source line 11</a></p>\n<div class=\"api-description\"><p>Returns the base-10 logarithm of x.</p>\n<p>Special Cases:</p>\n<ul>\n<li>log10(+inf)  = +inf</li>\n<li>log10(0)     = -inf</li>\n<li>log10(x)     = nan if x &lt; 0</li>\n<li>log10(nan)   = nan</li>\n</ul>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">log10</span>(x: <span class=\"tok-kw\">anytype</span>) <span class=\"tok-builtin\">@TypeOf</span>(x)</code></pre>\n</section>\n<section class=\"api-entry\" id=\"std.math.log10.log10_int\"><h3><code>std.math.log10.log10_int</code></h3>\n<p class=\"api-kind\">function</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L41\">Source line 41</a></p>\n<div class=\"api-description\"><p>Return the log base 10 of integer value x, rounding down to the\nnearest integer.</p>\n</div>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">log10_int</span>(x: <span class=\"tok-kw\">anytype</span>) <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/math/#std.math\">math</a>.<a href=\"/zig-docs/en/std/math/#std.math.Log2Int\">Log2Int</a>(<span class=\"tok-builtin\">@TypeOf</span>(x))</code></pre>\n<h4>Example usage</h4><pre><code><span class=\"tok-kw\">test</span> log10_int {\n    <span class=\"tok-kw\">inline</span> <span class=\"tok-kw\">for</span> (\n        .{ <span class=\"tok-type\">u8</span>, <span class=\"tok-type\">u16</span>, <span class=\"tok-type\">u32</span>, <span class=\"tok-type\">u64</span>, <span class=\"tok-type\">u128</span>, <span class=\"tok-type\">u256</span>, <span class=\"tok-type\">u512</span> },\n        .{ <span class=\"tok-number\">2</span>, <span class=\"tok-number\">4</span>, <span class=\"tok-number\">9</span>, <span class=\"tok-number\">19</span>, <span class=\"tok-number\">38</span>, <span class=\"tok-number\">77</span>, <span class=\"tok-number\">154</span> },\n    ) |T, max_exponent| {\n        <span class=\"tok-kw\">for</span> (<span class=\"tok-number\">0</span>..max_exponent + <span class=\"tok-number\">1</span>) |exponent_usize| {\n            <span class=\"tok-kw\">const</span> exponent: <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/math/#std.math\">math</a>.<a href=\"/zig-docs/en/std/math/#std.math.Log2Int\">Log2Int</a>(T) = <span class=\"tok-builtin\">@intCast</span>(exponent_usize);\n            <span class=\"tok-kw\">const</span> power_of_ten = <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/math/#std.math\">math</a>.<a href=\"/zig-docs/en/std/math/powi/#std.math.powi.powi\">powi</a>(T, <span class=\"tok-number\">10</span>, exponent);\n\n            <span class=\"tok-kw\">if</span> (exponent &gt; <span class=\"tok-number\">0</span>) {\n                <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectEqual\">expectEqual</a>(exponent - <span class=\"tok-number\">1</span>, <a href=\"/zig-docs/en/std/math/log10/#std.math.log10.log10_int\">log10_int</a>(power_of_ten - <span class=\"tok-number\">9</span>));\n                <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectEqual\">expectEqual</a>(exponent - <span class=\"tok-number\">1</span>, <a href=\"/zig-docs/en/std/math/log10/#std.math.log10.log10_int\">log10_int</a>(power_of_ten - <span class=\"tok-number\">1</span>));\n            }\n            <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectEqual\">expectEqual</a>(exponent, <a href=\"/zig-docs/en/std/math/log10/#std.math.log10.log10_int\">log10_int</a>(power_of_ten));\n            <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectEqual\">expectEqual</a>(exponent, <a href=\"/zig-docs/en/std/math/log10/#std.math.log10.log10_int\">log10_int</a>(power_of_ten + <span class=\"tok-number\">1</span>));\n            <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectEqual\">expectEqual</a>(exponent, <a href=\"/zig-docs/en/std/math/log10/#std.math.log10.log10_int\">log10_int</a>(power_of_ten + <span class=\"tok-number\">8</span>));\n        }\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectEqual\">expectEqual</a>(max_exponent, <a href=\"/zig-docs/en/std/math/log10/#std.math.log10.log10_int\">log10_int</a>(<span class=\"tok-builtin\">@as</span>(T, <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/math/#std.math\">math</a>.<a href=\"/zig-docs/en/std/math/#std.math.maxInt\">maxInt</a>(T))));\n    }\n}</code></pre>\n</section>\n<section class=\"api-entry\" id=\"std.math.log10.log10_int_u8\"><h3><code>std.math.log10.log10_int_u8</code></h3>\n<p class=\"api-kind\">function</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L100\">Source line 100</a></p>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">inline</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">log10_int_u8</span>(x: <span class=\"tok-type\">u8</span>) <span class=\"tok-type\">u32</span></code></pre>\n<h4>Parameters</h4><div class=\"api-parameters\">\n<pre><code>x: <span class=\"tok-type\">u8</span></code></pre>\n</div>\n</section>\n<section class=\"api-entry\" id=\"std.math.log10.pow10\"><h3><code>std.math.log10.pow10</code></h3>\n<p class=\"api-kind\">function</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L77\">Source line 77</a></p>\n<pre class=\"api-prototype\"><code><span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">pow10</span>(<span class=\"tok-kw\">comptime</span> y: <span class=\"tok-type\">comptime_int</span>) <span class=\"tok-type\">comptime_int</span></code></pre>\n<h4>Parameters</h4><div class=\"api-parameters\">\n<pre><code>y: <span class=\"tok-type\">comptime_int</span></code></pre>\n</div>\n</section>\n<sec
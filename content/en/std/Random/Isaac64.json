215</a>\n<a id=\"L216\" href=\"#L216\" tabindex=\"-1\">216</a>\n<a id=\"L217\" href=\"#L217\" tabindex=\"-1\">217</a>\n<a id=\"L218\" href=\"#L218\" tabindex=\"-1\">218</a>\n<a id=\"L219\" href=\"#L219\" tabindex=\"-1\">219</a>\n<a id=\"L220\" href=\"#L220\" tabindex=\"-1\">220</a>\n<a id=\"L221\" href=\"#L221\" tabindex=\"-1\">221</a>\n<a id=\"L222\" href=\"#L222\" tabindex=\"-1\">222</a>\n<a id=\"L223\" href=\"#L223\" tabindex=\"-1\">223</a>\n<a id=\"L224\" href=\"#L224\" tabindex=\"-1\">224</a>\n<a id=\"L225\" href=\"#L225\" tabindex=\"-1\">225</a>\n<a id=\"L226\" href=\"#L226\" tabindex=\"-1\">226</a>\n<a id=\"L227\" href=\"#L227\" tabindex=\"-1\">227</a>\n<a id=\"L228\" href=\"#L228\" tabindex=\"-1\">228</a>\n<a id=\"L229\" href=\"#L229\" tabindex=\"-1\">229</a>\n<a id=\"L230\" href=\"#L230\" tabindex=\"-1\">230</a>\n<a id=\"L231\" href=\"#L231\" tabindex=\"-1\">231</a>\n<a id=\"L232\" href=\"#L232\" tabindex=\"-1\">232</a>\n<a id=\"L233\" href=\"#L233\" tabindex=\"-1\">233</a>\n<a id=\"L234\" href=\"#L234\" tabindex=\"-1\">234</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">//! ISAAC64 - http://www.burtleburtle.net/bob/rand/isaacafa.html</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! Follows the general idea of the implementation from here with a few shortcuts.</span>\n<span class=\"tok-comment\">//! https://doc.rust-lang.org/rand/src/rand/prng/isaac64.rs.html</span>\n\n<span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n<span class=\"tok-kw\">const</span> mem = <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/mem/#std.mem\">mem</a>;\n<span class=\"tok-kw\">const</span> Isaac64 = <span class=\"tok-builtin\">@This</span>();\n\nr: [<span class=\"tok-number\">256</span>]<span class=\"tok-type\">u64</span>,\nm: [<span class=\"tok-number\">256</span>]<span class=\"tok-type\">u64</span>,\na: <span class=\"tok
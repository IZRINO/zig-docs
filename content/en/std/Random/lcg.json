ok-kw\">return</span> <span class=\"tok-kw\">struct</span> {\n        xi: T,\n        a: T,\n        c: T,\n\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">init</span>(xi: T, a: T, c: T) <a href=\"/zig-docs/en/std/Random/lcg/#std.Random.lcg.Wrapping\">LcgSelf</a> {\n            <span class=\"tok-kw\">return</span> .{ .xi = xi, .a = a, .c = c };\n        }\n\n        <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">next</span>(lcg: *<a href=\"/zig-docs/en/std/Random/lcg/#std.Random.lcg.Wrapping\">LcgSelf</a>) T {\n            lcg.xi = (lcg.a *% lcg.xi) +% lcg.c;\n            <span class=\"tok-kw\">return</span> lcg.xi;\n        }\n\n        <span class=\"tok-kw\">const</span> LcgSelf = <span class=\"tok-builtin\">@This</span>();\n    };\n}\n</code></pre></div></details>"}

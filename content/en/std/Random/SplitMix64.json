e</summary><p><code>std/Random/SplitMix64.zig</code></p><div class=\"source-grid\"><pre class=\"line-numbers\" aria-hidden=\"true\" data-copy-ignore=\"\"><code><a id=\"L1\" href=\"#L1\" tabindex=\"-1\">1</a>\n<a id=\"L2\" href=\"#L2\" tabindex=\"-1\">2</a>\n<a id=\"L3\" href=\"#L3\" tabindex=\"-1\">3</a>\n<a id=\"L4\" href=\"#L4\" tabindex=\"-1\">4</a>\n<a id=\"L5\" href=\"#L5\" tabindex=\"-1\">5</a>\n<a id=\"L6\" href=\"#L6\" tabindex=\"-1\">6</a>\n<a id=\"L7\" href=\"#L7\" tabindex=\"-1\">7</a>\n<a id=\"L8\" href=\"#L8\" tabindex=\"-1\">8</a>\n<a id=\"L9\" href=\"#L9\" tabindex=\"-1\">9</a>\n<a id=\"L10\" href=\"#L10\" tabindex=\"-1\">10</a>\n<a id=\"L11\" href=\"#L11\" tabindex=\"-1\">11</a>\n<a id=\"L12\" href=\"#L12\" tabindex=\"-1\">12</a>\n<a id=\"L13\" href=\"#L13\" tabindex=\"-1\">13</a>\n<a id=\"L14\" href=\"#L14\" tabindex=\"-1\">14</a>\n<a id=\"L15\" href=\"#L15\" tabindex=\"-1\">15</a>\n<a id=\"L16\" href=\"#L16\" tabindex=\"-1\">16</a>\n<a id=\"L17\" href=\"#L17\" tabindex=\"-1\">17</a>\n<a id=\"L18\" href=\"#L18\" tabindex=\"-1\">18</a>\n<a id=\"L19\" href=\"#L19\" tabindex=\"-1\">19</a>\n<a id=\"L20\" href=\"#L20\" tabindex=\"-1\">20</a>\n<a id=\"L21\" href=\"#L21\" tabindex=\"-1\">21</a></code></pre><pre class=\"source-listing\"><code><span class=\"tok-comment\">//! Generator to extend 64-bit seed values into longer sequences.</span>\n<span class=\"tok-comment\">//!</span>\n<span class=\"tok-comment\">//! The number of cycles is thus limited to 64-bits regardless of the engine, but this</span>\n<span class=\"tok-comment\">//! is still plenty for practical purposes.</span>\n\n<span class=\"tok-kw\">const</span> SplitMix64 = <span class=\"tok-builtin\">@This</span>();\n\ns: <span class=\"tok-type\">u64</span>,\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">init</span>(seed: <span class=\"tok-type\">u64</span>) <a href=\"/zig-docs/en/std/Random/SplitMix64/#std.Random.SplitMix64\">SplitMix64</a> {\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/en/std/Random/SplitMix64/#std.Random.SplitMix64\">SplitMix64</a>{ .s = seed };\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">next</span>(self: *<a href=\"/zig-docs/en/std/Random/SplitMix64/#std.Random.SplitMix64\">SplitMix64</a>) <span class=\"tok-type\">u64</span> {\n    self.s +%= <span class=\"tok-number\">0x9e3779b97f4a7c15</span>;\n\n    <span class=\"tok-kw\">var</span> z = self.s;\n    z = (z ^ (z &gt;&gt; <span class=\"tok-number\">30</span>)) *% <span class=\"tok-number\">0xbf58476d1ce4e5b9</span>;\n    z = (z ^ (z &gt;&gt; <span class=\"tok-number\">27</span>)) *% <span class=\"tok-number\">0x94d049bb133111eb</span>;\n    <span class=\"tok-kw\">return</span> z ^ (z &gt;&gt; <span class=\"tok-number\">31</span>);\n}\n</code></pre></div></details>"}

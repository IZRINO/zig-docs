span class=\"tok-kw\">while</span> (i &lt; buf.len) : (i += <span class=\"tok-number\">1</span>) {\n            buf[i] = <span class=\"tok-builtin\">@as</span>(<span class=\"tok-type\">u8</span>, <span class=\"tok-builtin\">@truncate</span>(n));\n            n &gt;&gt;= <span class=\"tok-number\">8</span>;\n        }\n    }\n}\n\n<span class=\"tok-kw\">test</span> <span class=\"tok-str\">\"sequence\"</span> {<span class=\"tok-comment\">\n    // Unfortunately there does not seem to be an official test sequence.\n    </span><span class=\"tok-kw\">var</span> r = <a href=\"/zig-docs/en/std/Random/RomuTrio/#std.Random.RomuTrio\">RomuTrio</a>.<a href=\"/zig-docs/en/std/Random/RomuTrio/#std.Random.RomuTrio.init\">init</a>(<span class=\"tok-number\">0</span>);\n\n    <span class=\"tok-kw\">const</span> seq = [_]<span class=\"tok-type\">u64</span>{\n        <span class=\"tok-number\">16294208416658607535</span>,\n        <span class=\"tok-number\">13964609475759908645</span>,\n        <span class=\"tok-number\">4703697494102998476</span>,\n        <span class=\"tok-number\">3425221541186733346</span>,\n        <span class=\"tok-number\">2285772463536419399</span>,\n        <span class=\"tok-number\">9454187757529463048</span>,\n        <span class=\"tok-number\">13695907680080547496</span>,\n        <span class=\"tok-number\">8328236714879408626</span>,\n        <span class=\"tok-number\">12323357569716880909</span>,\n        <span class=\"tok-number\">12375466223337721820</span>,\n    };\n\n    <span class=\"tok-kw\">for</span> (seq) |s| {\n        <span class=\"tok-kw\">try</span> <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/testing/#std.testing\">testing</a>.<a href=\"/zig-docs/en/std/testing/#std.testing.expectEqual\">expectEqual</a>(s, r.next());\n    }\n}\n\n<span class=\"tok-kw\">test</span> fill {<span class=\"tok-comment\">\n    // Unfortunately there does not seem to be an official test sequence.\n    </span><span class=\"tok-kw\">var</span>
 for cryptographic purposes.\n\n</span><span class=\"tok-kw\">const</span> std = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"std\"</span>);\n<span class=\"tok-kw\">const</span> math = <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/math/#std.math\">math</a>;\n<span class=\"tok-kw\">const</span> RomuTrio = <span class=\"tok-builtin\">@This</span>();\n<span class=\"tok-kw\">const</span> builtin = <span class=\"tok-builtin\">@import</span>(<span class=\"tok-str\">\"builtin\"</span>);\n\nx_state: <span class=\"tok-type\">u64</span>,\ny_state: <span class=\"tok-type\">u64</span>,\nz_state: <span class=\"tok-type\">u64</span>,<span class=\"tok-comment\"> // set to nonzero seed\n\n</span><span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">init</span>(init_s: <span class=\"tok-type\">u64</span>) <a href=\"/zig-docs/en/std/Random/RomuTrio/#std.Random.RomuTrio\">RomuTrio</a> {\n    <span class=\"tok-kw\">var</span> x = <a href=\"/zig-docs/en/std/Random/RomuTrio/#std.Random.RomuTrio\">RomuTrio</a>{ .x_state = <span class=\"tok-null\">undefined</span>, .y_state = <span class=\"tok-null\">undefined</span>, .z_state = <span class=\"tok-null\">undefined</span> };\n    x.seed(init_s);\n    <span class=\"tok-kw\">return</span> x;\n}\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">random</span>(self: *<a href=\"/zig-docs/en/std/Random/RomuTrio/#std.Random.RomuTrio\">RomuTrio</a>) <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/Random/#std.Random\">Random</a> {\n    <span class=\"tok-kw\">return</span> <a href=\"/zig-docs/en/std/#std\">std</a>.<a href=\"/zig-docs/en/std/Random/#std.Random\">Random</a>.<a href=\"/zig-docs/en/std/Random/#std.Random.init\">init</a>(self, <a href=\"/zig-docs/en/std/Random/RomuTrio/#std.Random.RomuTrio.fill\">fill</a>);\n}\n\n<span class=\"tok-kw\">fn</span> <span class=\"tok-fn\">next</span>(self: *<a href=\
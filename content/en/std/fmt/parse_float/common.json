\">\n<pre><code>exponent: <span class=\"tok-type\">i64</span></code></pre><div class=\"fieldDocs\"></div>\n<pre><code>mantissa: <a href=\"/zig-docs/en/std/fmt/parse_float/common/#std.fmt.parse_float.common.mantissaType\">mantissaType</a>(T)</code></pre><div class=\"fieldDocs\"></div>\n<pre><code>negative: <span class=\"tok-type\">bool</span></code></pre><div class=\"fieldDocs\"></div>\n<pre><code>many_digits: <span class=\"tok-type\">bool</span></code></pre><div class=\"fieldDocs\"><p>More than max_mantissa digits were found during parse</p>\n</div>\n<pre><code>hex: <span class=\"tok-type\">bool</span></code></pre><div class=\"fieldDocs\"><p>The number was a hex-float (e.g. 0x1.234p567)</p>\n</div>\n</div>\n</section>\n<section class=\"api-entry\" id=\"std.fmt.parse_float.common.std\"><h3><code>std.fmt.parse_float.common.std</code></h3>\n<p class=\"api-kind\">alias</p>\n<p class=\"api-source\" data-pagefind-ignore=\"\"><a href=\"#L1\">Source line 1</a></p>\n<p>Alias of <a href=\"/zig-docs/en/std/#std\"><code>std</code></a></p>\n</section>\n<details class=\"source-code\" id=\"source\" data-pagefind-ignore=\"\"><summary>Source code</summary><p><code>std/fmt/parse_float/common.zig</code></p><div class=\"source-grid\"><pre class=\"line-numbers\" aria-hidden=\"true\" data-copy-ignore=\"\"><code><a id=\"L1\" href=\"#L1\" tabindex=\"-1\">1</a>\n<a id=\"L2\" href=\"#L2\" tabindex=\"-1\">2</a>\n<a id=\"L3\" href=\"#L3\" tabindex=\"-1\">3</a>\n<a id=\"L4\" href=\"#L4\" tabindex=\"-1\">4</a>\n<a id=\"L5\" href=\"#L5\" tabindex=\"-1\">5</a>\n<a id=\"L6\" href=\"#L6\" tabindex=\"-1\">6</a>\n<a id=\"L7\" href=\"#L7\" tabindex=\"-1\">7</a>\n<a id=\"L8\" href=\"#L8\" tabindex=\"-1\">8</a>\n<a id=\"L9\" href=\"#L9\" tabindex=\"-1\">9</a>\n<a id=\"L10\" href=\"#L10\" tabindex=\"-1\">10</a>\n<a id=\"L11\" href=\"#L11\" tabindex=\"-1\">11</a>\n<a id=\"L12\" href=\"#L12\" tabindex=\"-1\">12</a>\n<a id=\"L13\" href=\"#L13\" tabindex=\"-1\">13</a>\n<a id=\"L14\" href=\"#L14\" tabindex=\"-